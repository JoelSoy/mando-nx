diff --git a/dm/host/hle_scan.c b/dm/host/hle_scan.c
new file mode 100644
index 0000000..4f0fb3e
--- /dev/null
+++ b/dm/host/hle_scan.c
@@ -0,0 +1,199 @@
+// DM_CTL "scan …" (hle_hid.c ctl_main): a memory search over the guest address block and the game's modules, for finding where a game keeps a value it shows (coins, laps,
+// a position) and the pointers that lead to it. It reads a host page at a time through vm_read (pages that cannot be read are skipped) and keeps the matching places:
+//   "scan u8|u16|u32|i32|f32 <value> [<max>]"  new search: every aligned place holding the value (or a value up to max)
+//   "scan = <value>" / "scan != <value>"  keep the places that hold the value now / that do not
+//   "scan changed" / "scan same"       keep those whose value changed / stayed since the previous step
+//   "scan rec"                         record every place's value now as the next column (up to 64; values above 255 count as 255), keeping them all
+//   "scan match <c>=<v> <c>==<d> <c><><d> …"  keep the places whose column c held v / whose columns c and d were equal / differed
+//   "scan ptr <address> <span>"        new search: every aligned 32-bit word holding a pointer into [address - span, address] (a 32-bit game: the address is a guest one)
+//   "scan ptr64 <address> <span>"      the same for 64-bit pointers (a 64-bit game's guest addresses are host addresses)
+//   "scan list [n]"                    log the first n places (32 by default) with their values and recorded columns; a place in a module is named module+offset
+//   "scan seq <type> <max stride> <v0> <v1> …"  new search: places holding v0 where, for a stride up to max (hex), each next record holds the next value (an array of
+//                                      per-racer records found by what they hold, as the racers' character ids in race order); logs each hit's stride
+// rec then match takes the decision out of the race with the screen: a shot right after each rec shows what the value was, and the columns are matched afterwards (a value
+// that changes during a live filter otherwise loses the place). Addresses are hex host addresses, as "peek" and "memdump" take them
+#include "hle.h"
+#include <mach/mach.h>
+#include <math.h>
+
+void dm_guest_block(uint8_t **base, size_t *size);   // hle_svc.c
+enum { T_U8, T_U16, T_U32, T_I32, T_F32, T_PTR, T_P64 };
+static const char *const k_types[] = {"u8", "u16", "u32", "i32", "f32", "ptr", "ptr64"};
+#define PAGE 0x4000u
+#define MAX_HITS (48u << 20)
+#define COLS 64
+static uint64_t *g_at, *g_old; static size_t g_n, g_cap;   // the places (host addresses, ascending within a region) and their values at the last step
+static uint8_t *g_hist; static int g_cols, g_type = -1;   // recorded columns, COLS bytes a place (allocated at the first rec); the search's type
+static uint8_t g_page[PAGE], g_win[2 * PAGE];   // a page read; seq's window of two
+
+static int width(int t) { return t == T_U8 ? 1 : t == T_U16 ? 2 : t == T_P64 ? 8 : 4; }
+static uint64_t load(const uint8_t *p, int t) { uint64_t v = 0; memcpy(&v, p, (size_t)width(t)); return v; }
+static double num(uint64_t raw, int t) {
+    if (t == T_F32) { float f; uint32_t r = (uint32_t)raw; memcpy(&f, &r, 4); return f; }
+    return t == T_I32 ? (double)(int32_t)raw : (double)raw;
+}
+static int within(uint64_t raw, double lo, double hi, int t) {
+    double v = num(raw, t), tol = t == T_F32 ? 1e-3 * fmax(1.0, fabs(lo)) : 0;
+    return v >= lo - tol && v <= hi + tol;
+}
+static uint8_t small(uint64_t raw, int t) { double v = num(raw, t); return v < 0 || v > 255 ? 255 : (uint8_t)v; }
+static int read_page(uint64_t a) {
+    vm_size_t got = 0;
+    return vm_read_overwrite(mach_task_self(), (vm_address_t)a, PAGE, (vm_address_t)g_page, &got) == KERN_SUCCESS && got == PAGE;
+}
+static int keep(uint64_t at, uint64_t v) {
+    if (g_n == g_cap) {
+        if (g_cap >= MAX_HITS) return 0;
+        g_cap = g_cap ? g_cap * 2 : 1u << 16;
+        g_at = realloc(g_at, g_cap * sizeof *g_at); g_old = realloc(g_old, g_cap * sizeof *g_old);
+        if (!g_at || !g_old) die("scan: out of memory");
+    }
+    g_at[g_n] = at; g_old[g_n++] = v; return 1;
+}
+static void move_row(size_t to, size_t from) {
+    g_at[to] = g_at[from]; g_old[to] = g_old[from];
+    if (g_hist && to != from) memcpy(g_hist + to * COLS, g_hist + from * COLS, COLS);
+}
+// The regions searched: the guest block, then each module's image (page-aligned)
+static int region(int r, uint64_t *lo, uint64_t *hi) {
+    if (r == 0) { uint8_t *b; size_t s; dm_guest_block(&b, &s); *lo = (uint64_t)(uintptr_t)b; *hi = *lo + s; return 1; }
+    if (r - 1 >= g_nmod) return 0;
+    *lo = (uint64_t)(uintptr_t)g_mod[r - 1].base & ~(uint64_t)(PAGE - 1); *hi = (uint64_t)(uintptr_t)g_mod[r - 1].base + g_mod[r - 1].size; return 1;
+}
+static void name(uint64_t a, char *out, size_t n) {
+    for (int i = 0; i < g_nmod; i++) { uint64_t b = (uint64_t)(uintptr_t)g_mod[i].base; if (a >= b && a < b + g_mod[i].size) { snprintf(out, n, "%s+%#llx", g_mod[i].name, (unsigned long long)(a - b)); return; } }
+    uint64_t lo, hi; region(0, &lo, &hi); snprintf(out, n, "block+%#llx", (unsigned long long)(a - lo));
+}
+
+// A new search: values in lo..hi (for the pointer types, the pointer range)
+static void search(int t, double lo, double hi) {
+    g_n = 0; g_type = t; g_cols = 0; free(g_hist); g_hist = NULL;
+    int w = width(t), full = 0; uint64_t pages = 0, a, end;
+    for (int r = 0; region(r, &a, &end) && !full; r++)
+        for (; a + PAGE <= end && !full; a += PAGE) {
+            if (!read_page(a)) continue;
+            pages++;
+            for (unsigned i = 0; i + (unsigned)w <= PAGE; i += (unsigned)w) {
+                uint64_t v = load(g_page + i, t);
+                int hit = t == T_PTR || t == T_P64 ? v >= (uint64_t)lo && v <= (uint64_t)hi : within(v, lo, hi, t);
+                if (hit && !keep(a + i, v)) { full = 1; break; }
+            }
+        }
+    LOG("DM_CTL: scan %s: %zu places in %llu readable pages%s", k_types[t], g_n, (unsigned long long)pages, full ? " (stopped at the limit: search a rarer value)" : "");
+}
+
+// seq: v[0] here and v[k] k strides further on, within this page and the next (one window: (nv - 1) * max fits in a page)
+static void seq(int t, unsigned max, const double *v, int nv) {
+    g_n = 0; g_type = t; g_cols = 0; free(g_hist); g_hist = NULL;
+    unsigned w = (unsigned)width(t); uint64_t a, end; size_t shown = 0; int full = 0;
+    for (int r = 0; region(r, &a, &end) && !full; r++)
+        for (; a + PAGE <= end && !full; a += PAGE) {
+            if (!read_page(a)) continue; memcpy(g_win, g_page, PAGE);
+            unsigned lim = a + 2 * PAGE <= end && read_page(a + PAGE) ? 2 * PAGE : PAGE; memcpy(g_win + PAGE, g_page, PAGE);
+            for (unsigned i = 0; i + w <= PAGE && !full; i += w) {
+                if (!within(load(g_win + i, t), v[0], v[0], t)) continue;
+                for (unsigned s = w; s <= max; s += w) {
+                    int k = 1; while (k < nv && i + k * s + w <= lim && within(load(g_win + i + k * s, t), v[k], v[k], t)) k++;
+                    if (k < nv) continue;
+                    if (!keep(a + i, load(g_win + i, t))) { full = 1; break; }
+                    if (shown++ < 32) { char where[48]; name(a + i, where, sizeof where); LOG("DM_CTL: scan seq %#llx (%s) stride %#x", (unsigned long long)(a + i), where, s); }
+                    break;
+                }
+            }
+        }
+    LOG("DM_CTL: scan seq %s: %zu places%s", k_types[t], g_n, full ? " (stopped at the limit)" : "");
+}
+
+// Visits every place with its value now; keeps those for which pass() returns true (rec keeps all and writes the column)
+static void each(int (*pass)(size_t i, uint64_t v, const void *arg), const void *arg, const char *what) {
+    if (g_type < 0) { LOG("[RED] DM_CTL: scan: no search yet"); return; }
+    uint64_t page = UINT64_MAX; int ok = 0; size_t n = 0, before = g_n;
+    for (size_t i = 0; i < g_n; i++) {
+        uint64_t p = g_at[i] & ~(uint64_t)(PAGE - 1);
+        if (p != page) { page = p; ok = read_page(p); }
+        if (!ok) continue;
+        uint64_t v = load(g_page + (g_at[i] - p), g_type);
+        if (pass(i, v, arg)) { move_row(n, i); g_old[n++] = v; }
+    }
+    g_n = n;
+    LOG("DM_CTL: scan %s: %zu of %zu places kept", what, n, before);
+}
+static int f_eq(size_t i, uint64_t v, const void *a) { (void)i; const double *w = a; return within(v, w[0], w[0], g_type); }
+static int f_ne(size_t i, uint64_t v, const void *a) { return !f_eq(i, v, a); }
+static int f_changed(size_t i, uint64_t v, const void *a) { (void)a; return v != g_old[i]; }
+static int f_same(size_t i, uint64_t v, const void *a) { (void)a; return v == g_old[i]; }
+static int f_rec(size_t i, uint64_t v, const void *a) { (void)a; g_hist[i * COLS + g_cols] = small(v, g_type); return 1; }
+
+static void rec(void) {
+    if (g_type < 0) { LOG("[RED] DM_CTL: scan rec: no search yet"); return; }
+    if (g_cols == COLS) { LOG("[RED] DM_CTL: scan rec: all %d columns used (match, or start a new search)", COLS); return; }
+    if (!g_hist) { g_hist = calloc(g_cap ? g_cap : 1, COLS); if (!g_hist) die("scan: out of memory"); }
+    char what[32]; snprintf(what, sizeof what, "rec column %d", g_cols); each(f_rec, NULL, what); g_cols++;
+}
+
+// match: every term must hold for a place to stay
+static void match(const char *terms) {
+    if (!g_hist || !g_cols) { LOG("[RED] DM_CTL: scan match: nothing recorded (scan rec)"); return; }
+    int kind[16], c[16], d[16], nt = 0; char tok[32];
+    for (const char *s = terms; nt < 16 && sscanf(s, " %31s", tok) == 1; nt++) {
+        s = strstr(s, tok) + strlen(tok);
+        if (sscanf(tok, "%d<>%d", &c[nt], &d[nt]) == 2 && strstr(tok, "<>")) kind[nt] = 'd';
+        else if (sscanf(tok, "%d==%d", &c[nt], &d[nt]) == 2) kind[nt] = 's';
+        else if (sscanf(tok, "%d=%d", &c[nt], &d[nt]) == 2) kind[nt] = 'v';
+        else { LOG("[RED] DM_CTL: scan match: cannot read %s (c=v, c==d or c<>d)", tok); return; }
+        if (c[nt] < 0 || c[nt] >= g_cols || (kind[nt] != 'v' && (d[nt] < 0 || d[nt] >= g_cols))) { LOG("[RED] DM_CTL: scan match: no column in %s", tok); return; }
+    }
+    size_t n = 0, before = g_n;
+    for (size_t i = 0; i < g_n; i++) {
+        const uint8_t *h = g_hist + i * COLS; int ok = 1;
+        for (int t = 0; t < nt && ok; t++)
+            ok = kind[t] == 'v' ? h[c[t]] == d[t] : kind[t] == 's' ? h[c[t]] == h[d[t]] : h[c[t]] != h[d[t]];
+        if (ok) move_row(n++, i);
+    }
+    g_n = n;
+    LOG("DM_CTL: scan match: %zu of %zu places kept", n, before);
+}
+
+static void list(size_t max) {
+    for (size_t i = 0; i < g_n && i < max; i++) {
+        uint64_t v = g_old[i]; char h[COLS * 4 + 1] = "", *p = h, where[48];
+        for (int k = 0; g_hist && k < g_cols; k++) p += snprintf(p, (size_t)(h + sizeof h - p), "%s%u", k ? "," : "", g_hist[i * COLS + k]);
+        name(g_at[i], where, sizeof where);
+        LOG("DM_CTL: scan %#llx (%s): %g (%#llx)%s%s", (unsigned long long)g_at[i], where, num(v, g_type), (unsigned long long)v, *h ? " cols " : "", h);
+    }
+    LOG("DM_CTL: scan: %zu places%s", g_n, g_n > max ? " (more not listed)" : "");
+}
+
+void dm_ctl_scan(const char *args) {
+    char op[16] = {0}; double v[2] = {0}; unsigned long long a = 0, span = 0;
+    if (sscanf(args, "%15s", op) != 1) { LOG("[RED] DM_CTL: scan wants a type, = / != / changed / same / rec / match / ptr / ptr64 / list"); return; }
+    const char *rest = args + strlen(op);
+    for (int t = 0; t < T_PTR; t++) if (!strcmp(op, k_types[t])) {
+        int k = sscanf(rest, "%lf %lf", &v[0], &v[1]);
+        if (k < 1) { LOG("[RED] DM_CTL: scan %s wants a value", op); return; }
+        search(t, v[0], k == 2 ? v[1] : v[0]); return;
+    }
+    if (!strcmp(op, "ptr") || !strcmp(op, "ptr64")) {
+        int t = op[3] ? T_P64 : T_PTR;
+        if (sscanf(rest, "%llx %llx", &a, &span) != 2 || (t == T_PTR && a > UINT32_MAX)) { LOG("[RED] DM_CTL: scan %s wants an address and a span (hex)", op); return; }
+        search(t, (double)(a > span ? a - span : 0), (double)a); return;
+    }
+    if (!strcmp(op, "seq")) {
+        char ty[8]; unsigned max; int used, nv = 0; double sv[8];
+        if (sscanf(rest, " %7s %x%n", ty, &max, &used) != 2) { LOG("[RED] DM_CTL: scan seq wants a type, a max stride and values"); return; }
+        for (const char *q = rest + used; nv < 8 && sscanf(q, "%lf%n", &sv[nv], &used) == 1; q += used) nv++;
+        int t = -1; for (int k = 0; k < T_PTR; k++) t = strcmp(ty, k_types[k]) ? t : k;
+        if (t < 0 || nv < 2 || !max || (unsigned)(nv - 1) * max > PAGE) { LOG("[RED] DM_CTL: scan seq: a type, 2..8 values, and (values - 1) * max stride within %#x", PAGE); return; }
+        seq(t, max, sv, nv); return;
+    }
+    if (!strcmp(op, "=") || !strcmp(op, "!=")) {
+        if (sscanf(rest, "%lf", &v[0]) != 1) { LOG("[RED] DM_CTL: scan %s wants a value", op); return; }
+        each(op[0] == '=' ? f_eq : f_ne, v, op); return;
+    }
+    if (!strcmp(op, "changed")) { each(f_changed, NULL, op); return; }
+    if (!strcmp(op, "same")) { each(f_same, NULL, op); return; }
+    if (!strcmp(op, "rec")) { rec(); return; }
+    if (!strcmp(op, "match")) { match(rest); return; }
+    if (!strcmp(op, "list")) { long n = strtol(rest, NULL, 0); list(n > 0 ? (size_t)n : 32); return; }
+    LOG("[RED] DM_CTL: scan: unknown step %s", op);
+}
