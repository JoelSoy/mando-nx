diff --git a/dm/host/kbd_map.h b/dm/host/kbd_map.h
new file mode 100644
index 0000000..5c901f3
--- /dev/null
+++ b/dm/host/kbd_map.h
@@ -0,0 +1,136 @@
+// The Mac keyboard map (front_mac.m; pure, so tests/t_kbd_map.c checks it): which key presses which button or tilts which stick. Keys are macOS virtual key codes (the key's
+// position, whatever the layout prints on it), named as on a US keyboard. The built-in map is the one the front end always had: WASD left stick, arrow keys D-pad, J=A K=B U=X
+// I=Y, Q=L E=R, Z=ZL C=ZR, F / G press the sticks, Return=+ Tab=−, Space shakes the controller; the right stick has no keys.
+// A map file (controls_mac.m: DM_KBD_MAP, else ~/Library/Application Support/nxnative/keyboard.txt; the Keyboard Controls window writes it) has one line per action,
+// "<action>=<key>[,<key>…]" ("A=J", "RStickUp=" for none, "#" starts a comment). An action the file names gets exactly the keys it lists; the others keep the built-in keys, and a
+// key the file gives to an action is taken from any other. A key presses one action. Command, Caps Lock and Fn are not offered: Command is the menus' (⌘Q, ⌘K).
+#pragma once
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+#include "dm_input.h"
+
+enum { KBD_KEYS = 128, KBD_ACTIONS = 25 };
+typedef struct { const char *name, *label; uint64_t bit; int dir; } kbd_action;   // dir 1..8: left stick up down left right, right stick up down left right
+static const kbd_action KBD_ACTION[KBD_ACTIONS] = {
+    {"A", "A", DM_BTN_A, 0}, {"B", "B", DM_BTN_B, 0}, {"X", "X", DM_BTN_X, 0}, {"Y", "Y", DM_BTN_Y, 0},
+    {"L", "L", DM_BTN_L, 0}, {"R", "R", DM_BTN_R, 0}, {"ZL", "ZL", DM_BTN_ZL, 0}, {"ZR", "ZR", DM_BTN_ZR, 0},
+    {"Plus", "+ (Plus)", DM_BTN_PLUS, 0}, {"Minus", "\xe2\x88\x92 (Minus)", DM_BTN_MINUS, 0}, {"LS", "Left stick press", DM_BTN_LS, 0}, {"RS", "Right stick press", DM_BTN_RS, 0},
+    {"DpadUp", "D-pad up", DM_BTN_UP, 0}, {"DpadDown", "D-pad down", DM_BTN_DOWN, 0}, {"DpadLeft", "D-pad left", DM_BTN_LEFT, 0}, {"DpadRight", "D-pad right", DM_BTN_RIGHT, 0},
+    {"LStickUp", "Left stick up", 0, 1}, {"LStickDown", "Left stick down", 0, 2}, {"LStickLeft", "Left stick left", 0, 3}, {"LStickRight", "Left stick right", 0, 4},
+    {"RStickUp", "Right stick up", 0, 5}, {"RStickDown", "Right stick down", 0, 6}, {"RStickLeft", "Right stick left", 0, 7}, {"RStickRight", "Right stick right", 0, 8},
+    {"Shake", "Shake the controller", DM_BTN_SHAKE, 0},
+};
+// macOS virtual key codes (Carbon's kVK_*) and their names; codes without a name here cannot be mapped
+static const struct { uint8_t code; const char *name; } KBD_KEY[] = {
+    {0, "A"}, {11, "B"}, {8, "C"}, {2, "D"}, {14, "E"}, {3, "F"}, {5, "G"}, {4, "H"}, {34, "I"}, {38, "J"}, {40, "K"}, {37, "L"}, {46, "M"}, {45, "N"}, {31, "O"}, {35, "P"},
+    {12, "Q"}, {15, "R"}, {1, "S"}, {17, "T"}, {32, "U"}, {9, "V"}, {13, "W"}, {7, "X"}, {16, "Y"}, {6, "Z"},
+    {29, "0"}, {18, "1"}, {19, "2"}, {20, "3"}, {21, "4"}, {23, "5"}, {22, "6"}, {26, "7"}, {28, "8"}, {25, "9"},
+    {27, "Minus"}, {24, "Equal"}, {33, "LeftBracket"}, {30, "RightBracket"}, {42, "Backslash"}, {41, "Semicolon"}, {39, "Quote"}, {43, "Comma"}, {47, "Period"}, {44, "Slash"},
+    {50, "Grave"}, {10, "Section"}, {36, "Return"}, {48, "Tab"}, {49, "Space"}, {51, "Delete"}, {53, "Escape"}, {117, "ForwardDelete"}, {114, "Help"},
+    {115, "Home"}, {119, "End"}, {116, "PageUp"}, {121, "PageDown"}, {123, "LeftArrow"}, {124, "RightArrow"}, {125, "DownArrow"}, {126, "UpArrow"},
+    {56, "LeftShift"}, {60, "RightShift"}, {59, "LeftControl"}, {62, "RightControl"}, {58, "LeftOption"}, {61, "RightOption"},
+    {122, "F1"}, {120, "F2"}, {99, "F3"}, {118, "F4"}, {96, "F5"}, {97, "F6"}, {98, "F7"}, {100, "F8"}, {101, "F9"}, {109, "F10"}, {103, "F11"}, {111, "F12"},
+    {105, "F13"}, {107, "F14"}, {113, "F15"}, {106, "F16"}, {64, "F17"}, {79, "F18"}, {80, "F19"}, {90, "F20"},
+    {82, "Keypad0"}, {83, "Keypad1"}, {84, "Keypad2"}, {85, "Keypad3"}, {86, "Keypad4"}, {87, "Keypad5"}, {88, "Keypad6"}, {89, "Keypad7"}, {91, "Keypad8"}, {92, "Keypad9"},
+    {65, "KeypadDecimal"}, {67, "KeypadMultiply"}, {69, "KeypadPlus"}, {71, "KeypadClear"}, {75, "KeypadDivide"}, {76, "KeypadEnter"}, {78, "KeypadMinus"}, {81, "KeypadEquals"},
+};
+enum { KBD_NKEYS = sizeof KBD_KEY / sizeof KBD_KEY[0] };
+static const char *kbd_key_name(int code) { for (int i = 0; i < KBD_NKEYS; i++) if (KBD_KEY[i].code == code) return KBD_KEY[i].name; return NULL; }
+static int kbd_key_code(const char *name) { for (int i = 0; i < KBD_NKEYS; i++) if (!strcasecmp(KBD_KEY[i].name, name)) return KBD_KEY[i].code; return -1; }
+static int kbd_action_of(const char *name) { for (int i = 0; i < KBD_ACTIONS; i++) if (!strcasecmp(KBD_ACTION[i].name, name)) return i; return -1; }
+
+typedef struct { uint8_t act[KBD_KEYS]; } kbd_map;    // per key code: its action + 1, 0 = none
+typedef struct { uint8_t down[KBD_KEYS]; } kbd_keys;  // the keys held now
+
+static void kbd_set(kbd_map *m, int code, int action) { if (code >= 0 && code < KBD_KEYS) m->act[code] = (uint8_t)(action < 0 ? 0 : action + 1); }
+static void kbd_clear_action(kbd_map *m, int action) { for (int k = 0; k < KBD_KEYS; k++) if (m->act[k] == action + 1) m->act[k] = 0; }
+static int kbd_keys_of(const kbd_map *m, int action, int *codes, int max) {   // the action's keys, in key code order
+    int n = 0; for (int k = 0; k < KBD_KEYS; k++) if (m->act[k] == action + 1) { if (n < max) codes[n] = k; n++; }
+    return n;
+}
+static void kbd_default(kbd_map *m) {
+    static const char *const def[][2] = {
+        {"A", "J"}, {"B", "K"}, {"X", "U"}, {"Y", "I"}, {"L", "Q"}, {"R", "E"}, {"ZL", "Z"}, {"ZR", "C"}, {"Plus", "Return"}, {"Minus", "Tab"}, {"LS", "F"}, {"RS", "G"},
+        {"DpadUp", "UpArrow"}, {"DpadDown", "DownArrow"}, {"DpadLeft", "LeftArrow"}, {"DpadRight", "RightArrow"},
+        {"LStickUp", "W"}, {"LStickDown", "S"}, {"LStickLeft", "A"}, {"LStickRight", "D"}, {"Shake", "Space"},
+    };
+    memset(m, 0, sizeof *m);
+    for (size_t i = 0; i < sizeof def / sizeof def[0]; i++) kbd_set(m, kbd_key_code(def[i][1]), kbd_action_of(def[i][0]));
+}
+static int kbd_is_default(const kbd_map *m) { kbd_map d; kbd_default(&d); return !memcmp(m, &d, sizeof d); }
+
+// A map file's text over the built-in map. Returns the number of lines it could not take (warn gets each, with its line number); those lines change nothing
+static int kbd_parse(kbd_map *m, const char *text, void (*warn)(void *ctx, int line, const char *msg), void *ctx) {
+    int bad = 0, ln = 0; char line[512], msg[160];
+    kbd_default(m);
+    for (const char *p = text; p && *p; ) {
+        const char *nl = strchr(p, '\n'); size_t n = nl ? (size_t)(nl - p) : strlen(p);
+        ln++;
+        if (n >= sizeof line) { bad++; if (warn) warn(ctx, ln, "line too long"); p = nl ? nl + 1 : NULL; continue; }
+        memcpy(line, p, n); line[n] = 0; p = nl ? nl + 1 : NULL;
+        char *hash = strchr(line, '#'); if (hash) *hash = 0;
+        char *s = line; while (*s == ' ' || *s == '\t' || *s == '\r') s++;
+        char *e = s + strlen(s); while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r')) *--e = 0;
+        if (!*s) continue;
+        char *eq = strchr(s, '=');
+        if (!eq) { bad++; if (warn) warn(ctx, ln, "not <action>=<key>[,<key>]"); continue; }
+        *eq = 0; char *an = s; e = eq; while (e > an && (e[-1] == ' ' || e[-1] == '\t')) *--e = 0;
+        int a = kbd_action_of(an);
+        if (a < 0) { bad++; snprintf(msg, sizeof msg, "unknown action '%s'", an); if (warn) warn(ctx, ln, msg); continue; }
+        int codes[16], nc = 0, ok = 1;
+        for (char *k = eq + 1; k && ok;) {
+            char *comma = strchr(k, ','); if (comma) *comma = 0;
+            while (*k == ' ' || *k == '\t') k++;
+            char *ke = k + strlen(k); while (ke > k && (ke[-1] == ' ' || ke[-1] == '\t')) *--ke = 0;
+            if (*k) {
+                int c = kbd_key_code(k);
+                if (c < 0) { ok = 0; snprintf(msg, sizeof msg, "unknown key '%s'", k); }
+                else if (nc < 16) codes[nc++] = c;
+            }
+            k = comma ? comma + 1 : NULL;
+        }
+        if (!ok) { bad++; if (warn) warn(ctx, ln, msg); continue; }
+        kbd_clear_action(m, a);
+        for (int i = 0; i < nc; i++) kbd_set(m, codes[i], a);
+    }
+    return bad;
+}
+// The map as a file: every action, its keys (none: nothing after the =)
+static size_t kbd_format(const kbd_map *m, char *out, size_t cap) {
+    size_t n = 0;
+    #define KBD_PUT(...) do { int w_ = snprintf(out + n, n < cap ? cap - n : 0, __VA_ARGS__); if (w_ > 0) n += (size_t)w_; } while (0)
+    KBD_PUT("# nxnative keyboard map (Mac): <action>=<key>[,<key>], keys by their US-keyboard name. Written by the Keyboard Controls window (Controllers menu, Command-K).\n");
+    for (int a = 0; a < KBD_ACTIONS; a++) {
+        int codes[KBD_KEYS], nc = kbd_keys_of(m, a, codes, KBD_KEYS);
+        KBD_PUT("%s=", KBD_ACTION[a].name);
+        for (int i = 0; i < nc; i++) KBD_PUT("%s%s", i ? "," : "", kbd_key_name(codes[i]) ? kbd_key_name(codes[i]) : "?");
+        KBD_PUT("\n");
+    }
+    #undef KBD_PUT
+    return n < cap ? n : (cap ? cap - 1 : 0);
+}
+// The buttons and sticks the held keys make. A stick key tilts all the way; opposite keys cancel; two directions held make a diagonal of both axes at full tilt, as always
+static void kbd_compose(const kbd_map *m, const kbd_keys *k, uint64_t *buttons, int32_t ax[4]) {
+    int dir[9] = {0}; uint64_t b = 0;
+    for (int c = 0; c < KBD_KEYS; c++) if (k->down[c] && m->act[c]) {
+        const kbd_action *a = &KBD_ACTION[m->act[c] - 1];
+        if (a->dir) dir[a->dir] = 1; else b |= a->bit;
+    }
+    *buttons = b;
+    ax[0] = (dir[4] - dir[3]) * DM_STICK_MAX; ax[1] = (dir[1] - dir[2]) * DM_STICK_MAX;
+    ax[2] = (dir[8] - dir[7]) * DM_STICK_MAX; ax[3] = (dir[5] - dir[6]) * DM_STICK_MAX;
+}
+// Shift, Control and Option come as flag changes, not key presses: whether `code` is held, from the event's modifier flags (the left / right device bits of NSEvent's
+// modifierFlags, with the plain Shift / Control / Option bit when a keyboard gives no device bits). Returns 0 for a key that is not one of these six
+static int kbd_modifier(int code, uint64_t flags, int *down) {
+    static const struct { int code; uint64_t dev, pair, any; } mods[] = {
+        {56, 0x2, 0x6, 1u << 17}, {60, 0x4, 0x6, 1u << 17}, {59, 0x1, 0x2001, 1u << 18}, {62, 0x2000, 0x2001, 1u << 18}, {58, 0x20, 0x60, 1u << 19}, {61, 0x40, 0x60, 1u << 19},
+    };
+    for (size_t i = 0; i < sizeof mods / sizeof mods[0]; i++) if (mods[i].code == code) {
+        *down = (flags & mods[i].pair) ? (flags & mods[i].dev) != 0 : (flags & mods[i].any) != 0;
+        return 1;
+    }
+    return 0;
+}
