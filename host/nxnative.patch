+// Wi-Fi controllers on the Mac (remote_mac.c; protocol and sessions in remote_proto.h, docs/wifi-controllers.md). Off unless DM_REMOTE=1.
+// The phones take player slots from the front end's table (pad_slots.h), the one its physical controllers take theirs from, under the front end's lock, so a phone and a
+// controller never hold one player.
+#pragma once
+#include <pthread.h>
+#include <stddef.h>
+#include <stdint.h>
+#include "pad_slots.h"
+
+// Starts the receiver when DM_REMOTE=1 (returns 1 when it listens). slots / mu: the front end's slot table and its lock; input_on: 0 while the game window is not key
+// (NULL = always on); changed: called on the receiver's thread when a phone joins or leaves (NULL = nothing). Call once, after the keyboard took its slot (DM_KBD_PLAYER=own)
+int dm_remote_start(pad_slots *slots, pthread_mutex_t *mu, int (*input_on)(void), void (*changed)(void));
+// "192.168.1.23:47800, code 482913": where phones connect, for the window title and the menu; 0 when the receiver is off
+int dm_remote_info(char *out, size_t cap);
+void dm_remote_players(char *out, size_t cap);   // "Ana (2), Luis (3)", empty when no phone is connected
+uint16_t dm_remote_port(void);                   // the bound port (DM_REMOTE_PORT=0 binds any free one: tests), 0 when off
+void dm_remote_stop(void);                       // tells every phone the host quits and releases their players (also at exit)
+
+int dm_remote_pair_uri(char *out,size_t cap);   // the QR code's URI (nxmando://pair?…), 0 when off
+// The game's keyboard is up (front_text_input): every phone is asked for the text too, and answer(text, ok) is called on the receiver's thread when one answers
+// (ok 0: it cancelled); dm_remote_text_end when the box closes, answered or not. Nothing when the receiver is off
+void dm_remote_text_begin(const char *title, const char *initial, int max_chars, void (*answer)(const char *text, int ok));
+void dm_remote_text_end(void);
