diff --git a/dm/tools/remote_phone.py b/dm/tools/remote_phone.py
new file mode 100644
index 0000000..53093e8
--- /dev/null
+++ b/dm/tools/remote_phone.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""Fake phones for the Wi-Fi controllers (docs/wifi-controllers.md): joins the host like dm/remote_pad does and sends whole states at 60 Hz, for checking a host without a phone.
+  remote_phone.py --code 482913 [--host 127.0.0.1] [--port 47800] [--phones 3] [--seconds 10] [--press A] [--every 1.0]
+Each phone presses --press for half of every --every seconds and tilts the left stick right meanwhile. One JSON line per event on stdout (join, welcome, reject, ack counts, kick,
+bye, info, roster and race when what they say changes); exit 0 when every phone got a player and acks, 1 otherwise. Standard library only."""
+import argparse
+import json
+import secrets
+import select
+import socket
+import sys
+import time
+
+BUTTONS = {'A': 1, 'B': 2, 'X': 4, 'Y': 8, 'LS': 16, 'RS': 32, 'L': 64, 'R': 128, 'ZL': 256, 'ZR': 512, 'Plus': 1024, 'Minus': 2048,
+           'Left': 4096, 'Up': 8192, 'Right': 16384, 'Down': 32768}
+
+
+def say(**ev):
+    print(json.dumps(ev), flush=True)
+
+
+class Phone:
+    def __init__(self, n, host, port, code):
+        self.n, self.addr, self.code = n, (host, port), code
+        self.id = f'fake{n}-' + secrets.token_hex(6)
+        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        self.sock.bind(('0.0.0.0', 0))
+        self.sid, self.player, self.seq, self.acks, self.last_hello, self.reject = None, None, 0, 0, 0.0, None
+        self.info = None   # what the host's last info said: game, use, seats, taken, rd, isz
+        self.roster = None   # who holds each player, as the host's last roster said
+        self.race = None   # the course, place, lap, coins, character and kart, items, as the host's last race said
+
+    def send(self, **m):
+        self.sock.sendto(json.dumps(dict(v=1, **m), separators=(',', ':')).encode(), self.addr)
+
+    def hello(self):
+        self.last_hello = time.monotonic()
+        self.send(t='hello', code=self.code, id=self.id, name=f'Fake {self.n}')
+
+    def state(self, b, lx, start):
+        if not self.sid: return
+        self.seq += 1
+        self.send(t='state', sid=self.sid, seq=self.seq, b=b, lx=lx, ly=0, rx=0, ry=0, ms=int((time.monotonic() - start) * 1000))
+
+    def receive(self, data):
+        try: m = json.loads(data)
+        except ValueError: return
+        t = m.get('t')
+        if t == 'welcome':
+            if m.get('sid') != self.sid: self.seq = 0
+            self.sid, self.player = m.get('sid'), m.get('player')
+            say(ev='welcome', phone=self.n, player=self.player)
+        elif t == 'ack': self.acks += 1; self.player = m.get('player')
+        elif t == 'info' and m.get('sid') == self.sid:
+            info = {k: m.get(k) for k in ('game', 'use', 'seats', 'taken', 'rd', 'isz')}
+            if info != self.info: self.info = info; say(ev='info', phone=self.n, player=m.get('player'), **info)
+        elif t == 'roster' and m.get('sid') == self.sid:
+            names = {k: v for k, v in m.items() if k[:1] == 'n' and k[1:].isdigit()}
+            if names != self.roster: self.roster = names; say(ev='roster', phone=self.n, **names)
+        elif t == 'race' and m.get('sid') == self.sid:
+            race = {k: m.get(k) for k in ('crs', 'pos', 'lap', 'coin', 'drv', 'body', 'tire', 'wing', 'itm', 'itm2')}
+            if race != self.race: self.race = race; say(ev='race', phone=self.n, **race)
+        elif t == 'reject': self.reject = m.get('reason'); say(ev='reject', phone=self.n, reason=self.reject)
+        elif t == 'kick': self.sid = None; say(ev='kick', phone=self.n, reason=m.get('reason')); self.hello()
+        elif t == 'bye': say(ev='bye', phone=self.n, reason=m.get('reason')); self.sid = None
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
+    ap.add_argument('--host', default='127.0.0.1'); ap.add_argument('--port', type=int, default=47800); ap.add_argument('--code', required=True)
+    ap.add_argument('--phones', type=int, default=1); ap.add_argument('--seconds', type=float, default=10); ap.add_argument('--press', default='A')
+    ap.add_argument('--every', type=float, default=1.0)
+    a = ap.parse_args()
+    if a.press not in BUTTONS: ap.error(f'--press: one of {" ".join(BUTTONS)}')
+    phones = [Phone(i + 1, a.host, a.port, a.code) for i in range(a.phones)]
+    start = time.monotonic(); next_tick = start
+    for p in phones: p.hello(); say(ev='join', phone=p.n, id=p.id)
+    while time.monotonic() - start < a.seconds:
+        now = time.monotonic()
+        r, _, _ = select.select([p.sock for p in phones], [], [], max(0.0, next_tick - now))
+        for p in phones:
+            if p.sock in r:
+                data, src = p.sock.recvfrom(2048)
+                if src[1] == a.port: p.receive(data)
+        if time.monotonic() >= next_tick:
+            next_tick += 1 / 60
+            on = ((time.monotonic() - start) % a.every) < a.every / 2
+            for p in phones:
+                if p.sid: p.state(BUTTONS[a.press] if on else 0, 1.0 if on else 0.0, start)
+                elif p.reject not in ('code', 'version') and time.monotonic() - p.last_hello > 0.5: p.hello()
+    for p in phones:
+        if p.sid: p.send(t='bye', sid=p.sid)
+    ok = all(p.player and p.acks for p in phones)
+    say(ev='done', ok=ok, phones=[{'phone': p.n, 'player': p.player, 'acks': p.acks, 'states': p.seq, 'reject': p.reject, 'info': p.info} for p in phones])
+    return 0 if ok else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
