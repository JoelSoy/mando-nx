diff --git a/dm/host/remote_feed.h b/dm/host/remote_feed.h
new file mode 100644
index 0000000..6b8f666
--- /dev/null
+++ b/dm/host/remote_feed.h
@@ -0,0 +1,124 @@
+// Wi-Fi controllers (remote_proto.h): what goes to each streaming phone about the game, besides acks and rumble. Each is sent when it changes and renewed now and
+// then, with a sequence number the phone orders them by (a lost one is replaced by the next):
+//   info     the game's name and icon (size and CRC), what the game makes of the phone's player (rp_game), whether the game is reading it      every RP_INFO_MS
+//   roster   who holds each player: "keyboard", a controller's name, a phone's own name                                                        every RP_ROSTER_MS
+//   kbd      the game's keyboard is waiting for text (title, initial text, length), and "done" when one phone answered or the box closed     every RP_KBD_MS
+//   race     the course the player races on, their place, lap, coins, character and kart, items (rp_race; at most every RP_RACE_GAP_MS)  every RP_RACE_MS
+// and, on request: iconpart, a piece of the icon (rp_icon_part), and the answer to the keyboard (rp_text_in).
+#pragma once
+#include "remote_session.h"
+
+static uint32_t rp_fnv(const void *p, size_t n) {   // a change key; never 0, which means "none sent"
+    const unsigned char *b = (const unsigned char *)p; uint32_t h = 2166136261u;
+    for (size_t i = 0; i < n; i++) { h ^= b[i]; h *= 16777619u; }
+    return h | 1u;
+}
+
+// Who holds each player this tick: names[p] (empty: nobody), phones by the names they gave; returns the roster's change key, 0 without a names hook
+static uint32_t rp_roster(const rp_server *s, char names[DM_PLAYERS][RP_NAME + 1]) {
+    memset(names, 0, sizeof(char[DM_PLAYERS][RP_NAME + 1]));
+    if (!s->h.names) return 0;
+    char raw[DM_PLAYERS][RP_NAME + 1]; memset(raw, 0, sizeof raw);
+    s->h.names(s->h.ctx, raw);
+    for (int p = 0; p < DM_PLAYERS; p++) {
+        raw[p][RP_NAME] = 0;
+        const char *n = raw[p];
+        if (!strncmp(n, "wifi:", 5)) {
+            n = "phone";
+            for (int i = 0; i < RP_SESSIONS; i++) if (s->s[i].used && s->s[i].player == p) n = s->s[i].name;
+        }
+        if (*n) rp_text_clean(names[p], RP_NAME + 1, n, RP_NAME, "?");
+    }
+    return rp_fnv(names, sizeof(char[DM_PLAYERS][RP_NAME + 1]));
+}
+
+static size_t rp_info_msg(const rp_server *s, rp_session *x, const rp_game *g, int on, char *out, size_t cap) {
+    int seats = g->seats < 1 ? 1 : g->seats > DM_PLAYERS ? DM_PLAYERS : g->seats;
+    const char *use = !on ? "pause" : g->use == RP_USE_OWN ? "own" : g->use == RP_USE_P1 ? "p1" : "off";
+    return rp_out(out, cap, "{\"v\":1,\"t\":\"info\",\"sid\":\"%s\",\"is\":%u,\"player\":%d,\"game\":\"%s\",\"use\":\"%s\",\"seats\":%d,\"taken\":%u,\"rd\":%d,"
+                  "\"ih\":\"%08x\",\"isz\":%u}", x->sid, x->i_seq, x->player + 1, s->game, use, seats, g->taken & ((1u << DM_PLAYERS) - 1),
+                  on && g->reading ? 1 : 0, s->icon.crc, (unsigned)s->icon.n);
+}
+static size_t rp_roster_msg(const rp_session *x, const char names[DM_PLAYERS][RP_NAME + 1], char *out, size_t cap) {
+    size_t n = rp_out(out, cap, "{\"v\":1,\"t\":\"roster\",\"sid\":\"%s\",\"rs\":%u", x->sid, x->o_seq);
+    for (int p = 0; n && p < DM_PLAYERS; p++) if (names[p][0]) {
+        size_t k = rp_out(out + n, cap - n, ",\"n%d\":\"%s\"", p + 1, names[p]);
+        n = k ? n + k : 0;
+    }
+    size_t k = n ? rp_out(out + n, cap - n, "}") : 0;
+    return k ? n + k : 0;
+}
+static size_t rp_race_msg(const rp_session *x, const rp_race *r, char *out, size_t cap) {
+    char crs[RP_COURSE + 1]; rp_text_clean(crs, sizeof crs, r->course, RP_COURSE, "");
+    size_t n = rp_out(out, cap, "{\"v\":1,\"t\":\"race\",\"sid\":\"%s\",\"cs\":%u,\"crs\":\"%s\"", x->sid, x->c_seq, crs), k;
+    if (n && r->has) n = (k = rp_out(out + n, cap - n, ",\"pos\":%d,\"lap\":%d,\"coin\":%d", r->place, r->lap, r->coins)) ? n + k : 0;
+    if (n && r->kart) n = (k = rp_out(out + n, cap - n, ",\"drv\":%d,\"body\":%d,\"tire\":%d,\"wing\":%d", r->drv, r->body, r->tire, r->wing)) ? n + k : 0;
+    if (n && r->items) n = (k = rp_out(out + n, cap - n, ",\"itm\":%d,\"itm2\":%d", r->item, r->item2)) ? n + k : 0;
+    k = n ? rp_out(out + n, cap - n, "}") : 0;
+    return k ? n + k : 0;
+}
+static size_t rp_kbd_msg(const rp_server *s, const rp_session *x, int done, char *out, size_t cap) {
+    if (done) return rp_out(out, cap, "{\"v\":1,\"t\":\"kbd\",\"sid\":\"%s\",\"ks\":%u,\"done\":1}", x->sid, x->k_sent);
+    return rp_out(out, cap, "{\"v\":1,\"t\":\"kbd\",\"sid\":\"%s\",\"ks\":%u,\"max\":%d,\"title\":\"%s\",\"init\":\"%s\"}", x->sid, s->kbd.id, s->kbd.max,
+                  s->kbd.title, s->kbd.init);
+}
+
+// One streaming phone's feed at time now: the messages due, into out (at most max; returns how many). on: the game window is key; names / names_key: rp_roster's
+static int rp_feed(rp_server *s, rp_session *x, int on, uint64_t now, const char names[DM_PLAYERS][RP_NAME + 1], uint32_t names_key, rp_reply *out, int max) {
+    int k = 0;
+    if (s->h.game && k < max) {
+        rp_game g = {RP_USE_OFF, 1, 0, 0}; s->h.game(s->h.ctx, x->player, &g);
+        int seats = g.seats < 1 ? 1 : g.seats > DM_PLAYERS ? DM_PLAYERS : g.seats;
+        uint32_t key = 1u << 31 | (uint32_t)!on << 30 | (uint32_t)(g.use & 3) << 28 | (uint32_t)seats << 20 | (g.taken & 0xffu) << 8 | (uint32_t)(on && g.reading) << 7
+                     | (uint32_t)x->player;
+        if (key != x->i_key || now - x->i_ns >= RP_INFO_MS * 1000000ull) {
+            x->i_key = key; x->i_ns = now; x->i_seq++;
+            out[k].to = x->addr; out[k].n = rp_info_msg(s, x, &g, on, out[k].text, sizeof out[k].text); k++;
+        }
+    }
+    if (names_key && k < max && (names_key != x->o_key || now - x->o_ns >= RP_ROSTER_MS * 1000000ull)) {
+        x->o_key = names_key; x->o_ns = now; x->o_seq++;
+        out[k].to = x->addr; out[k].n = rp_roster_msg(x, names, out[k].text, sizeof out[k].text); k++;
+    }
+    if (s->h.race && k < max) {
+        rp_race r; memset(&r, 0, sizeof r); s->h.race(s->h.ctx, x->player, &r);
+        r.course[RP_COURSE] = 0;
+        uint32_t key = rp_fnv(&r, sizeof r);
+        uint64_t since = now - x->c_ns;
+        if ((key != x->c_key && since >= RP_RACE_GAP_MS * 1000000ull) || since >= RP_RACE_MS * 1000000ull) {
+            x->c_key = key; x->c_ns = now; x->c_seq++;
+            out[k].to = x->addr; out[k].n = rp_race_msg(x, &r, out[k].text, sizeof out[k].text); k++;
+        }
+    }
+    if (k < max && s->kbd.active && (x->k_sent != s->kbd.id || now - x->k_ns >= RP_KBD_MS * 1000000ull)) {
+        x->k_sent = s->kbd.id; x->k_ns = now; x->k_done = 0;
+        out[k].to = x->addr; out[k].n = rp_kbd_msg(s, x, 0, out[k].text, sizeof out[k].text); k++;
+    } else if (k < max && !s->kbd.active && x->k_done > 0 && now - x->k_ns >= 100000000ull) {
+        x->k_done--; x->k_ns = now;
+        out[k].to = x->addr; out[k].n = rp_kbd_msg(s, x, 1, out[k].text, sizeof out[k].text); k++;
+    }
+    return k;
+}
+
+// A phone's answer to the game's keyboard: to h.text when it answers the request in progress (the request ends: every asked phone is told); the reply tells this phone
+// its dialog is done (also for an old request, so a stale dialog closes)
+static size_t rp_text_in(rp_server *s, rp_session *x, const rp_msg *m, char *out, size_t cap) {
+    if (s->kbd.active && m->ks == s->kbd.id) {
+        char t[RP_TEXT + 1]; rp_text_clean(t, sizeof t, m->text, RP_TEXT, "");
+        rp_say(s, "Wi-Fi controller '%s' %s the game's keyboard", x->name, m->ok ? "typed the text for" : "cancelled");
+        if (s->h.text) s->h.text(s->h.ctx, t, m->ok);
+        rp_kbd_end(s);
+        x->k_done = 1;   // this reply is one of the two
+    }
+    return rp_out(out, cap, "{\"v\":1,\"t\":\"kbd\",\"sid\":\"%s\",\"ks\":%u,\"done\":1}", x->sid, m->ks);
+}
+
+// A piece of the icon a phone asked for: RP_ICON_CHUNK bytes from off, in base64 (nothing past its end, or without an icon). Larger than the request, but only ever sent
+// to the address a session joined from
+static size_t rp_icon_part(const rp_server *s, const rp_session *x, uint32_t off, char *out, size_t cap) {
+    if (!s->icon.n || off >= s->icon.n) return 0;
+    size_t k = s->icon.n - off < RP_ICON_CHUNK ? s->icon.n - off : RP_ICON_CHUNK;
+    char b64[(RP_ICON_CHUNK + 2) / 3 * 4 + 1];
+    if (!rp_base64(s->icon.data + off, k, b64, sizeof b64)) return 0;
+    return rp_out(out, cap, "{\"v\":1,\"t\":\"iconpart\",\"sid\":\"%s\",\"ih\":\"%08x\",\"off\":%u,\"d\":\"%s\"}", x->sid, s->icon.crc, off, b64);
+}
diff --git a/dm/host/remote_front.c b/dm/host/remote_front.c
new file mode 100644
index 0000000..61210d5
--- /dev/null
+++ b/dm/host/remote_front.c
@@ -0,0 +1,85 @@
+// Wi-Fi controllers on the Mac (remote_mac.c): the hooks the sessions (remote_proto.h) reach the front end's player slots, hid and haptics through, and the bridge from
+// the game's keyboard (front_text_input) to the phones. The hooks run on the receiver's thread with rm_srv_mu held.
+#include "dm.h"
+#include "remote_mac.h"
+#include "remote_mac_int.h"
+#include "hle_haptics.h"
+extern void dm_haptics_apple_external(int, void (*)(dm_haptic_state));
+
+static int h_take(void *ctx, const void *owner, const char *name) {
+    (void)ctx;
+    pthread_mutex_lock(rm_slots_mu);
+    int p = pad_slot_take_in(rm_slots, owner, name, rm_max);
+    if (p >= 0) dm_pad_players(pad_slot_mask(rm_slots));
+    pthread_mutex_unlock(rm_slots_mu);
+    return p;
+}
+static void h_drop(void *ctx, const void *owner) {
+    (void)ctx;
+    pthread_mutex_lock(rm_slots_mu);
+    pad_slot_free(rm_slots, owner); dm_pad_players(pad_slot_mask(rm_slots));
+    pthread_mutex_unlock(rm_slots_mu);
+}
+static void h_set(void *ctx, int p, uint64_t b, int32_t lx, int32_t ly, int32_t rx, int32_t ry) { (void)ctx; dm_pad_set_player(p, b, lx, ly, rx, ry); }
+static int h_input_on(void *ctx) { (void)ctx; return !rm_input_on || rm_input_on(); }
+static void h_say(void *ctx, const char *line) { (void)ctx; LOG("%s", line); }
+static void h_changed(void *ctx) { (void)ctx; if (rm_changed) rm_changed(); }
+static void h_random(void *ctx, void *buf, size_t n) { (void)ctx; arc4random_buf(buf, n); }
+
+static void remote_rumble(dm_haptic_state state) {
+    dm_haptic_level level = dm_haptics_level(state.motor, 2, 1);
+    pthread_mutex_lock(&rm_srv_mu);
+    rp_rumble_level(&rm_srv, state.player, level.intensity, level.sharpness);
+    pthread_mutex_unlock(&rm_srv_mu);
+}
+static void h_route(void *ctx, int player, int on) { (void)ctx; dm_haptics_apple_external(player, on ? remote_rumble : NULL); }
+
+// What the game makes of a player (hle_hid.c), and whether it read that player's npad in the last half second (player 1's for a phone a one-player game merges into it)
+static uint64_t g_reads_seen[DM_PLAYERS], g_reads_ns[DM_PLAYERS];
+static void h_game(void *ctx, int p, rp_game *g) {
+    (void)ctx;
+    int u = dm_hid_player_use(p), q = u == 2 ? 0 : p;
+    g->use = u == 1 ? RP_USE_OWN : u == 2 ? RP_USE_P1 : RP_USE_OFF; g->seats = dm_hid_seats(); g->taken = dm_hid_players();
+    uint64_t r = dm_hid_reads(q), now = now_ns();
+    if (r != g_reads_seen[q]) { g_reads_seen[q] = r; g_reads_ns[q] = now; }
+    g->reading = u != 0 && g_reads_ns[q] && now - g_reads_ns[q] < 500000000ull;
+}
+// Who holds each player: the slot table's names (the keyboard's is "keyboard", a phone's "wifi:<id>", a controller's its product name). With a window the keyboard always
+// plays player 1, so it is named there when nobody holds player 1
+static void h_names(void *ctx, char out[DM_PLAYERS][RP_NAME + 1]) {
+    (void)ctx;
+    pthread_mutex_lock(rm_slots_mu);
+    for (int p = 0; p < DM_PLAYERS; p++) snprintf(out[p], RP_NAME + 1, "%s", rm_slots->owner[p] ? rm_slots->last[p] : "");
+    pthread_mutex_unlock(rm_slots_mu);
+    if (!out[0][0] && rm_input_on) snprintf(out[0], RP_NAME + 1, "keyboard");
+}
+
+// The race a player is in (remote_race.c): only for a player the game takes; a phone merged into player 1 races as player 1
+static void h_race(void *ctx, int p, rp_race *r) {
+    (void)ctx;
+    int u = dm_hid_player_use(p);
+    if (u) rm_race_read(u == 2 ? 0 : p, r);
+}
+
+static void (*g_text_answer)(const char *text, int ok);
+static void h_text(void *ctx, const char *text, int ok) { (void)ctx; if (g_text_answer) g_text_answer(text, ok); }
+
+void rm_hooks(rp_hooks *h) {
+    *h = (rp_hooks){.take = h_take, .drop = h_drop, .set = h_set, .input_on = h_input_on, .say = h_say, .changed = h_changed, .random = h_random,
+                    .rumble_route = h_route, .game = h_game, .names = h_names, .text = h_text, .race = h_race};
+}
+
+void dm_remote_text_begin(const char *title, const char *initial, int max_chars, void (*answer)(const char *text, int ok)) {
+    if (!atomic_load(&rm_on)) return;
+    pthread_mutex_lock(&rm_srv_mu);
+    g_text_answer = answer;
+    rp_kbd_begin(&rm_srv, title, initial, max_chars);
+    pthread_mutex_unlock(&rm_srv_mu);
+}
+void dm_remote_text_end(void) {
+    if (!atomic_load(&rm_on)) return;
+    pthread_mutex_lock(&rm_srv_mu);
+    rp_kbd_end(&rm_srv);
+    g_text_answer = NULL;
+    pthread_mutex_unlock(&rm_srv_mu);
+}
diff --git a/dm/host/remote_icon.c b/dm/host/remote_icon.c
new file mode 100644
index 0000000..b4b1f0a
--- /dev/null
+++ b/dm/host/remote_icon.c
@@ -0,0 +1,49 @@
+// Wi-Fi controllers on the Mac (remote_mac.c): the game's icon for the phones' game card, as a small JPEG (at most RM_ICON_PX pixels a side, ImageIO) made from the icon
+// the NSP script extracted: DM_REMOTE_ICON when set, else icon.jpg beside the RomFS image (DM_ROMFS). Without one the phones show no icon.
+#include <ImageIO/ImageIO.h>
+#include <CoreGraphics/CoreGraphics.h>
+#include <CoreFoundation/CoreFoundation.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "remote_mac_int.h"
+
+static int icon_path(char *out, size_t cap) {
+    const char *e = getenv("DM_REMOTE_ICON"), *r = getenv("DM_ROMFS");
+    if (e && *e) return snprintf(out, cap, "%s", e) < (int)cap;
+    if (!r || !*r || snprintf(out, cap, "%s", r) >= (int)cap) return 0;
+    char *slash = strrchr(out, '/');
+    size_t at = slash ? (size_t)(slash + 1 - out) : 0;
+    return snprintf(out + at, cap - at, "icon.jpg") < (int)(cap - at);
+}
+
+size_t rm_icon_load(unsigned char **out, char *from, size_t from_cap) {
+    *out = NULL;
+    char path[1024];
+    if (!icon_path(path, sizeof path)) return 0;
+    if (from_cap) snprintf(from, from_cap, "%s", path);
+    size_t len = 0;
+    CFURLRef url = CFURLCreateFromFileSystemRepresentation(NULL, (const UInt8 *)path, (CFIndex)strlen(path), false);
+    CGImageSourceRef src = url ? CGImageSourceCreateWithURL(url, NULL) : NULL;
+    int px = RM_ICON_PX; float quality = 0.72f;
+    CFNumberRef npx = CFNumberCreate(NULL, kCFNumberIntType, &px), nq = CFNumberCreate(NULL, kCFNumberFloatType, &quality);
+    const void *tk[] = {kCGImageSourceCreateThumbnailFromImageAlways, kCGImageSourceThumbnailMaxPixelSize, kCGImageSourceCreateThumbnailWithTransform};
+    const void *tv[] = {kCFBooleanTrue, npx, kCFBooleanTrue};
+    const void *qk[] = {kCGImageDestinationLossyCompressionQuality}, *qv[] = {nq};
+    CFDictionaryRef topt = CFDictionaryCreate(NULL, tk, tv, 3, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionaryRef qopt = CFDictionaryCreate(NULL, qk, qv, 1, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CGImageRef img = src ? CGImageSourceCreateThumbnailAtIndex(src, 0, topt) : NULL;
+    CFMutableDataRef data = CFDataCreateMutable(NULL, 0);
+    CGImageDestinationRef dst = img ? CGImageDestinationCreateWithData(data, CFSTR("public.jpeg"), 1, NULL) : NULL;
+    if (dst) {
+        CGImageDestinationAddImage(dst, img, qopt);
+        CFIndex n = CGImageDestinationFinalize(dst) ? CFDataGetLength(data) : 0;
+        if (n > 0 && n <= RM_ICON_MAX && (*out = malloc((size_t)n))) { memcpy(*out, CFDataGetBytePtr(data), (size_t)n); len = (size_t)n; }
+        CFRelease(dst);
+    }
+    if (img) CGImageRelease(img);
+    CFRelease(data); CFRelease(qopt); CFRelease(topt); CFRelease(nq); CFRelease(npx);
+    if (src) CFRelease(src);
+    if (url) CFRelease(url);
+    return len;
+}
diff --git a/dm/host/remote_json.h b/dm/host/remote_json.h
new file mode 100644
index 0000000..e34abc4
--- /dev/null
+++ b/dm/host/remote_json.h
@@ -0,0 +1,81 @@
+// Wi-Fi controllers (remote_proto.h): reading the phones' JSON. A datagram is a flat object of strings, numbers, true / false / null (nothing nested), at most 32 members;
+// strings are at most RP_TEXT bytes once unescaped (UTF-8), and each field checks its own length. Also the checks for codes, client ids and session ids.
+#pragma once
+#include "remote_types.h"
+
+typedef struct { const char *p, *e; } rp_cur;
+typedef struct { int kind; char s[RP_TEXT + 1]; double d; } rp_val;   // kind: 's' string, 'n' number, 'o' other scalar
+static void rp_ws(rp_cur *c) { while (c->p < c->e && (*c->p == ' ' || *c->p == '\t' || *c->p == '\n' || *c->p == '\r')) c->p++; }
+static int rp_hex4(const char *p, unsigned *v) {
+    *v = 0;
+    for (int i = 0; i < 4; i++) { char h = p[i]; *v <<= 4;
+        if (h >= '0' && h <= '9') *v |= (unsigned)(h - '0'); else if (h >= 'a' && h <= 'f') *v |= (unsigned)(h - 'a' + 10); else if (h >= 'A' && h <= 'F') *v |= (unsigned)(h - 'A' + 10); else return 0; }
+    return 1;
+}
+static int rp_str(rp_cur *c, char *out, size_t cap) {   // 1: a string, unescaped (UTF-8) into out
+    size_t n = 0;
+    if (c->p >= c->e || *c->p != '"') return 0;
+    c->p++;
+    while (c->p < c->e && *c->p != '"') {
+        unsigned ch = (unsigned char)*c->p++;
+        if (ch < 0x20) return 0;
+        if (ch == '\\') {
+            if (c->p >= c->e) return 0;
+            char esc = *c->p++;
+            switch (esc) {
+                case '"': ch = '"'; break; case '\\': ch = '\\'; break; case '/': ch = '/'; break;
+                case 'b': ch = '\b'; break; case 'f': ch = '\f'; break; case 'n': ch = '\n'; break; case 'r': ch = '\r'; break; case 't': ch = '\t'; break;
+                case 'u': {
+                    if (c->e - c->p < 4 || !rp_hex4(c->p, &ch)) return 0;
+                    c->p += 4;
+                    if (ch >= 0xdc00 && ch < 0xe000) return 0;
+                    if (ch >= 0xd800 && ch < 0xdc00) {   // a surrogate pair
+                        unsigned lo;
+                        if (c->e - c->p < 6 || c->p[0] != '\\' || c->p[1] != 'u' || !rp_hex4(c->p + 2, &lo) || lo < 0xdc00 || lo >= 0xe000) return 0;
+                        c->p += 6; ch = 0x10000 + ((ch - 0xd800) << 10) + (lo - 0xdc00);
+                    }
+                    char u[4]; int k = 0;
+                    if (ch < 0x80) u[k++] = (char)ch;
+                    else if (ch < 0x800) { u[k++] = (char)(0xc0 | ch >> 6); u[k++] = (char)(0x80 | (ch & 0x3f)); }
+                    else if (ch < 0x10000) { u[k++] = (char)(0xe0 | ch >> 12); u[k++] = (char)(0x80 | (ch >> 6 & 0x3f)); u[k++] = (char)(0x80 | (ch & 0x3f)); }
+                    else { u[k++] = (char)(0xf0 | ch >> 18); u[k++] = (char)(0x80 | (ch >> 12 & 0x3f)); u[k++] = (char)(0x80 | (ch >> 6 & 0x3f)); u[k++] = (char)(0x80 | (ch & 0x3f)); }
+                    if (n + (size_t)k >= cap) return 0;
+                    memcpy(out + n, u, (size_t)k); n += (size_t)k;
+                    continue;
+                }
+                default: return 0;
+            }
+        }
+        if (n + 1 >= cap) return 0;
+        out[n++] = (char)ch;
+    }
+    if (c->p >= c->e) return 0;
+    c->p++; out[n] = 0;
+    return 1;
+}
+static int rp_num(rp_cur *c, double *d) {   // a JSON number (its grammar checked here, strtod reads it)
+    const char *s = c->p, *p = s;
+    if (p < c->e && *p == '-') p++;
+    if (p >= c->e) return 0;
+    if (*p == '0') p++; else if (*p >= '1' && *p <= '9') { while (p < c->e && *p >= '0' && *p <= '9') p++; } else return 0;
+    if (p < c->e && *p == '.') { p++; const char *f = p; while (p < c->e && *p >= '0' && *p <= '9') p++; if (p == f) return 0; }
+    if (p < c->e && (*p == 'e' || *p == 'E')) { p++; if (p < c->e && (*p == '+' || *p == '-')) p++; const char *f = p; while (p < c->e && *p >= '0' && *p <= '9') p++; if (p == f) return 0; }
+    if (p - s > 40) return 0;
+    char tmp[48]; memcpy(tmp, s, (size_t)(p - s)); tmp[p - s] = 0;
+    *d = strtod(tmp, NULL);
+    if (!isfinite(*d)) return 0;
+    c->p = p;
+    return 1;
+}
+static int rp_lit(rp_cur *c, const char *w) { size_t n = strlen(w); if ((size_t)(c->e - c->p) < n || memcmp(c->p, w, n)) return 0; c->p += n; return 1; }
+static int rp_value(rp_cur *c, rp_val *v) {
+    if (c->p >= c->e) return 0;
+    if (*c->p == '"') { v->kind = 's'; return rp_str(c, v->s, sizeof v->s); }
+    if (*c->p == '-' || (*c->p >= '0' && *c->p <= '9')) { v->kind = 'n'; return rp_num(c, &v->d); }
+    v->kind = 'o';
+    return rp_lit(c, "true") || rp_lit(c, "false") || rp_lit(c, "null");
+}
+static int rp_int(const rp_val *v, double lo, double hi) { return v->kind == 'n' && v->d == floor(v->d) && v->d >= lo && v->d <= hi; }
+static int rp_code_ok(const char *s) { size_t n = strlen(s); if (n < 4 || n > 32) return 0; for (; *s; s++) if (!((*s >= '0' && *s <= '9') || (*s >= 'a' && *s <= 'z') || (*s >= 'A' && *s <= 'Z'))) return 0; return 1; }
+static int rp_id_ok(const char *s) { size_t n = strlen(s); if (n < 8 || n > 32) return 0; for (; *s; s++) if (!((*s >= '0' && *s <= '9') || (*s >= 'a' && *s <= 'z') || (*s >= 'A' && *s <= 'Z') || *s == '_' || *s == '-')) return 0; return 1; }
+static int rp_sid_ok(const char *s) { if (strlen(s) != 16) return 0; for (; *s; s++) if (!((*s >= '0' && *s <= '9') || (*s >= 'a' && *s <= 'f'))) return 0; return 1; }
diff --git a/dm/host/remote_mac.c b/dm/host/remote_mac.c
new file mode 100644
index 0000000..a16b091
--- /dev/null
+++ b/dm/host/remote_mac.c
@@ -0,0 +1,142 @@
+// Wi-Fi controllers on the Mac (remote_mac.h; protocol and sessions in remote_proto.h, docs/wifi-controllers.md): with DM_REMOTE=1 one IPv4 UDP socket and one thread take the
+// phones' datagrams, polling every 20 ms for the session timers. Off by default: without DM_REMOTE=1 no socket is opened.
+//   DM_REMOTE_PORT (default 47800; 0 = any free port, for tests), DM_REMOTE_BIND (the address to listen on, default every IPv4 address of this Mac),
+//   DM_REMOTE_CODE (the pairing code, 4-32 letters and digits; a random 6-digit one for this start when unset), DM_REMOTE_PLAYERS (the highest player a phone may be, default 8:
+//   4 keeps phones within a four-player game), DM_REMOTE_TIMEOUT_MS (a silent phone loses its session after this long, default 5000; its buttons are released after 500 ms).
+#include "dm.h"
+#include "remote_mac.h"
+#include "remote_mac_int.h"
+#include <arpa/inet.h>
+#include <errno.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+rp_server rm_srv;
+pthread_mutex_t rm_srv_mu = PTHREAD_MUTEX_INITIALIZER;
+_Atomic int rm_on;
+int rm_max = DM_PLAYERS;
+pad_slots *rm_slots; pthread_mutex_t *rm_slots_mu;
+int (*rm_input_on)(void); void (*rm_changed)(void);
+static int g_fd = -1;
+static _Atomic int g_stopped;
+static uint16_t g_port;
+static char g_where[64];   // the address phones connect to
+static unsigned char *g_icon;
+
+static void send_to(rp_addr a, const char *text, size_t n) {
+    if (!n || g_fd < 0) return;
+    struct sockaddr_in sa = {.sin_len = sizeof sa, .sin_family = AF_INET, .sin_port = a.port, .sin_addr.s_addr = a.ip};
+    (void)sendto(g_fd, text, n, 0, (struct sockaddr *)&sa, sizeof sa);
+}
+static void *rx_main(void *arg) {
+    (void)arg;
+    char buf[1536], out[RP_MAX_PACKET]; static rp_reply rep[RP_SESSIONS * 6];   // an ack, a rumble, an info, a roster, a race and a keyboard message per phone at most
+    while (!atomic_load(&g_stopped)) {
+        struct pollfd pfd = {g_fd, POLLIN, 0};
+        int r = poll(&pfd, 1, 20);
+        pthread_mutex_lock(&rm_srv_mu);
+        for (int i = 0; r > 0 && i < 64; i++) {   // what has arrived, then the timers
+            struct sockaddr_in sa; socklen_t len = sizeof sa;
+            ssize_t n = recvfrom(g_fd, buf, sizeof buf, MSG_DONTWAIT, (struct sockaddr *)&sa, &len);
+            if (n < 0) break;
+            if (len < (socklen_t)sizeof sa || sa.sin_family != AF_INET) continue;
+            rp_addr from = {sa.sin_addr.s_addr, sa.sin_port};
+            size_t k = rp_packet(&rm_srv, buf, (size_t)n, from, now_ns(), out, sizeof out);
+            send_to(from, out, k);
+        }
+        int k = rp_tick(&rm_srv, now_ns(), rep, (int)(sizeof rep / sizeof rep[0]));
+        for (int i = 0; i < k; i++) send_to(rep[i].to, rep[i].text, rep[i].n);
+        pthread_mutex_unlock(&rm_srv_mu);
+    }
+    return NULL;
+}
+void dm_remote_stop(void) {
+    if (!atomic_load(&rm_on) || atomic_exchange(&g_stopped, 1)) return;
+    rp_reply rep[RP_SESSIONS];
+    pthread_mutex_lock(&rm_srv_mu);
+    int k = rp_close_all(&rm_srv, rep, RP_SESSIONS);
+    for (int i = 0; i < k; i++) send_to(rep[i].to, rep[i].text, rep[i].n);
+    pthread_mutex_unlock(&rm_srv_mu);
+}
+static long env_num(const char *name, long def, long lo, long hi) {
+    const char *e = getenv(name); if (!e || !*e) return def;
+    char *end; long v = strtol(e, &end, 10);
+    if (*end || v < lo || v > hi) { LOG("[RED] %s=%s is not a number from %ld to %ld: using %ld", name, e, lo, hi, def); return def; }
+    return v;
+}
+int dm_remote_start(pad_slots *slots, pthread_mutex_t *mu, int (*input_on)(void), void (*changed)(void)) {
+    const char *e = getenv("DM_REMOTE");
+    if (!e || strcmp(e, "1") || atomic_load(&rm_on)) return atomic_load(&rm_on);
+    rm_slots = slots; rm_slots_mu = mu; rm_input_on = input_on; rm_changed = changed;
+    long port = env_num("DM_REMOTE_PORT", RP_PORT, 0, 65535);
+    rm_max = (int)env_num("DM_REMOTE_PLAYERS", DM_PLAYERS, 1, DM_PLAYERS);
+    long timeout = env_num("DM_REMOTE_TIMEOUT_MS", RP_TIMEOUT_MS, 200, 60000);
+    char code[33]; const char *c = getenv("DM_REMOTE_CODE"); int own_code = !(c && *c);
+    if (c && *c && !rp_code_ok(c)) { LOG("[RED] DM_REMOTE_CODE must be 4 to 32 letters and digits: using a random code for this start"); own_code = 1; }
+    if (own_code) snprintf(code, sizeof code, "%06u", arc4random_uniform(1000000)); else snprintf(code, sizeof code, "%s", c);
+    struct in_addr bind_ip = {INADDR_ANY};
+    const char *b = getenv("DM_REMOTE_BIND");
+    if (b && *b && inet_pton(AF_INET, b, &bind_ip) != 1) { LOG("[RED] DM_REMOTE_BIND=%s is not an IPv4 address: Wi-Fi controllers are off", b); return 0; }
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    struct sockaddr_in sa = {.sin_len = sizeof sa, .sin_family = AF_INET, .sin_port = htons((uint16_t)port), .sin_addr = bind_ip};
+    if (fd < 0 || bind(fd, (struct sockaddr *)&sa, sizeof sa)) {
+        LOG("[RED] Wi-Fi controllers: cannot listen on UDP port %ld (%s; another host running?): they are off", port, strerror(errno));
+        if (fd >= 0) close(fd);
+        return 0;
+    }
+    socklen_t len = sizeof sa; getsockname(fd, (struct sockaddr *)&sa, &len); g_port = ntohs(sa.sin_port);
+    g_fd = fd;
+    rp_hooks h; rm_hooks(&h);
+    rp_init(&rm_srv, code, (uint32_t)timeout, &h);
+    rp_set_game(&rm_srv, DM_GAME_NAME);
+    rm_race_start();
+    char icon_from[1024] = "";
+    size_t icon_n = g_icon ? rm_srv.icon.n : rm_icon_load(&g_icon, icon_from, sizeof icon_from);
+    rp_set_icon(&rm_srv, g_icon, icon_n);
+    if (icon_n) LOG("Wi-Fi controllers: the game card's icon is %zu bytes, from %s", icon_n, icon_from);
+    else LOG("Wi-Fi controllers: no icon for the phones' game card (%s; DM_REMOTE_ICON names one)", icon_from[0] ? icon_from : "no DM_ROMFS");
+    // Where phones connect: the bound address, or each IPv4 address of this Mac's interfaces (the Wi-Fi / Ethernet ones first)
+    char addrs[256] = ""; size_t an = 0;
+    if (bind_ip.s_addr != INADDR_ANY) { inet_ntop(AF_INET, &bind_ip, g_where, sizeof g_where); snprintf(addrs, sizeof addrs, "%s", g_where); }
+    else {
+        struct ifaddrs *ifs = NULL;
+        if (!getifaddrs(&ifs)) for (int pass = 0; pass < 2; pass++) for (struct ifaddrs *i = ifs; i; i = i->ifa_next) {
+            if (!i->ifa_addr || i->ifa_addr->sa_family != AF_INET || !(i->ifa_flags & IFF_UP) || (i->ifa_flags & IFF_LOOPBACK)) continue;
+            if ((strncmp(i->ifa_name, "en", 2) != 0) != pass) continue;
+            char ip[INET_ADDRSTRLEN]; inet_ntop(AF_INET, &((struct sockaddr_in *)i->ifa_addr)->sin_addr, ip, sizeof ip);
+            if (!g_where[0] && strncmp(ip, "169.254.", 8)) snprintf(g_where, sizeof g_where, "%s", ip);
+            int w = snprintf(addrs + an, sizeof addrs - an, "%s%s (%s)", an ? ", " : "", ip, i->ifa_name);
+            if (w > 0 && (size_t)w < sizeof addrs - an) an += (size_t)w;
+        }
+        if (ifs) freeifaddrs(ifs);
+        if (!g_where[0]) snprintf(g_where, sizeof g_where, "this Mac's IP address");
+    }
+    LOG("Wi-Fi controllers on (DM_REMOTE=1): UDP port %u, phones up to player %d, a silent phone is released after %lld ms and loses its player after %ld ms",
+        g_port, rm_max, (long long)(rm_srv.hold_ns / 1000000), timeout);
+    LOG("Wi-Fi controllers: connect phones to %s, port %u, pairing code %s", addrs[0] ? addrs : g_where, g_port,
+        own_code ? code : "from DM_REMOTE_CODE (shown by the launcher and the Controllers menu)");
+    atomic_store(&rm_on, 1);
+    pthread_t th;
+    if (pthread_create(&th, NULL, rx_main, NULL)) { LOG("[RED] Wi-Fi controllers: no receiver thread"); atomic_store(&rm_on, 0); close(fd); g_fd = -1; return 0; }
+    pthread_detach(th);
+    atexit(dm_remote_stop);
+    return 1;
+}
+int dm_remote_info(char *out, size_t cap) {
+    if (!atomic_load(&rm_on)) { if (cap) out[0] = 0; return 0; }
+    snprintf(out, cap, "%s:%u, code %s", g_where, g_port, rm_srv.code);
+    return 1;
+}
+void dm_remote_players(char *out, size_t cap) {
+    if (!cap) return;
+    out[0] = 0;
+    if (!atomic_load(&rm_on)) return;
+    pthread_mutex_lock(&rm_srv_mu); rp_players(&rm_srv, out, cap); pthread_mutex_unlock(&rm_srv_mu);
+}
+uint16_t dm_remote_port(void) { return atomic_load(&rm_on) ? g_port : 0; }
+
+int dm_remote_pair_uri(char *out,size_t cap){if(!atomic_load(&rm_on))return 0;return (int)rp_pair_uri(out,cap,g_where,g_port,rm_srv.code);}
diff --git a/dm/host/remote_mac.h b/dm/host/remote_mac.h
new file mode 100644
