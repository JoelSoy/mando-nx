index 42ff5fb..816cceb 100644
--- a/dm/host/hle_svc.c
+++ b/dm/host/hle_svc.c
@@ -28,6 +28,8 @@ static uint64_t *g_alias_exposed;   // one bit per host page ever opened; protec
