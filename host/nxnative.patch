index 0000000..7f69bcf
--- /dev/null
+++ b/dm/host/controls_mac.h
@@ -0,0 +1,13 @@
+// The Mac keyboard map's file and its window (controls_mac.m; the map itself is kbd_map.h). Main thread only.
+#pragma once
+#include <stddef.h>
+#include "kbd_map.h"
+
+// The map file: DM_KBD_MAP, else ~/Library/Application Support/nxnative/keyboard.txt (one map for every game; outside the game's folders and the repository)
+void dm_kbd_path(char *out, size_t cap);
+int dm_kbd_load(kbd_map *m);         // the file over the built-in map (its problems logged); 0 and the built-in map when there is no file
+int dm_kbd_save(const kbd_map *m);   // writes the file (a map equal to the built-in one removes it, so a later build's defaults apply); 1 on success
+// The Keyboard Controls window (the Controllers menu, ⌘K): a row per action with two key boxes; a click on a box, then a key, assigns it, saved at once.
+// m is the front end's map, changed in place; changed() is called after each change (the front end lets go of the keys held)
+void dm_controls_init(kbd_map *m, void (*changed)(void));
+void dm_controls_show(void);
diff --git a/dm/host/controls_mac.m b/dm/host/controls_mac.m
new file mode 100644
index 0000000..456140c
--- /dev/null
+++ b/dm/host/controls_mac.m
@@ -0,0 +1,130 @@
+// The Mac keyboard map's file and its Keyboard Controls window (controls_mac.h). The window lays out a row per action (kbd_map.h KBD_ACTION) in two columns, each row with two key
+// boxes. Clicking a box waits for a key: the next key pressed (Shift, Control and Option too) is that box's key, Esc cancels, Delete clears the box, a Command shortcut still goes to
+// the menus. A key already used by another action moves to this one. Every change is saved at once and applies to the game at once; Restore Defaults removes the file.
+// While the window is in front the game window is not key, so the game sees no keyboard input (front_mac.m input_release).
+#import <Cocoa/Cocoa.h>
+#include "dm.h"
+#include "controls_mac.h"
+#include <errno.h>
+#include <stdlib.h>
+
+void dm_kbd_path(char *out, size_t cap) {
+    const char *e = getenv("DM_KBD_MAP");
+    if (e && *e) { snprintf(out, cap, "%s", e); return; }
+    const char *home = getenv("HOME");
+    snprintf(out, cap, "%s/Library/Application Support/nxnative/keyboard.txt", home && *home ? home : ".");
+}
+static void warn_line(void *ctx, int line, const char *msg) { LOG("[RED] keyboard map %s line %d: %s (the line is ignored)", (const char *)ctx, line, msg); }
+int dm_kbd_load(kbd_map *m) {
+    char path[1024]; dm_kbd_path(path, sizeof path);
+    kbd_default(m);
+    FILE *f = fopen(path, "r");
+    if (!f) { if (errno != ENOENT) LOG("[RED] keyboard map %s: %s (using the built-in keys)", path, strerror(errno)); return 0; }
+    char text[16384]; size_t n = fread(text, 1, sizeof text - 1, f); text[n] = 0; fclose(f);
+    int bad = kbd_parse(m, text, warn_line, path);
+    LOG("front end: keyboard map from %s%s", path, bad ? " (some lines ignored)" : "");
+    return 1;
+}
+int dm_kbd_save(const kbd_map *m) {
+    char path[1024]; dm_kbd_path(path, sizeof path);
+    NSString *p = @(path);
+    if (kbd_is_default(m)) {
+        if (unlink(path) && errno != ENOENT) { LOG("[RED] keyboard map %s: cannot remove it: %s", path, strerror(errno)); return 0; }
+        LOG("front end: keyboard map back to the built-in keys (%s removed)", path);
+        return 1;
+    }
+    NSError *err = nil;
+    if (![NSFileManager.defaultManager createDirectoryAtPath:p.stringByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:&err]) {
+        LOG("[RED] keyboard map %s: cannot make its folder: %s", path, err.localizedDescription.UTF8String); return 0;
+    }
+    char text[8192]; size_t n = kbd_format(m, text, sizeof text);
+    NSData *d = [NSData dataWithBytes:text length:n];
+    if (![d writeToFile:p options:NSDataWritingAtomic error:&err]) { LOG("[RED] keyboard map %s: cannot write it: %s", path, err.localizedDescription.UTF8String); return 0; }
+    LOG("front end: keyboard map saved to %s", path);
+    return 1;
+}
+
+static kbd_map *g_map; static void (*g_changed)(void);
+static NSWindow *g_cwin; static NSTextField *g_status;
+static NSButton *g_box[KBD_ACTIONS][2];
+static int g_capture = -1;   // the box waiting for a key: action * 2 + box, -1 = none
+static id g_monitor;
+static const char *ROWS[2][13] = {
+    {"A", "B", "X", "Y", "L", "R", "ZL", "ZR", "Plus", "Minus", "LS", "RS", "Shake"},
+    {"DpadUp", "DpadDown", "DpadLeft", "DpadRight", "LStickUp", "LStickDown", "LStickLeft", "LStickRight", "RStickUp", "RStickDown", "RStickLeft", "RStickRight", NULL},
+};
+static NSString *key_title(int code) {
+    static const struct { const char *name, *shown; } nice[] = {{"LeftArrow", "\xe2\x86\x90"}, {"RightArrow", "\xe2\x86\x92"}, {"UpArrow", "\xe2\x86\x91"}, {"DownArrow", "\xe2\x86\x93"}};
+    const char *n = kbd_key_name(code); if (!n) return @"?";
+    for (size_t i = 0; i < sizeof nice / sizeof nice[0]; i++) if (!strcmp(n, nice[i].name)) return @(nice[i].shown);
+    return @(n);
+}
+static void refresh(void) {
+    for (int a = 0; a < KBD_ACTIONS; a++) {
+        int codes[KBD_KEYS], n = kbd_keys_of(g_map, a, codes, KBD_KEYS);
+        for (int b = 0; b < 2; b++) if (g_box[a][b]) g_box[a][b].title = g_capture == a * 2 + b ? @"Press a key\xe2\x80\xa6" : b < n ? key_title(codes[b]) : @"\xe2\x80\x94";
+    }
+    char path[1024]; dm_kbd_path(path, sizeof path);
+    g_status.stringValue = g_capture >= 0 ? [NSString stringWithFormat:@"Press the key for %s. Esc cancels, Delete clears the box.", KBD_ACTION[g_capture / 2].label]
+                                          : [NSString stringWithFormat:@"Click a box, then press a key. Saved to %s", path];
+}
+static void changed(void) { dm_kbd_save(g_map); if (g_changed) g_changed(); }
+static void assign(int code) {   // the captured box gets the key
+    int a = g_capture / 2, b = g_capture % 2, codes[KBD_KEYS], n = kbd_keys_of(g_map, a, codes, KBD_KEYS);
+    g_capture = -1;
+    if (b < n && codes[b] != code) kbd_set(g_map, codes[b], -1);   // the box's old key
+    if (code >= 0) {
+        int old = g_map->act[code] ? g_map->act[code] - 1 : -1;
+        kbd_set(g_map, code, a);
+        if (old >= 0 && old != a) LOG("front end: key %s moved from %s to %s", kbd_key_name(code), KBD_ACTION[old].name, KBD_ACTION[a].name);
+    }
+    changed(); refresh();
+}
+
+@interface DmControls : NSObject <NSWindowDelegate> @end
+@implementation DmControls
+- (void)box:(NSButton *)sender { g_capture = (int)sender.tag; refresh(); }
+- (void)restore:(id)sender { (void)sender; g_capture = -1; kbd_default(g_map); changed(); refresh(); }
+- (void)windowWillClose:(NSNotification *)n { (void)n; g_capture = -1; }
+@end
+static DmControls *g_target;
+
+void dm_controls_init(kbd_map *m, void (*cb)(void)) { g_map = m; g_changed = cb; }
+void dm_controls_show(void) {
+    if (!g_map) return;
+    if (g_cwin) { refresh(); [g_cwin makeKeyAndOrderFront:nil]; return; }
+    g_target = [DmControls new];
+    const CGFloat W = 760, H = 500, top = H - 64, row = 28;
+    g_cwin = [[NSWindow alloc] initWithContentRect:NSMakeRect(0, 0, W, H) styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable backing:NSBackingStoreBuffered defer:NO];
+    g_cwin.title = @"Keyboard Controls"; g_cwin.releasedWhenClosed = NO; g_cwin.delegate = g_target;
+    NSView *v = g_cwin.contentView;
+    for (int col = 0; col < 2; col++) {
+        CGFloat x0 = 20 + col * 375;
+        NSArray *heads = @[@"Action", @"Key", @"Second key"]; CGFloat hx[3] = {0, 160, 265};
+        for (int i = 0; i < 3; i++) { NSTextField *h = [NSTextField labelWithString:heads[i]]; h.font = [NSFont boldSystemFontOfSize:12]; h.frame = NSMakeRect(x0 + hx[i], top + 10, 120, 18); [v addSubview:h]; }
+        for (int r = 0; r < 13 && ROWS[col][r]; r++) {
+            int a = kbd_action_of(ROWS[col][r]); CGFloat y = top - 10 - r * row;
+            NSTextField *l = [NSTextField labelWithString:@(KBD_ACTION[a].label)]; l.frame = NSMakeRect(x0, y + 3, 155, 18); [v addSubview:l];
+            for (int b = 0; b < 2; b++) {
+                NSButton *bt = [NSButton buttonWithTitle:@"" target:g_target action:@selector(box:)];
+                bt.frame = NSMakeRect(x0 + 155 + b * 105, y, 100, 26); bt.tag = a * 2 + b; bt.bezelStyle = NSBezelStyleRounded;
+                g_box[a][b] = bt; [v addSubview:bt];
+            }
+        }
+    }
+    g_status = [NSTextField wrappingLabelWithString:@""]; g_status.frame = NSMakeRect(20, 18, W - 200, 40); g_status.textColor = NSColor.secondaryLabelColor; [v addSubview:g_status];
+    NSButton *rd = [NSButton buttonWithTitle:@"Restore Defaults" target:g_target action:@selector(restore:)]; rd.frame = NSMakeRect(W - 170, 20, 150, 28); [v addSubview:rd];
+    // The box waiting for a key takes the next key here, before the window's own handling (Tab, Return and Esc would move the focus, press a button or close it)
+    g_monitor = [NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown | NSEventMaskFlagsChanged handler:^NSEvent *(NSEvent *e) {
+        if (g_capture < 0 || e.window != g_cwin) return e;
+        if (e.type == NSEventTypeFlagsChanged) { int down; if (kbd_modifier(e.keyCode, e.modifierFlags, &down) && down) assign(e.keyCode); return nil; }
+        if (e.modifierFlags & NSEventModifierFlagCommand) return e;
+        if (e.keyCode == 53) { g_capture = -1; refresh(); return nil; }   // Esc
+        if (e.keyCode == 51) { assign(-1); return nil; }                    // Delete: the box is cleared
+        if (e.keyCode < KBD_KEYS && kbd_key_name(e.keyCode)) assign(e.keyCode);
+        else NSBeep();
+        return nil;
+    }];
+    refresh();
+    [g_cwin center]; [g_cwin makeKeyAndOrderFront:nil];
+}
