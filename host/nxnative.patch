@@ -0,0 +1,22 @@
+// Wi-Fi controllers on the Mac: what remote_mac.c (the socket and its thread), remote_front.c (the hooks into the front end, hid, haptics and the game's keyboard),
+// remote_icon.c (the game card's icon) and remote_race.c (the course, place, lap and coins) share. Not for other files: their interface is remote_mac.h.
+#pragma once
+#include <pthread.h>
+#include <stdatomic.h>
+#include "remote_proto.h"
+#include "pad_slots.h"
+
+enum { RM_ICON_PX = 128, RM_ICON_MAX = 65536 };   // the icon's thumbnail: at most this many pixels a side, this many bytes
+
+extern rp_server rm_srv;
+extern pthread_mutex_t rm_srv_mu;   // the sessions: the receiver's thread, the status queries, the keyboard bridge and dm_remote_stop
+extern _Atomic int rm_on;
+extern int rm_max;                  // the highest player a phone may take (DM_REMOTE_PLAYERS)
+extern pad_slots *rm_slots; extern pthread_mutex_t *rm_slots_mu;
+extern int (*rm_input_on)(void); extern void (*rm_changed)(void);
+
+void rm_hooks(rp_hooks *h);           // remote_front.c: the sessions' hooks
+void rm_race_start(void);             // remote_race.c: on a build with known race data, follows the courses the game opens
+void rm_race_read(int player, rp_race *r);   // the race that player is in now
+extern void (*dm_fs_opened)(const char *path);   // hle_fs.c: called with each path the game opens (NULL: nobody listens)
+size_t rm_icon_load(unsigned char **out, char *from, size_t from_cap);   // remote_icon.c: the thumbnail (malloc'd; 0 = none) and the file it came from
diff --git a/dm/host/remote_packet.h b/dm/host/remote_packet.h
new file mode 100644
index 0000000..b66856e
--- /dev/null
+++ b/dm/host/remote_packet.h
@@ -0,0 +1,66 @@
+// Wi-Fi controllers (remote_proto.h): one phone datagram. Joining (the pairing code, its limit, a free player, the same player for a phone that comes back), the
+// state stream (newer seq only, at most RP_RATE a second), bye, an answer to the game's keyboard and a request for a piece of the icon.
+#pragma once
+#include "remote_feed.h"
+#include "remote_parse.h"
+
+// One datagram from `from` at time now: updates the sessions and writes the reply to send back to `from` into out (returns its length, 0 = no reply)
+static size_t rp_packet(rp_server *s, const char *buf, size_t n, rp_addr from, uint64_t now, char *out, size_t cap) {
+    rp_msg m; const char *why; char ip[16];
+    if (rp_parse(buf, n, &m, &why) == RP_ERR) { rp_bad(s, why); return 0; }
+    if (m.type == RP_HELLO) {
+        if (m.version != RP_VERSION) return rp_reject(out, cap, "version");
+        if (rp_blocked(s, from.ip, now)) return rp_reject(out, cap, "busy");
+        if (!rp_code_ok(m.code) || !rp_code_eq(m.code, s->code)) {
+            rp_fail *f = rp_fail_of(s, from.ip, now, 1); f->fails++; f->last_ns = now; s->all_fails++;
+            if (now - s->fail_logged > 2000000000ull || !s->fail_logged) { s->fail_logged = now; rp_ip(ip, from.ip); rp_say(s, "Wi-Fi: wrong pairing code from %s", ip); }
+            return rp_reject(out, cap, "code");
+        }
+        rp_session *x = NULL;
+        for (int i = 0; i < RP_SESSIONS && !x; i++) if (s->s[i].used && !strcmp(s->s[i].id, m.id)) x = &s->s[i];
+        if (x) {   // the same phone again: its hello repeated (same address: the same session), or the app restarted / the phone changed address (a new session, the same player)
+            if (!rp_same(x->addr, from)) {
+                rp_new_sid(s, x); x->addr = from; x->seq = 0; x->acked = 0; x->released = 1; x->buttons = 0; memset(x->ax, 0, sizeof x->ax);
+                x->i_key = 0; x->o_key = 0; x->k_sent = 0; x->k_done = 0;   // the new session gets its feed again
+                rp_publish(s, x);
+                rp_ip(ip, from.ip); rp_say(s, "Wi-Fi controller '%s' rejoined from %s: player %d", x->name, ip, x->player + 1);
+            }
+            if (x->rumble != m.rumble) { rp_rumble_route(s, x, 0); x->rumble = m.rumble; rp_rumble_route(s, x, 1); }   // the app's rumble setting changed
+            x->rx_ns = now; x->acked = 0;   // its next state is taken whatever its seq: a restarted app on the same port counts from 0 again
+            return rp_welcome(s, x, out, cap);
+        }
+        for (int i = 0; i < RP_SESSIONS && !x; i++) if (!s->s[i].used) x = &s->s[i];
+        if (!x) return rp_reject(out, cap, "full");
+        char slot_name[48]; snprintf(slot_name, sizeof slot_name, "wifi:%s", m.id);
+        int p = s->h.take(s->h.ctx, x, slot_name);
+        if (p < 0) { rp_say(s, "Wi-Fi: a phone wants to join, but no player is free"); return rp_reject(out, cap, "full"); }
+        memset(x, 0, sizeof *x);
+        x->used = 1; x->player = p; x->addr = from; x->rx_ns = now; x->released = 1; x->rumble = m.rumble;
+        snprintf(x->id, sizeof x->id, "%s", m.id); rp_name_clean(x->name, sizeof x->name, m.name);
+        rp_new_sid(s, x);
+        rp_ip(ip, from.ip); rp_say(s, "Wi-Fi controller '%s' connected from %s: player %d%s", x->name, ip, p + 1, x->rumble ? ", with game rumble" : "");
+        rp_rumble_route(s, x, 1);
+        if (s->h.changed) s->h.changed(s->h.ctx);
+        return rp_welcome(s, x, out, cap);
+    }
+    rp_session *x = NULL;
+    for (int i = 0; i < RP_SESSIONS && !x; i++) if (s->s[i].used && !strcmp(s->s[i].sid, m.sid)) x = &s->s[i];
+    if (x && !rp_same(x->addr, from)) { rp_bad(s, "a session id from another address"); return 0; }
+    if (!x) {   // a session this host does not have (it restarted, or the session timed out): the phone joins again
+        if (now - s->kick_t0 > 1000000000ull) { s->kick_t0 = now; s->kicks = 0; }
+        if (s->kicks++ >= RP_KICKS) return 0;
+        return rp_out(out, cap, "{\"v\":1,\"t\":\"kick\",\"reason\":\"session\"}");
+    }
+    if (m.type == RP_BYE) { rp_end(s, x, "left"); return rp_out(out, cap, "{\"v\":1,\"t\":\"bye\",\"reason\":\"left\"}"); }
+    if (now - x->rate_t0 > 1000000000ull) { x->rate_t0 = now; x->rate_n = 0; }
+    if (x->rate_n++ >= RP_RATE) { rp_bad(s, "more than 250 packets a second from one phone"); return 0; }
+    if (m.type == RP_TEXT_IN) return rp_text_in(s, x, &m, out, cap);
+    if (m.type == RP_ICON_REQ) return rp_icon_part(s, x, m.off, out, cap);
+    if (x->acked && !rp_seq_newer(m.seq, x->seq)) return 0;   // older or repeated: a newer whole state was already taken
+    x->seq = m.seq; x->rx_ns = now; x->released = 0;
+    x->buttons = m.buttons & 0xffffu; x->ms = m.ms; x->has_ms = m.has_ms;
+    rp_stick(m.ax[0], m.ax[1], &x->ax[0], &x->ax[1]); rp_stick(m.ax[2], m.ax[3], &x->ax[2], &x->ax[3]);
+    rp_publish(s, x);
+    if (!x->acked) { x->acked = 1; x->ack_ns = now; return rp_ack(x, out, cap); }   // the first state is acked at once: the phone shows its player
+    return 0;
+}
diff --git a/dm/host/remote_parse.h b/dm/host/remote_parse.h
new file mode 100644
index 0000000..513fc13
--- /dev/null
+++ b/dm/host/remote_parse.h
@@ -0,0 +1,77 @@
+// Wi-Fi controllers (remote_proto.h): one phone datagram → rp_msg. Types: hello, state, bye, text (an answer to the game's keyboard) and icon (a piece of the game's icon).
+#pragma once
+#include "remote_json.h"
+
+// One datagram → m. Returns the type, or RP_ERR with *why saying what was wrong (for the host's summary of ignored packets)
+static int rp_parse(const char *buf, size_t n, rp_msg *m, const char **why) {
+    static const char *const keys[] = {"v", "t", "code", "id", "name", "sid", "seq", "b", "lx", "ly", "rx", "ry", "ms", "rumble", "ks", "text", "ok", "off"};
+    enum { K_V, K_T, K_CODE, K_ID, K_NAME, K_SID, K_SEQ, K_B, K_LX, K_LY, K_RX, K_RY, K_MS, K_RUMBLE, K_KS, K_TEXT, K_OK, K_OFF, K_N };
+    const char *w = "not a JSON object"; uint32_t seen = 0; char type[16] = "";
+    memset(m, 0, sizeof *m); m->type = RP_ERR;
+    if (why) *why = "";
+    if (n > RP_MAX_PACKET) { if (why) *why = "too long"; return RP_ERR; }
+    rp_cur c = {buf, buf + n};
+    rp_ws(&c);
+    if (c.p >= c.e || *c.p != '{') goto bad;
+    c.p++; rp_ws(&c);
+    int members = 0;
+    if (c.p < c.e && *c.p == '}') c.p++;
+    else for (;;) {
+        char key[24]; rp_val v;
+        w = "malformed member";
+        if (++members > 32 || !rp_str(&c, key, sizeof key)) goto bad;
+        rp_ws(&c); if (c.p >= c.e || *c.p != ':') goto bad;
+        c.p++; rp_ws(&c);
+        if (!rp_value(&c, &v)) { w = "malformed value (nested values are not taken)"; goto bad; }
+        int k = 0; while (k < K_N && strcmp(key, keys[k])) k++;
+        if (k < K_N) {
+            if (seen >> k & 1) { w = "a key twice"; goto bad; }
+            seen |= 1u << k; w = "a value of the wrong type or range";
+            switch (k) {
+                case K_V: if (!rp_int(&v, 0, 1e6)) goto bad; m->version = (int)v.d; break;
+                case K_T: if (v.kind != 's' || strlen(v.s) >= sizeof type) goto bad; strcpy(type, v.s); break;
+                case K_CODE: if (v.kind != 's' || strlen(v.s) >= sizeof m->code) goto bad; strcpy(m->code, v.s); break;
+                case K_ID: if (v.kind != 's' || strlen(v.s) >= sizeof m->id) goto bad; strcpy(m->id, v.s); break;
+                case K_NAME: if (v.kind != 's' || strlen(v.s) >= sizeof m->name) goto bad; strcpy(m->name, v.s); break;
+                case K_SID: if (v.kind != 's' || strlen(v.s) >= sizeof m->sid) goto bad; strcpy(m->sid, v.s); break;
+                case K_TEXT: if (v.kind != 's' || strlen(v.s) >= sizeof m->text) goto bad; strcpy(m->text, v.s); break;
+                case K_SEQ: if (!rp_int(&v, 0, 4294967295.0)) goto bad; m->seq = (uint32_t)v.d; break;
+                case K_KS: if (!rp_int(&v, 0, 4294967295.0)) goto bad; m->ks = (uint32_t)v.d; break;
+                case K_OFF: if (!rp_int(&v, 0, 16777215.0)) goto bad; m->off = (uint32_t)v.d; break;
+                case K_B: if (!rp_int(&v, 0, 0xffff)) goto bad; m->buttons = (uint32_t)v.d; break;
+                case K_MS: if (!rp_int(&v, 0, 9007199254740991.0)) goto bad; m->ms = (int64_t)v.d; m->has_ms = 1; break;
+                case K_RUMBLE: if (!rp_int(&v, 0, 1)) goto bad; m->rumble = (int)v.d; break;
+                case K_OK: if (!rp_int(&v, 0, 1)) goto bad; m->ok = (int)v.d; break;
+                default: if (v.kind != 'n') goto bad; m->ax[k - K_LX] = v.d; break;
+            }
+        }
+        rp_ws(&c);
+        if (c.p < c.e && *c.p == ',') { c.p++; rp_ws(&c); continue; }
+        if (c.p < c.e && *c.p == '}') { c.p++; break; }
+        w = "malformed object"; goto bad;
+    }
+    rp_ws(&c);
+    if (c.p != c.e) { w = "bytes after the object"; goto bad; }
+    if (!(seen >> K_V & 1)) { w = "no protocol version (v)"; goto bad; }
+    if (!strcmp(type, "hello")) {
+        if (!(seen >> K_CODE & 1) || !(seen >> K_ID & 1) || !rp_id_ok(m->id)) { w = "hello without a valid code or id"; goto bad; }
+        m->type = RP_HELLO;
+    } else if (!strcmp(type, "state")) {
+        if (!rp_sid_ok(m->sid) || !(seen >> K_SEQ & 1) || !(seen >> K_B & 1)) { w = "state without a valid sid, seq or b"; goto bad; }
+        m->type = RP_STATE;
+    } else if (!strcmp(type, "bye")) {
+        if (!rp_sid_ok(m->sid)) { w = "bye without a valid sid"; goto bad; }
+        m->type = RP_BYE;
+    } else if (!strcmp(type, "text")) {
+        if (!rp_sid_ok(m->sid) || !(seen >> K_KS & 1) || !(seen >> K_OK & 1)) { w = "text without a valid sid, ks or ok"; goto bad; }
+        m->type = RP_TEXT_IN;
+    } else if (!strcmp(type, "icon")) {
+        if (!rp_sid_ok(m->sid) || !(seen >> K_OFF & 1)) { w = "icon without a valid sid or off"; goto bad; }
+        m->type = RP_ICON_REQ;
+    } else { w = "unknown message type (t)"; goto bad; }
+    return m->type;
+bad:
+    if (why) *why = w;
+    m->type = RP_ERR;
+    return RP_ERR;
+}
diff --git a/dm/host/remote_proto.h b/dm/host/remote_proto.h
new file mode 100644
index 0000000..7039567
--- /dev/null
+++ b/dm/host/remote_proto.h
@@ -0,0 +1,14 @@
+// Wi-Fi controllers (phones running dm/remote_pad; protocol in docs/wifi-controllers.md): the messages and the sessions, pure (no socket, no clock, no globals), so
+// tests/t_remote*.c check them. remote_mac.c owns the socket and its thread and passes the time in; the front end owns the player slots (pad_slots.h), reached through rp_hooks.
+// One JSON object per UDP datagram, at most RP_MAX_PACKET bytes. A phone joins with hello (the pairing code and its own stable id), gets a session id and a player, then sends its
+// whole state (seq, buttons, sticks) 50-60 times a second; that stream is also its heartbeat. The host acks every RP_ACK_MS. Older or repeated seq numbers are dropped; a phone
+// quiet for hold_ns has its buttons released, one quiet for timeout_ns loses its session and its player (kept for its id, pad_slots.h, so a rejoin gets the same player back).
+// Game rumble goes back only to a phone whose hello said "rumble":1 (older apps never get it): the vibration the game sets on that player, as one intensity / sharpness pair
+// (hle_haptics.h dm_haptics_level), sent when it changes and renewed every RP_RUMBLE_KEEP_MS while on, each with a short duration, so a phone that stops hearing stops by itself.
+// Each streaming phone also gets the game's feed (remote_feed.h): info, roster, the game's keyboard, pieces of the game's icon.
+// The parts, each including the one before:
+//   remote_types.h    constants and types           remote_json.h     reading JSON, code / id / sid checks     remote_text.h   sticks, seq, clean text, QR URI, base64, CRC
+//   remote_session.h  the server and its sessions   remote_feed.h     info, roster, keyboard, icon             remote_parse.h  one datagram → rp_msg
+//   remote_packet.h   one datagram's effect         remote_tick.h     timers, quitting, the status line
+#pragma once
+#include "remote_tick.h"
diff --git a/dm/host/remote_race.c b/dm/host/remote_race.c
new file mode 100644
index 0000000..119d16a
--- /dev/null
+++ b/dm/host/remote_race.c
@@ -0,0 +1,141 @@
+// Race data for the phones (rp_hooks.race, remote_front.c): the course from the files the game opens (hle_fs.c dm_fs_opened) and, on a game build whose racer objects are
+// known (k_race), a player's place, lap, coins, character and kart read from guest memory, and player 1's items. Fixed offsets: a row runs only on the main build it was
+// found on (nxnative AGENTS.md). The objects are found by their vtables: once a course opens, a thread searches the heap (a few tenths of a second over 3 GB) until the
+// racers' owner and a kart model for each racer are there, then the item box; each read checks the vtables, the racer count and the racer's index again, so freed or reused memory gives no
+// data rather than wrong data.
+#include "dm.h"
+#include "remote_mac.h"
+#include "remote_mac_int.h"
+#include <unistd.h>
+
+void dm_guest_heap(uint8_t **base, size_t *size);   // hle_svc.c
+int dm_guest_heap_readable(uint64_t a, size_t n);
+
+typedef struct {
+    const char *build, *course_dir, *menu;   // main's build ID; the folder each course's files are in; the course the menus load (no race)
+    uint64_t owner_vt, racer_vt;             // main offsets of the two classes' vtables
+    uint32_t count, list, index, place, lap, coins;   // owner: racer count (int32), racer pointer array; racer: its index, 0-based place and lap, coins (int32)
+    int max;                                 // racers at most
+    uint64_t model_vt; uint32_t drv, body, wing, tire;   // a kart's model (one per racer, made in racer order): the character, body, glider and tires (int32 ids)
+    uint64_t hud_vt; uint32_t state, item;   // the item box on the screen (one per local player): its two slots' states (3: holding) and items (int32 pairs)
+} race_row;
+static const race_row k_race[] = {
+    // Mario Kart 8 Deluxe 4.0.1 (v1507328): Course/<name>/ for each race, Gu_Menu behind the menus. One object of class main+0x125ada8 holds a sead::PtrArray of the racers
+    // at +0x60 (size) / +0x68 (pointers), player 1 first; a racer (class main+0x12cac28, 12 in a race) has its index at +0x38, its place at +0x40, its lap at +0x44 and its
+    // coins at +0x50. A kart model (class main+0x125a288, the files Driver/<name>.bfres, Kart/Body/… after it) has the character at +0x8, body +0x14, glider +0x18, tires
+    // +0x20, in the order of the game's part lists. The item box (class main+0x127e110, one object with one player) has the slots' states at +0x200 and their items at
+    // +0x210, ids the order of the u8 table at main+0xf21e7c (id → icon frame). Found with DM_CTL scan (hle_scan.c) against the screen (mando-nx docs/ingenieria_inversa.md)
+    {"2452c49bc26ec15904c507a34b6f16ae", "Course/", "Gu_Menu", 0x125ada8, 0x12cac28, 0x60, 0x68, 0x38, 0x40, 0x44, 0x50, 12,
+     0x125a288, 0x08, 0x14, 0x18, 0x20, 0x127e110, 0x200, 0x210},
+};
+static const race_row *g_row;
+static uint64_t g_main;
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
+static char g_course[RP_COURSE + 1];   // under g_mu
+enum { MODELS = 16 };
+static uint64_t g_model[MODELS], g_hud;   // under g_mu: the race's kart models in racer order (g_nmodel of them, 0 = unknown), the item box (0 = none, or one per player)
+static int g_nmodel;
+static _Atomic uint64_t g_owner;       // the racers' owner, 0 = not found (yet)
+static _Atomic uint32_t g_gen;         // bumped on each course change: a running search stops when it moves on
+
+static int rd(uint64_t a, void *out, size_t n) {
+    if (!dm_guest_heap_readable(a, n)) return 0;
+    memcpy(out, (const void *)(uintptr_t)a, n); return 1;
+}
+static uint64_t racer(uint64_t owner, int i) {   // racer i of owner, checked; 0 when it is not (or no longer) one
+    uint64_t vt = 0, list = 0, r = 0, rvt = 0; int32_t n = 0, idx = -1;
+    if (!rd(owner, &vt, 8) || vt != g_main + g_row->owner_vt) return 0;
+    if (!rd(owner + g_row->count, &n, 4) || n < 1 || n > g_row->max || i >= n) return 0;
+    if (!rd(owner + g_row->list, &list, 8) || !rd(list + 8 * (uint64_t)i, &r, 8)) return 0;
+    if (!rd(r, &rvt, 8) || rvt != g_main + g_row->racer_vt || !rd(r + g_row->index, &idx, 4) || idx != i) return 0;
+    return r;
+}
+// One pass over the heap: the racers' owner, the kart models (in address order, which is racer order) and the item boxes
+typedef struct { uint64_t owner, model[MODELS], hud; int nmodel, nhud; } found;
+static void find_all(found *f) {
+    uint8_t *b; size_t n; dm_guest_heap(&b, &n); memset(f, 0, sizeof *f);
+    const uint64_t ov = g_main + g_row->owner_vt, mv = g_main + g_row->model_vt, hv = g_main + g_row->hud_vt, *w = (const uint64_t *)(uintptr_t)b;
+    for (size_t i = 0; b && i < n / 8; i++) {
+        uint64_t a = (uint64_t)(uintptr_t)(w + i);
+        if (w[i] == ov && !f->owner && racer(a, 0)) f->owner = a;
+        else if (w[i] == mv) { if (f->nmodel < MODELS) f->model[f->nmodel] = a; f->nmodel++; }
+        else if (w[i] == hv) { f->hud = a; f->nhud++; }
+    }
+}
+// Until the course changes: the racers and their models (without the models after 10 s, the rest goes without), then the item boxes, which the game makes later
+static void *search_main(void *arg) {
+    uint32_t gen = (uint32_t)(uintptr_t)arg; found f; int racers = 0;
+    for (int t = 0; t < 120 && atomic_load(&g_gen) == gen; t++) {
+        find_all(&f);
+        int32_t n = 0; int ok = f.owner && rd(f.owner + g_row->count, &n, 4) && f.nmodel == n;
+        pthread_mutex_lock(&g_mu);
+        int now = atomic_load(&g_gen) == gen, pub = now && !racers && f.owner && (ok || t >= 20), hud = now && (racers || pub) && f.nhud;
+        if (pub) { g_nmodel = ok ? n : 0; memcpy(g_model, f.model, sizeof g_model); atomic_store(&g_owner, f.owner); }
+        if (hud) g_hud = f.nhud == 1 ? f.hud : 0;   // more than one: split screen, whose boxes are not told apart
+        pthread_mutex_unlock(&g_mu);
+        if (pub) { racers = 1; LOG("Wi-Fi controllers: the race's racers are at %#llx (main+%#llx's), %d kart models", (unsigned long long)f.owner,
+                                   (unsigned long long)g_row->owner_vt, f.nmodel); }
+        if (hud) { LOG("Wi-Fi controllers: %d item boxes%s", f.nhud, f.nhud == 1 ? " (player 1's items go to the phones)" : ", no items"); return NULL; }
+        usleep(500000);
+    }
+    if (atomic_load(&g_gen) == gen) LOG("Wi-Fi controllers: %s", racers ? "no item box found for this course" : "no racers found for this course (the race data stays off)");
+    return NULL;
+}
+
+// A file the game opened: a course folder other than the menus' starts a race (and the search for its racers); the menus' course ends it
+static void opened(const char *path) {
+    const char *p = strstr(path, ":/"); p = p ? p + 2 : path;
+    size_t k = strlen(g_row->course_dir);
+    if (strncmp(p, g_row->course_dir, k)) return;
+    p += k; const char *e = strchr(p, '/');
+    if (!e || e == p || e - p > RP_COURSE) return;
+    char name[RP_COURSE + 1]; memcpy(name, p, (size_t)(e - p)); name[e - p] = 0;
+    if (!strcmp(name, g_row->menu)) name[0] = 0;
+    pthread_mutex_lock(&g_mu);
+    int changed = strcmp(name, g_course) != 0;
+    if (changed) snprintf(g_course, sizeof g_course, "%s", name);
+    pthread_mutex_unlock(&g_mu);
+    if (!changed) return;
+    uint32_t gen = atomic_fetch_add(&g_gen, 1) + 1;
+    atomic_store(&g_owner, 0);
+    pthread_mutex_lock(&g_mu); g_nmodel = 0; g_hud = 0; pthread_mutex_unlock(&g_mu);
+    LOG("Wi-Fi controllers: course %s", name[0] ? name : "none (menus)");
+    pthread_t th;
+    if (name[0] && !pthread_create(&th, NULL, search_main, (void *)(uintptr_t)gen)) pthread_detach(th);
+}
+
+void rm_race_start(void) {
+    const char *b = dm_main_build();
+    for (size_t i = 0; i < sizeof k_race / sizeof k_race[0]; i++) if (!strcasecmp(b, k_race[i].build)) g_row = &k_race[i];
+    if (!g_row) return;
+    for (int i = 0; i < g_nmod; i++) if (!strcmp(g_mod[i].name, "main")) g_main = (uint64_t)(uintptr_t)g_mod[i].base;
+    dm_fs_opened = opened;
+    LOG("Wi-Fi controllers: this build's courses and race data go to the phones (main %s)", b);
+}
+static void kart_of(uint64_t m, rp_race *r) {   // a kart model, checked: its vtable, and ids within the game's lists (none has 64 entries)
+    uint64_t vt = 0; int32_t v[4] = {-1, -1, -1, -1};
+    if (!m || !rd(m, &vt, 8) || vt != g_main + g_row->model_vt || !rd(m + g_row->drv, &v[0], 4) || !rd(m + g_row->body, &v[1], 4) || !rd(m + g_row->wing, &v[2], 4)
+        || !rd(m + g_row->tire, &v[3], 4)) return;
+    for (int i = 0; i < 4; i++) if (v[i] < 0 || v[i] > 63) return;
+    r->kart = 1; r->drv = v[0]; r->body = v[1]; r->wing = v[2]; r->tire = v[3];
+}
+static void items_of(uint64_t h, rp_race *r) {   // the item box: a slot it shows as held has its item; empty, or the roulette still turning, is -1
+    uint64_t vt = 0; int32_t st[2], it[2];
+    if (!h || !rd(h, &vt, 8) || vt != g_main + g_row->hud_vt || !rd(h + g_row->state, st, 8) || !rd(h + g_row->item, it, 8)) return;
+    for (int i = 0; i < 2; i++) { if (it[i] < -1 || it[i] > 63) return; if (st[i] != 3) it[i] = -1; }
+    r->items = 1; r->item = it[0]; r->item2 = it[1];
+}
+// The race player p is in: the course, and when the racers are known, that racer's place, lap, coins, character and kart; player 1's items when they play alone
+void rm_race_read(int p, rp_race *r) {
+    if (!g_row) return;
+    pthread_mutex_lock(&g_mu);
+    snprintf(r->course, sizeof r->course, "%s", g_course); uint64_t m = p >= 0 && p < g_nmodel ? g_model[p] : 0, h = p == 0 ? g_hud : 0;
+    pthread_mutex_unlock(&g_mu);
+    if (!r->course[0]) return;
+    kart_of(m, r); items_of(h, r);
+    uint64_t o = atomic_load(&g_owner), x = o ? racer(o, p) : 0;
+    int32_t place = -1, lap = -1, coins = -1;
+    if (!x || !rd(x + g_row->place, &place, 4) || !rd(x + g_row->lap, &lap, 4) || !rd(x + g_row->coins, &coins, 4)) return;
+    if (place < 0 || place >= g_row->max || lap < 0 || lap > 99 || coins < 0 || coins > 999) return;
+    r->has = 1; r->place = place + 1; r->lap = lap + 1; r->coins = coins;
+}
diff --git a/dm/host/remote_session.h b/dm/host/remote_session.h
new file mode 100644
index 0000000..f3b9a13
--- /dev/null
+++ b/dm/host/remote_session.h
@@ -0,0 +1,98 @@
+// Wi-Fi controllers (remote_proto.h): the server and its sessions. Setting it up, publishing a phone's state to its player, rumble levels, ending a session, the wrong-code
+// limit, session ids, the welcome / ack / reject replies, and the game's name, icon and keyboard that the feed (remote_feed.h) tells the phones about.
+#pragma once
+#include "remote_text.h"
+
+static void rp_say(rp_server *s, const char *fmt, ...) {
+    char line[256]; va_list ap; va_start(ap, fmt); vsnprintf(line, sizeof line, fmt, ap); va_end(ap);
+    if (s->h.say) s->h.say(s->h.ctx, line);
+}
+static void rp_ip(char out[16], uint32_t ip) { const unsigned char *b = (const unsigned char *)&ip; snprintf(out, 16, "%u.%u.%u.%u", b[0], b[1], b[2], b[3]); }
+static void rp_init(rp_server *s, const char *code, uint32_t timeout_ms, const rp_hooks *h) {
+    memset(s, 0, sizeof *s);
+    snprintf(s->code, sizeof s->code, "%s", code);
+    if (timeout_ms < 200) timeout_ms = 200;
+    s->timeout_ns = (uint64_t)timeout_ms * 1000000ull;
+    s->hold_ns = (uint64_t)(timeout_ms / 2 < RP_HOLD_MS ? timeout_ms / 2 : RP_HOLD_MS) * 1000000ull;
+    s->ack_ns = (uint64_t)RP_ACK_MS * 1000000ull;
+    s->h = *h;
+}
+static void rp_set_game(rp_server *s, const char *name) { rp_text_clean(s->game, sizeof s->game, name ? name : "", RP_GAME_NAME, ""); }   // the game's name in info messages
+static int rp_same(rp_addr a, rp_addr b) { return a.ip == b.ip && a.port == b.port; }
+static size_t rp_out(char *out, size_t cap, const char *fmt, ...) {
+    va_list ap; va_start(ap, fmt); int n = vsnprintf(out, cap, fmt, ap); va_end(ap);
+    return n > 0 && (size_t)n < cap ? (size_t)n : 0;
+}
+static void rp_publish(rp_server *s, rp_session *x) {
+    int on = !s->h.input_on || s->h.input_on(s->h.ctx);
+    x->zeroed = !on;
+    if (on && !x->released) s->h.set(s->h.ctx, x->player, x->buttons, x->ax[0], x->ax[1], x->ax[2], x->ax[3]);
+    else s->h.set(s->h.ctx, x->player, 0, 0, 0, 0, 0);
+}
+static void rp_rumble_route(rp_server *s, rp_session *x, int on) { if (x->rumble && s->h.rumble_route) s->h.rumble_route(s->h.ctx, x->player, on); }
+// The game's rumble for a player, as dm_haptics_level gives it (intensity and sharpness, 0..1; anything else is taken as 0 / clamped)
+static void rp_rumble_level(rp_server *s, int player, float intensity, float sharpness) {
+    if (player < 0 || player >= DM_PLAYERS) return;
+    s->lvl_i[player] = isfinite(intensity) ? fmaxf(0, fminf(1, intensity)) : 0;
+    s->lvl_s[player] = isfinite(sharpness) ? fmaxf(0, fminf(1, sharpness)) : 0;
+}
+static void rp_end(rp_server *s, rp_session *x, const char *why) {
+    s->h.set(s->h.ctx, x->player, 0, 0, 0, 0, 0);   // nothing stays pressed
+    rp_rumble_route(s, x, 0);
+    s->h.drop(s->h.ctx, x);
+    rp_say(s, "Wi-Fi controller '%s' %s: player %d is free", x->name, why, x->player + 1);
+    memset(x, 0, sizeof *x);
+    if (s->h.changed) s->h.changed(s->h.ctx);
+}
+static void rp_bad(rp_server *s, const char *why) { s->bad++; snprintf(s->bad_why, sizeof s->bad_why, "%s", why); }
+// Wrong pairing codes: an address with RP_FAIL_PER_IP of them within a minute, or RP_FAIL_ALL from everyone, is refused ("busy") before its code is even compared
+static rp_fail *rp_fail_of(rp_server *s, uint32_t ip, uint64_t now, int make) {
+    rp_fail *spare = NULL;   // an empty entry, else the oldest
+    for (int i = 0; i < RP_FAIL_IPS; i++) {
+        rp_fail *f = &s->fail[i];
+        if (f->fails && now - f->last_ns > 60000000000ull) f->fails = 0;
+        if (f->fails && f->ip == ip) return f;
+        if (!spare || (spare->fails && (!f->fails || f->last_ns < spare->last_ns))) spare = f;
+    }
+    if (!make) return NULL;
+    memset(spare, 0, sizeof *spare); spare->ip = ip;
+    return spare;
+}
+static int rp_blocked(rp_server *s, uint32_t ip, uint64_t now) {
+    if (now - s->all_t0 > 60000000000ull) { s->all_t0 = now; s->all_fails = 0; }
+    rp_fail *f = rp_fail_of(s, ip, now, 0);
+    return s->all_fails >= RP_FAIL_ALL || (f && f->fails >= RP_FAIL_PER_IP);
+}
+static void rp_new_sid(rp_server *s, rp_session *x) {
+    unsigned char r[8]; s->h.random(s->h.ctx, r, sizeof r);
+    for (int i = 0; i < 8; i++) snprintf(x->sid + 2 * i, 3, "%02x", r[i]);
+}
+static size_t rp_welcome(rp_server *s, rp_session *x, char *out, size_t cap) {
+    return rp_out(out, cap, "{\"v\":1,\"t\":\"welcome\",\"sid\":\"%s\",\"player\":%d,\"hz\":%d,\"timeout_ms\":%llu}", x->sid, x->player + 1, RP_HZ,
+                  (unsigned long long)(s->timeout_ns / 1000000ull));
+}
+static size_t rp_ack(rp_session *x, char *out, size_t cap) {
+    if (x->has_ms) return rp_out(out, cap, "{\"v\":1,\"t\":\"ack\",\"sid\":\"%s\",\"seq\":%u,\"player\":%d,\"ms\":%lld}", x->sid, x->seq, x->player + 1, (long long)x->ms);
+    return rp_out(out, cap, "{\"v\":1,\"t\":\"ack\",\"sid\":\"%s\",\"seq\":%u,\"player\":%d}", x->sid, x->seq, x->player + 1);
+}
+static size_t rp_reject(char *out, size_t cap, const char *reason) { return rp_out(out, cap, "{\"v\":1,\"t\":\"reject\",\"reason\":\"%s\"}", reason); }
+// The game's icon (a small JPEG the front end made, kept by the caller) for the phones' game card: its size and CRC go in info, its pieces to a phone that asks
+static void rp_set_icon(rp_server *s, const unsigned char *data, size_t n) {
+    s->icon.data = data && n ? data : NULL;
+    s->icon.n = s->icon.data ? n : 0;
+    s->icon.crc = s->icon.n ? rp_crc32(data, n) : 0;
+}
+// The game's keyboard is waiting for text (title: what it asks for, init: the text it starts with, max: characters): every streaming phone is asked until one answers or
+// rp_kbd_end; a phone's answer goes to h.text
+static void rp_kbd_begin(rp_server *s, const char *title, const char *init, int max) {
+    s->kbd.id = s->kbd.id + 1 ? s->kbd.id + 1 : 1;
+    s->kbd.active = 1;
+    s->kbd.max = max < 1 ? 1 : max > 500 ? 500 : max;
+    rp_text_clean(s->kbd.title, sizeof s->kbd.title, title ? title : "", RP_GAME_NAME, "");
+    rp_text_clean(s->kbd.init, sizeof s->kbd.init, init ? init : "", RP_TEXT, "");
+}
+static void rp_kbd_end(rp_server *s) {   // answered or closed: the phones that were asked are told, twice
+    if (!s->kbd.active) return;
+    s->kbd.active = 0;
+    for (int i = 0; i < RP_SESSIONS; i++) if (s->s[i].used && s->s[i].k_sent == s->kbd.id) s->s[i].k_done = 2;
+}
diff --git a/dm/host/remote_text.h b/dm/host/remote_text.h
new file mode 100644
index 0000000..bbb0e4b
--- /dev/null
+++ b/dm/host/remote_text.h
@@ -0,0 +1,75 @@
+// Wi-Fi controllers (remote_proto.h): values and text. Sticks and seq order; names and other text cleaned to printable UTF-8 without quotes or backslashes, so the
+// replies that carry them need no escaping; the pairing URI for the QR code; base64 and CRC-32 for the game's icon.
+#pragma once
+#include "remote_json.h"
+
+// A stick: each axis clamped to -1..1, then the pair to the unit circle (a phone's square corner is not more than a full tilt), to ±DM_STICK_MAX
+static void rp_stick(double x, double y, int32_t *ox, int32_t *oy) {
+    x = fmax(-1.0, fmin(1.0, x)); y = fmax(-1.0, fmin(1.0, y));
+    double r = sqrt(x * x + y * y); if (r > 1.0) { x /= r; y /= r; }
+    *ox = (int32_t)lrint(x * DM_STICK_MAX); *oy = (int32_t)lrint(y * DM_STICK_MAX);
+}
+static int rp_seq_newer(uint32_t seq, uint32_t last) { return (int32_t)(seq - last) > 0; }   // serial number arithmetic: a wrap from 0xffffffff to 0 is newer
+static int rp_code_eq(const char *a, const char *b) {   // the time does not depend on where the codes differ
+    size_t na = strlen(a), nb = strlen(b); unsigned d = na != nb;
+    for (size_t i = 0; i < na && i < nb; i++) d |= (unsigned)(a[i] ^ b[i]);
+    return !d;
+}
+// Text that goes into the log, the menu or a reply: printable UTF-8 only (control bytes, quotes, backslashes and broken sequences dropped), at most `most` bytes, `none` when nothing is left
+static void rp_text_clean(char *out, size_t cap, const char *in, size_t most, const char *none) {
+    size_t n = 0, lim = cap - 1 < most ? cap - 1 : most;
+    for (const unsigned char *p = (const unsigned char *)in; *p;) {
+        int len = *p < 0x80 ? 1 : (*p & 0xe0) == 0xc0 ? 2 : (*p & 0xf0) == 0xe0 ? 3 : (*p & 0xf8) == 0xf0 ? 4 : 0, ok = len > 0;
+        for (int i = 1; ok && i < len; i++) ok = (p[i] & 0xc0) == 0x80;
+        if (!ok) { p++; continue; }
+        if (len == 1 && (*p < 0x20 || *p == 0x7f || *p == '"' || *p == '\\')) { p++; continue; }
+        if (len == 2 && p[0] == 0xc2 && p[1] < 0xa0) { p += 2; continue; }   // C1 controls
+        if (n + (size_t)len > lim) break;
+        memcpy(out + n, p, (size_t)len); n += (size_t)len; p += len;
+    }
+    while (n && out[n - 1] == ' ') n--;
+    size_t lead = 0; while (lead < n && out[lead] == ' ') lead++;
+    memmove(out, out + lead, n - lead); n -= lead;
+    if (!n) { snprintf(out, cap, "%s", none); return; }
+    out[n] = 0;
+}
+static void rp_name_clean(char *out, size_t cap, const char *in) { rp_text_clean(out, cap, in, 32, "phone"); }   // a phone's display name: at most 32 bytes, "phone" when empty
+
+// The pairing URI a QR code carries (the phone app scans it): nxmando://pair?v=1&host=<IPv4>&port=<1-65535>&code=<code>. Returns its length, 0 when an input is not valid
+// (not a dotted IPv4 address of four numbers 0-255, the address 0.0.0.0, a port out of range, a code that rp_code_ok refuses)
+static int rp_ipv4_ok(const char *s) {
+    int parts = 0, any = 0;
+    for (const char *p = s; parts < 4; parts++) {
+        int n = 0, digits = 0;
+        while (*p >= '0' && *p <= '9') { n = n * 10 + (*p++ - '0'); if (++digits > 3) return 0; }
+        if (!digits || n > 255 || (digits > 1 && p[-digits] == '0')) return 0;
+        any |= n;
+        if (parts < 3) { if (*p != '.') return 0; p++; } else if (*p) return 0;
+    }
+    return parts == 4 && any;
+}
+static size_t rp_pair_uri(char *out, size_t cap, const char *ipv4, unsigned port, const char *code) {
+    if (!ipv4 || !code || !rp_ipv4_ok(ipv4) || port < 1 || port > 65535 || !rp_code_ok(code)) return 0;
+    int n = snprintf(out, cap, "nxmando://pair?v=%d&host=%s&port=%u&code=%s", RP_VERSION, ipv4, port, code);
+    return n > 0 && (size_t)n < cap ? (size_t)n : 0;
+}
+
+// base64 (RFC 4648, with padding) of n bytes into out; returns its length, 0 when cap is too small
+static size_t rp_base64(const unsigned char *in, size_t n, char *out, size_t cap) {
+    static const char a[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    size_t o = 0;
+    if ((n + 2) / 3 * 4 + 1 > cap) return 0;
+    for (size_t i = 0; i < n; i += 3) {
+        uint32_t v = (uint32_t)in[i] << 16 | (i + 1 < n ? (uint32_t)in[i + 1] << 8 : 0) | (i + 2 < n ? in[i + 2] : 0);
+        out[o++] = a[v >> 18 & 63]; out[o++] = a[v >> 12 & 63];
+        out[o++] = i + 1 < n ? a[v >> 6 & 63] : '=';
+        out[o++] = i + 2 < n ? a[v & 63] : '=';
+    }
+    out[o] = 0;
+    return o;
+}
+static uint32_t rp_crc32(const unsigned char *p, size_t n) {   // the zlib / PNG CRC-32
+    uint32_t c = 0xffffffffu;
+    for (size_t i = 0; i < n; i++) { c ^= p[i]; for (int k = 0; k < 8; k++) c = c >> 1 ^ (0xedb88320u & (0u - (c & 1))); }
+    return ~c;
+}
diff --git a/dm/host/remote_tick.h b/dm/host/remote_tick.h
new file mode 100644
index 0000000..8620226
--- /dev/null
+++ b/dm/host/remote_tick.h
@@ -0,0 +1,65 @@
+// Wi-Fi controllers (remote_proto.h): the timers (rp_tick), the host quitting (rp_close_all) and the phones for the front end's status (rp_players).
+#pragma once
+#include "remote_packet.h"
+
+// Timers, called at least every 20 ms: releases quiet phones, ends silent sessions, follows the window's focus, and writes what is due into out (returns how many):
+// acks, game rumble, and each streaming phone's feed (remote_feed.h)
+static int rp_tick(rp_server *s, uint64_t now, rp_reply *out, int max) {
+    int k = 0;
+    char names[DM_PLAYERS][RP_NAME + 1];
+    uint32_t names_key = rp_roster(s, names);
+    for (int i = 0; i < RP_SESSIONS; i++) {
+        rp_session *x = &s->s[i];
+        if (!x->used) continue;
+        uint64_t idle = now > x->rx_ns ? now - x->rx_ns : 0;
+        if (idle > s->timeout_ns) {
+            rp_addr a = x->addr;
+            rp_end(s, x, "timed out");
+            if (k < max) { out[k].to = a; out[k].n = rp_out(out[k].text, sizeof out[k].text, "{\"v\":1,\"t\":\"kick\",\"reason\":\"timeout\"}"); k++; }
+            continue;
+        }
+        if (idle > s->hold_ns && !x->released) { x->released = 1; rp_publish(s, x); }
+        int on = !s->h.input_on || s->h.input_on(s->h.ctx);
+        if (on == x->zeroed) rp_publish(s, x);   // focus lost: released; focus back: the phone's state again
+        if (x->acked && now - x->ack_ns >= s->ack_ns && k < max) { x->ack_ns = now; out[k].to = x->addr; out[k].n = rp_ack(x, out[k].text, sizeof out[k].text); k++; }
+        if (x->rumble && x->acked && k < max) {   // the game's rumble: on a change (at most every 33 ms), renewed every 100 ms while on, a stop sent twice
+            float ri = x->released || x->zeroed ? 0 : s->lvl_i[x->player], rs = s->lvl_s[x->player];
+            ri = roundf(ri * 100) / 100; rs = roundf(rs * 100) / 100;
+            uint64_t since = now - x->r_ns;
+            int changed = fabsf(ri - x->r_i) >= 0.02f || (ri > 0 && fabsf(rs - x->r_s) >= 0.05f) || (ri == 0) != (x->r_i == 0);
+            int due = (changed && since >= RP_RUMBLE_GAP_MS * 1000000ull) || (since >= RP_RUMBLE_KEEP_MS * 1000000ull && (ri > 0 || x->r_stop > 0));
+            if (due) {
+                if (ri > 0) x->r_stop = 0; else { if (changed) x->r_stop = 2; x->r_stop--; }
+                x->r_i = ri; x->r_s = rs; x->r_ns = now; x->r_seq++;
+                out[k].to = x->addr;
+                out[k].n = rp_out(out[k].text, sizeof out[k].text, "{\"v\":1,\"t\":\"rumble\",\"sid\":\"%s\",\"rs\":%u,\"i\":%.2f,\"s\":%.2f,\"ms\":%d}", x->sid, x->r_seq, ri, rs,
+                                  ri > 0 ? RP_RUMBLE_HOLD_MS : 0);
+                k++;
+            }
+        }
+        if (x->acked && k < max) k += rp_feed(s, x, on, now, names, names_key, out + k, max - k);
+    }
+    if (s->bad && now - s->bad_t0 > 10000000000ull) {
+        rp_say(s, "Wi-Fi: ignored %u packets in the last 10 s (last: %s)", s->bad, s->bad_why);
+        s->bad = 0; s->bad_t0 = now;
+    }
+    return k;
+}
+// The host is quitting: every phone is told and every player released
+static int rp_close_all(rp_server *s, rp_reply *out, int max) {
+    int k = 0;
+    for (int i = 0; i < RP_SESSIONS; i++) if (s->s[i].used) {
+        if (k < max) { out[k].to = s->s[i].addr; out[k].n = rp_out(out[k].text, sizeof out[k].text, "{\"v\":1,\"t\":\"bye\",\"reason\":\"host\"}"); k++; }
+        rp_end(s, &s->s[i], "disconnected (the host quits)");
+    }
+    return k;
+}
+// "Ana (2), Luis (3)": the connected phones and their players, for the front end's status
+static void rp_players(const rp_server *s, char *out, size_t cap) {
+    size_t n = 0; out[0] = 0;
+    for (int i = 0; i < RP_SESSIONS; i++) if (s->s[i].used && n < cap) {
+        int w = snprintf(out + n, cap - n, "%s%s (%d)", n ? ", " : "", s->s[i].name, s->s[i].player + 1);
+        if (w < 0) break;
+        n += (size_t)w;
+    }
+}
diff --git a/dm/host/remote_types.h b/dm/host/remote_types.h
new file mode 100644
index 0000000..851c129
--- /dev/null
+++ b/dm/host/remote_types.h
@@ -0,0 +1,95 @@
+// Wi-Fi controllers (remote_proto.h, docs/wifi-controllers.md): the constants and types every part of the protocol shares. Pure: no socket, no clock, no globals.
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+#include <math.h>
+#include "dm_input.h"
+
+enum { RP_VERSION = 1, RP_MAX_PACKET = 512, RP_PORT = 47800, RP_SESSIONS = DM_PLAYERS, RP_HZ = 60 };
+enum { RP_HOLD_MS = 500, RP_TIMEOUT_MS = 5000, RP_ACK_MS = 250 };
+enum { RP_RUMBLE_GAP_MS = 33, RP_RUMBLE_KEEP_MS = 100, RP_RUMBLE_HOLD_MS = 150 };   // at most 30 changes a second; renewed while on; each lasts this long unless renewed
+enum { RP_INFO_MS = 2000, RP_ROSTER_MS = 3000, RP_KBD_MS = 1000, RP_RACE_MS = 2000 };   // info, roster, a keyboard request and race are renewed this often (a lost one is replaced)
+enum { RP_RACE_GAP_MS = 100 };   // a race message that changed waits this long after the previous one
+enum { RP_COURSE = 24 };   // bytes: a course's name as the game files it
+enum { RP_GAME_NAME = 48, RP_NAME = 24, RP_TEXT = 128, RP_ICON_CHUNK = 300 };   // bytes: the game's name, a player's name in the roster, typed text, icon data per datagram
+enum { RP_FAIL_IPS = 16, RP_FAIL_PER_IP = 5, RP_FAIL_ALL = 30, RP_RATE = 250, RP_KICKS = 20 };   // wrong codes per minute (per address, all); packets per second per session; kicks per second
+enum { RP_ERR = -1, RP_HELLO = 1, RP_STATE, RP_BYE, RP_TEXT_IN, RP_ICON_REQ };
+enum { RP_USE_OFF, RP_USE_OWN, RP_USE_P1 };   // what the game makes of a player's controller (rp_game.use)
+
+typedef struct {
+    int type, version;
+    char code[33], id[33], name[65], sid[17], text[RP_TEXT + 1];
+    uint32_t seq, buttons, ks, off;   // ks: the keyboard request a text answers; off: the icon offset asked for
+    double ax[4];   // lx ly rx ry, -1..1, y up
+    int64_t ms; int has_ms;
+    int rumble;   // hello: the phone plays game rumble
+    int ok;       // text: 1 typed and confirmed, 0 cancelled
+} rp_msg;
+
+typedef struct { uint32_t ip; uint16_t port; } rp_addr;   // IPv4 address and port as the socket gives them (network byte order)
+// What the game makes of a player now. use: RP_USE_*; seats: the players the game takes (1-8); taken: bit p, player p + 1 has a controller; reading: the game read that
+// player's npad (for RP_USE_P1, player 1's) in the last half second
+typedef struct { int use, seats, reading; uint32_t taken; } rp_game;
+// The race a player is in (rp_hooks.race): course, the game's own name for it ("" none known); has: place, lap (1-based) and coins are known for this player;
+// kart: the game's ids of their character (drv), body, tires and glider (wing) are known; items: their two item slots are known (item, item2: the game's item id, -1 empty)
+typedef struct { int has, place, lap, coins, kart, drv, body, tire, wing, items, item, item2; char course[RP_COURSE + 1]; } rp_race;
+typedef struct {
+    int (*take)(void *ctx, const void *owner, const char *name);   // a player slot (0..DM_PLAYERS-1) for owner, -1 when none is free
+    void (*drop)(void *ctx, const void *owner);   // owner's slot is free
+    void (*set)(void *ctx, int player, uint64_t buttons, int32_t lx, int32_t ly, int32_t rx, int32_t ry);
+    int (*input_on)(void *ctx);   // 0 while the game window is not key (the front end releases its own input then too); NULL = always on
+    void (*say)(void *ctx, const char *line);   // a log line
+    void (*changed)(void *ctx);   // the players changed (the front end's status); may be NULL
+    void (*random)(void *ctx, void *buf, size_t n);
+    void *ctx;
+    void (*rumble_route)(void *ctx, int player, int on);   // a phone that plays rumble holds that player now (on) or not any more; may be NULL
+    void (*game)(void *ctx, int player, rp_game *g);   // what the game makes of a player now; NULL = no info messages
+    // who holds each player: "" nobody, "keyboard", a controller's name, or the slot name of a phone ("wifi:<id>", replaced by the phone's own name); NULL = no roster
+    void (*names)(void *ctx, char out[DM_PLAYERS][RP_NAME + 1]);
+    void (*text)(void *ctx, const char *text, int ok);   // a phone answered the game's keyboard (rp_kbd_begin); may be NULL
+    void (*race)(void *ctx, int player, rp_race *r);   // the race a player is in now; NULL = no race messages
+} rp_hooks;
+
+typedef struct {
+    int used, player, released, zeroed, acked;
+    char sid[17], id[33], name[33];
+    rp_addr addr;
+    uint32_t seq, rate_n;
+    uint64_t rx_ns, ack_ns, rate_t0, buttons;
+    int32_t ax[4];
+    int64_t ms; int has_ms;
+    int rumble, r_stop;        // plays game rumble; stop messages still to repeat
+    uint32_t r_seq;
+    float r_i, r_s;            // the level last sent
+    uint64_t r_ns;             // when
+    uint32_t i_seq, i_key;     // info: its sequence number, what the last one said (0: none sent in this session)
+    uint64_t i_ns;
+    uint32_t o_seq, o_key;     // roster: the same
+    uint64_t o_ns;
+    uint32_t k_sent; int k_done;   // keyboard: the request last sent here, "done" messages still to send
+    uint64_t k_ns;
+    uint32_t c_seq, c_key;     // race: the same
+    uint64_t c_ns;
+} rp_session;
+
+typedef struct { uint32_t ip, fails; uint64_t last_ns; } rp_fail;
+typedef struct { rp_addr to; size_t n; char text[RP_MAX_PACKET]; } rp_reply;
+typedef struct { uint32_t id; int active, max; char title[RP_GAME_NAME + 1], init[RP_TEXT + 1]; } rp_kbd;   // the game's keyboard, while it waits for text
+typedef struct { const unsigned char *data; size_t n; uint32_t crc; } rp_icon;   // the game's icon (a small JPEG), not owned
+
+typedef struct {
+    rp_session s[RP_SESSIONS];
+    rp_fail fail[RP_FAIL_IPS];
+    uint32_t all_fails, kicks, bad;
+    uint64_t all_t0, kick_t0, bad_t0, fail_logged;
+    char code[33], bad_why[64], game[RP_GAME_NAME + 1];
+    uint64_t hold_ns, timeout_ns, ack_ns;
+    float lvl_i[DM_PLAYERS], lvl_s[DM_PLAYERS];   // the game's rumble per player (rp_rumble_level)
+    rp_kbd kbd;
+    rp_icon icon;
+    rp_hooks h;
+} rp_server;
