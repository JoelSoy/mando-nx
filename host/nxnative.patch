+void dm_guest_block(uint8_t **base, size_t *size) { *base = g_as; *size = g_reserve; }   // the whole block, for DM_CTL's memory search (hle_scan.c)
+void dm_guest_heap(uint8_t **base, size_t *size) { *base = g_heap; *size = g_heap_cur; }   // the heap's open part (the Wi-Fi controllers' race data, remote_race.c)
 
