diff --git a/dm/host/tests/t_kbd_map.c b/dm/host/tests/t_kbd_map.c
new file mode 100644
index 0000000..72cbf46
--- /dev/null
+++ b/dm/host/tests/t_kbd_map.c
@@ -0,0 +1,70 @@
+// The Mac keyboard map (kbd_map.h): the built-in map is the front end's old fixed one, map files override it action by action, a key presses one action, the file round-trips,
+// held keys make buttons and sticks, and Shift / Control / Option are read from the modifier flags
+#include "../kbd_map.h"
+
+static int checks, fails, warns;
+#define CHECK(c, msg) do { checks++; if (!(c)) { fails++; fprintf(stderr, "FAIL: %s (line %d)\n", msg, __LINE__); } } while (0)
+static void warn(void *ctx, int line, const char *msg) { (void)ctx; (void)line; (void)msg; warns++; }
+static void press(const kbd_map *m, const char *keys, uint64_t *b, int32_t ax[4]) {   // "J+W": these keys held
+    kbd_keys k; memset(&k, 0, sizeof k); char buf[128]; snprintf(buf, sizeof buf, "%s", keys);
+    for (char *t = strtok(buf, "+"); t; t = strtok(NULL, "+")) { int c = kbd_key_code(t); if (c >= 0) k.down[c] = 1; }
+    kbd_compose(m, &k, b, ax);
+}
+
+int main(void) {
+    kbd_map m; uint64_t b; int32_t ax[4];
+    // the built-in map, key code by key code as front_mac.m had it
+    kbd_default(&m);
+    static const struct { int code; uint64_t bit; } old[] = {
+        {38, DM_BTN_A}, {40, DM_BTN_B}, {32, DM_BTN_X}, {34, DM_BTN_Y}, {3, DM_BTN_LS}, {5, DM_BTN_RS}, {12, DM_BTN_L}, {14, DM_BTN_R}, {6, DM_BTN_ZL}, {8, DM_BTN_ZR},
+        {36, DM_BTN_PLUS}, {48, DM_BTN_MINUS}, {123, DM_BTN_LEFT}, {126, DM_BTN_UP}, {124, DM_BTN_RIGHT}, {125, DM_BTN_DOWN}, {49, DM_BTN_SHAKE},
+    };
+    for (size_t i = 0; i < sizeof old / sizeof old[0]; i++) {
+        kbd_keys k; memset(&k, 0, sizeof k); k.down[old[i].code] = 1; kbd_compose(&m, &k, &b, ax);
+        CHECK(b == old[i].bit && !ax[0] && !ax[1], kbd_key_name(old[i].code));
+    }
+    press(&m, "W", &b, ax); CHECK(!b && ax[0] == 0 && ax[1] == DM_STICK_MAX, "W: left stick up");
+    press(&m, "A+S", &b, ax); CHECK(ax[0] == -DM_STICK_MAX && ax[1] == -DM_STICK_MAX, "A+S: down-left at full tilt on both axes, as before");
+    press(&m, "A+D", &b, ax); CHECK(ax[0] == 0, "opposite keys cancel");
+    press(&m, "J+K+W+Space", &b, ax); CHECK(b == (DM_BTN_A | DM_BTN_B | DM_BTN_SHAKE) && ax[1] == DM_STICK_MAX, "several at once");
+    press(&m, "P+F5", &b, ax); CHECK(!b && !ax[0] && !ax[1] && !ax[2] && !ax[3], "unmapped keys do nothing; the right stick has no keys");
+    CHECK(kbd_is_default(&m), "the built-in map is the default");
+    int c[4]; CHECK(kbd_keys_of(&m, kbd_action_of("A"), c, 4) == 1 && c[0] == 38, "A's key is J");
+    for (int i = 0; i < KBD_NKEYS; i++) for (int j = i + 1; j < KBD_NKEYS; j++) {
+        CHECK(KBD_KEY[i].code != KBD_KEY[j].code && strcasecmp(KBD_KEY[i].name, KBD_KEY[j].name), "key codes and names are unique");
+        if (KBD_KEY[i].code == KBD_KEY[j].code) fprintf(stderr, "  %s %s\n", KBD_KEY[i].name, KBD_KEY[j].name);
+    }
+    for (int i = 0; i < KBD_NKEYS; i++) CHECK(KBD_KEY[i].code < KBD_KEYS && KBD_KEY[i].code != 55 && KBD_KEY[i].code != 54 && KBD_KEY[i].code != 57 && KBD_KEY[i].code != 63, "no Command, Caps Lock or Fn");
+
+    // a file over the built-in map
+    warns = 0;
+    int bad = kbd_parse(&m, "# mine\nA = Space   # accelerate\nB=LeftShift,K\n\nRStickUp=O\nLStickUp=\nJump=X\nZR=Nope\nbroken line\n", warn, NULL);
+    CHECK(bad == 3 && warns == 3, "an unknown action, an unknown key and a line without = are reported");
+    press(&m, "Space", &b, ax); CHECK(b == DM_BTN_A, "Space is A now (taken from Shake)");
+    press(&m, "J", &b, ax); CHECK(b == 0, "J pressed A and no longer does: A has exactly the listed keys");
+    press(&m, "LeftShift", &b, ax); CHECK(b == DM_BTN_B, "Left Shift is B");
+    press(&m, "K", &b, ax); CHECK(b == DM_BTN_B, "and K still is");
+    press(&m, "O", &b, ax); CHECK(ax[3] == DM_STICK_MAX, "O tilts the right stick up");
+    press(&m, "W", &b, ax); CHECK(ax[1] == 0, "LStickUp= has no key");
+    press(&m, "S", &b, ax); CHECK(ax[1] == -DM_STICK_MAX, "the actions the file does not name keep their keys");
+    press(&m, "C", &b, ax); CHECK(b == DM_BTN_ZR, "a line with an unknown key changes nothing");
+    CHECK(kbd_keys_of(&m, kbd_action_of("Shake"), c, 4) == 0, "Shake lost its only key");
+    // round trip
+    char text[8192]; kbd_format(&m, text, sizeof text);
+    CHECK(strstr(text, "\nA=Space\n") && strstr(text, "\nB=K,LeftShift\n") && strstr(text, "\nShake=\n") && strstr(text, "\nLStickUp=\n"), "the file lists every action");
+    kbd_map m2; warns = 0; CHECK(kbd_parse(&m2, text, warn, NULL) == 0 && !memcmp(&m, &m2, sizeof m), "what is written reads back the same");
+    kbd_default(&m); kbd_format(&m, text, sizeof text); kbd_parse(&m2, text, warn, NULL); CHECK(kbd_is_default(&m2), "the built-in map round-trips");
+    CHECK(kbd_parse(&m2, "a=j\nlstickup=w\n", warn, NULL) == 0 && kbd_is_default(&m2), "names are not case-sensitive");
+    char small[16]; size_t n = kbd_format(&m, small, sizeof small); CHECK(n == strlen(small) && n < sizeof small, "a short buffer is cut, not overrun");
+
+    // modifier flags (NSEvent modifierFlags: device bits in the low word, Shift 1 << 17, Control 1 << 18, Option 1 << 19)
+    int down;
+    CHECK(kbd_modifier(56, (1u << 17) | 0x2, &down) && down, "left Shift held");
+    CHECK(kbd_modifier(60, (1u << 17) | 0x2, &down) && !down, "right Shift not held while only the left one is");
+    CHECK(kbd_modifier(56, 0, &down) && !down, "released");
+    CHECK(kbd_modifier(62, (1u << 18) | 0x2000, &down) && down && kbd_modifier(59, (1u << 18) | 0x2000, &down) && !down, "right Control");
+    CHECK(kbd_modifier(58, 1u << 19, &down) && down, "no device bits: the plain Option flag");
+    CHECK(!kbd_modifier(38, 0, &down), "J is not a modifier");
+    printf("t_kbd_map: %d checks, %d failed\n", checks, fails);
+    return fails != 0;
+}
diff --git a/dm/host/tests/t_remote.c b/dm/host/tests/t_remote.c
new file mode 100644
index 0000000..8878ef3
--- /dev/null
+++ b/dm/host/tests/t_remote.c
@@ -0,0 +1,150 @@
+// Wi-Fi controllers (remote_proto.h, docs/wifi-controllers.md): message parsing and validation, stick normalization, seq ordering, and the sessions over a player slot table
+// shared with physical controllers (pad_slots.h): pairing, wrong codes and their limit, players, a phone and a controller never on one player, release and timeout, rejoin,
+// focus, bye. No socket and no clock: the time is passed in (t_remote_udp.c covers the socket)
+#include "t_remote.h"
+
+static void t_parse(void) {
+    rp_msg m;
+    CHECK(parse("{\"v\":1,\"t\":\"hello\",\"code\":\"482913\",\"id\":\"abcDEF12_-\",\"name\":\"Ana\"}", &m) == RP_HELLO && !strcmp(m.code, "482913") && !strcmp(m.id, "abcDEF12_-") && !strcmp(m.name, "Ana"), "a hello");
+    CHECK(parse(" { \"t\" : \"state\" , \"v\":1,\"sid\":\"0123456789abcdef\",\"seq\":4294967295,\"b\":65535,\"lx\":-1,\"ly\":0.5,\"rx\":1e-3,\"ry\":-0.25,\"ms\":123,\"extra\":null} ", &m) == RP_STATE
+          && m.seq == 4294967295u && m.buttons == 0xffff && m.ax[0] == -1 && m.ax[1] == 0.5 && m.ax[2] == 0.001 && m.ax[3] == -0.25 && m.has_ms && m.ms == 123, "a state, any member order, unknown keys ignored");
+    CHECK(parse("{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":0,\"b\":0}", &m) == RP_STATE && m.ax[0] == 0 && !m.has_ms, "sticks and ms are optional");
+    CHECK(parse("{\"v\":1,\"t\":\"bye\",\"sid\":\"0123456789abcdef\"}", &m) == RP_BYE, "a bye");
+    CHECK(parse("{\"v\":1,\"t\":\"hello\",\"code\":\"1234\",\"id\":\"abcdefgh\",\"name\":\"Jos\\u00e9 \\ud83d\\ude00\\n\"}", &m) == RP_HELLO && !strcmp(m.name, "Jos\xc3\xa9 \xf0\x9f\x98\x80\n"), "escapes and a surrogate pair decode to UTF-8");
+    CHECK(parse("{\"v\":2,\"t\":\"hello\",\"code\":\"1234\",\"id\":\"abcdefgh\"}", &m) == RP_HELLO && m.version == 2, "another version parses (the session answers it)");
+    static const char *const bad[] = {
+        "", "[]", "{", "{\"v\":1,\"t\":\"state\"", "{\"v\":1,\"t\":\"bye\",\"sid\":\"0123456789abcdef\"} x", "{\"v\":1,\"t\":\"bye\",\"sid\":\"0123456789abcdef\",}",
+        "{\"v\":1,\"v\":1,\"t\":\"bye\",\"sid\":\"0123456789abcdef\"}",                       // a key twice
+        "{\"t\":\"bye\",\"sid\":\"0123456789abcdef\"}",                                         // no version
+        "{\"v\":1,\"t\":\"jump\"}", "{\"v\":1,\"t\":\"bye\",\"sid\":\"0123456789ABCDEF\"}", "{\"v\":1,\"t\":\"bye\",\"sid\":\"0123\"}",
+        "{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":-1,\"b\":0}", "{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":1.5,\"b\":0}",
+        "{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":4294967296,\"b\":0}", "{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":1,\"b\":65536}",
+        "{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":1}", "{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":1,\"b\":\"1\"}",
+        "{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":1,\"b\":1,\"lx\":1e999}", "{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":01,\"b\":1}",
+        "{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":1,\"b\":1,\"lx\":[1]}", "{\"v\":1,\"t\":\"state\",\"sid\":\"0123456789abcdef\",\"seq\":1,\"b\":1,\"lx\":{}}",
+        "{\"v\":1,\"t\":\"hello\",\"code\":\"1234\",\"id\":\"short\"}", "{\"v\":1,\"t\":\"hello\",\"code\":\"1234\",\"id\":\"has space!\"}", "{\"v\":1,\"t\":\"hello\",\"id\":\"abcdefgh\"}",
+        "{\"v\":1,\"t\":\"hello\",\"code\":\"1234\",\"id\":\"abcdefgh\",\"name\":\"\\ud83d\"}",        // a lone surrogate
+        "{\"v\":1,\"t\":\"hello\",\"code\":\"1234\",\"id\":\"abcdefgh\",\"name\":\"a\x01\"}",        // a raw control byte
+        "{\"v\":1,\"t\":\"hello\",\"code\":\"1234\",\"id\":\"abcdefgh\",\"name\":\"0123456789012345678901234567890123456789012345678901234567890123456789\"}",   // over 64 bytes
+        "{\"v\":true,\"t\":\"bye\",\"sid\":\"0123456789abcdef\"}",
+    };
+    for (size_t i = 0; i < sizeof bad / sizeof bad[0]; i++) { int r = parse(bad[i], &m); CHECK(r == RP_ERR, bad[i]); }
+    char big[700]; memset(big, ' ', sizeof big); memcpy(big, "{\"v\":1,\"t\":\"bye\",\"sid\":\"0123456789abcdef\"}", 41); const char *why;
+    CHECK(rp_parse(big, sizeof big, &m, &why) == RP_ERR && !strcmp(why, "too long"), "a datagram over 512 bytes");
+}
+static void t_values(void) {
+    int32_t x, y;
+    rp_stick(0, 0, &x, &y); CHECK(x == 0 && y == 0, "centred");
+    rp_stick(1, 0, &x, &y); CHECK(x == DM_STICK_MAX && y == 0, "full right");
+    rp_stick(0, -1, &x, &y); CHECK(x == 0 && y == -DM_STICK_MAX, "full down");
+    rp_stick(5, -7, &x, &y); CHECK(fabs(hypot(x, y) - DM_STICK_MAX) < 2 && x > 0 && y < 0, "out of range: clamped, then onto the circle");
+    rp_stick(1, 1, &x, &y); CHECK(abs(x - 23170) <= 1 && abs(y - 23170) <= 1, "a square corner is a full tilt on the diagonal");
+    rp_stick(0.5, 0.5, &x, &y); CHECK(x == 16384 && y == 16384, "inside the circle: unchanged");
+    CHECK(rp_seq_newer(2, 1) && !rp_seq_newer(1, 1) && !rp_seq_newer(1, 2) && rp_seq_newer(0, 0xffffffffu) && !rp_seq_newer(0xffffffffu, 0), "seq order with wrap-around");
+    CHECK(rp_code_eq("482913", "482913") && !rp_code_eq("482913", "482914") && !rp_code_eq("48291", "482913") && !rp_code_eq("", "1"), "code comparison");
+    CHECK(rp_code_ok("1234") && rp_code_ok("abcDEF123") && !rp_code_ok("123") && !rp_code_ok("12 34") && !rp_code_ok("123456789012345678901234567890123"), "code charset and length");
+    char n[33];
+    rp_name_clean(n, sizeof n, "  Ana \"\\\x01\x7f la\xff\xc3\xa9  "); CHECK(!strcmp(n, "Ana  la\xc3\xa9"), "names: controls, quotes, broken UTF-8 and outer spaces dropped");
+    rp_name_clean(n, sizeof n, ""); CHECK(!strcmp(n, "phone"), "an empty name");
+    rp_name_clean(n, sizeof n, "\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9");
+    CHECK(strlen(n) == 32 && (unsigned char)n[31] == 0xa9, "names stop at 32 bytes on a character boundary");
+}
+
+static void t_sessions(void) {
+    char sid1[17], sid2[17], sid3[17], sidx[17]; int p1, p2, p3, px; rp_reply rep[RP_SESSIONS]; uint64_t t = 1000 * MS;
+    // Mario Kart, four players: the keyboard holds player 1 (DM_KBD_PLAYER=own), a Pro Controller is player 2, phones fill 3 and 4 (DM_REMOTE_PLAYERS=4)
+    reset(4);
+    static const char kbd = 0, pro = 0;
+    CHECK(pad_slot_take(&g_slots, &kbd, "keyboard") == 0 && pad_slot_take(&g_slots, &pro, "Pro Controller") == 1, "keyboard and controller first");
+    CHECK(hello(A1, t, "000000", "phone-ana-1") && strstr(out, "\"reason\":\"code\""), "a wrong code is refused");
+    CHECK(strstr(g_last_say, "wrong pairing code from 192.168.1.10"), "and logged with the address");
+    CHECK(hello(A1, t, "482913", "phone-ana-1") && welcome(sid1, &p1) && p1 == 3, "the first phone is player 3: players 1 and 2 are held");
+    CHECK(pad_slot_mask(&g_slots) == 0x7 && g_changes == 1, "its slot is in the shared table");
+    CHECK(hello(A1, t + MS, "482913", "phone-ana-1") && welcome(sidx, &px) && !strcmp(sidx, sid1) && px == 3, "a repeated hello: the same session");
+    CHECK(hello(A2, t, "482913", "phone-luis-2") && welcome(sid2, &p2) && p2 == 4 && strcmp(sid1, sid2), "the second phone is player 4, with its own session id");
+    CHECK(hello(A3, t, "482913", "phone-eva-03") && strstr(out, "\"reason\":\"full\""), "a third phone: no player is left within four");
+    static const char pro2 = 0;
+    CHECK(pad_slot_take(&g_slots, &pro2, "Pro Controller") == 4, "a controller connecting now takes player 5, not a phone's");
+
+    CHECK(state(A1, t + 10 * MS, sid1, 1, DM_BTN_A | DM_BTN_R, 1, 0) && strstr(out, "\"t\":\"ack\"") && strstr(out, "\"player\":3") && strstr(out, "\"ms\":10"), "the first state is acked at once, with its time echoed");
+    CHECK(g_b[2] == (DM_BTN_A | DM_BTN_R) && g_ax[2][0] == DM_STICK_MAX && g_ax[2][1] == 0, "published on player 3's path");
+    CHECK(!state(A1, t + 11 * MS, sid1, 1, 0, 0, 0) && g_b[2] == (DM_BTN_A | DM_BTN_R), "a repeated seq is dropped");
+    CHECK(!state(A1, t + 12 * MS, sid1, 0, 0, 0, 0) && g_b[2] == (DM_BTN_A | DM_BTN_R), "an older seq is dropped");
+    CHECK(!state(A1, t + 13 * MS, sid1, 5, DM_BTN_B, -0.5, 0.5) && g_b[2] == DM_BTN_B && g_ax[2][0] == -16384 && g_ax[2][1] == 16384, "a newer seq (some lost) is taken");
+    CHECK(!state(A2, t + 14 * MS, sid1, 9, DM_BTN_X, 0, 0) && g_b[2] == DM_BTN_B, "a session id from another address is ignored");
+    CHECK(state(A1, t + 15 * MS, "00000000000000ff", 9, 0, 0, 0) && strstr(out, "\"t\":\"kick\""), "an unknown session is told to join again");
+    uint32_t bad0 = S.bad; CHECK(!send_s(A1, t, "{\"v\":1,\"t\":\"state\"}") && S.bad == bad0 + 1, "a malformed packet: no reply, counted");
+
+    // acks every 250 ms while the session lives
+    int k = rp_tick(&S, t + 13 * MS + 260 * MS, rep, RP_SESSIONS);
+    CHECK(k == 1 && rep[0].to.ip == A1.ip && strstr(rep[0].text, "\"seq\":5"), "a periodic ack (the second phone sent no state yet)");
+    // quiet: buttons released after 500 ms, the session kept; a new state brings them back
+    rp_tick(&S, t + 13 * MS + 520 * MS, rep, RP_SESSIONS);
+    CHECK(g_b[2] == 0 && g_ax[2][0] == 0 && pad_slot_of(&g_slots, &S.s[0]) == 2, "a quiet phone is released, its player kept");
+    state(A1, t + 600 * MS, sid1, 6, DM_BTN_A, 0, 0); CHECK(g_b[2] == DM_BTN_A, "and plays again with its next state");
+    // focus: the game window not key releases the phones, back in focus they play again
+    g_input = 0; rp_tick(&S, t + 610 * MS, rep, RP_SESSIONS); CHECK(g_b[2] == 0, "focus lost: released");
+    state(A1, t + 620 * MS, sid1, 7, DM_BTN_A, 0, 0); CHECK(g_b[2] == 0, "and stays released while out of focus");
+    g_input = 1; rp_tick(&S, t + 630 * MS, rep, RP_SESSIONS); CHECK(g_b[2] == DM_BTN_A, "focus back: the phone's state again");
+    // timeout: the session ends, the player is free, its name kept for the rejoin
+    k = rp_tick(&S, t + 630 * MS + 5001 * MS, rep, RP_SESSIONS);
+    CHECK(pad_slot_of(&g_slots, &S.s[0]) < 0 && pad_slot_of(&g_slots, &S.s[1]) < 0 && g_b[2] == 0, "silent phones lose their players");
+    CHECK(k == 2 && strstr(rep[0].text, "\"reason\":\"timeout\""), "and are told");
+    CHECK(state(A1, t + 5700 * MS, sid1, 8, DM_BTN_A, 0, 0) && strstr(out, "\"reason\":\"session\""), "a state after the timeout: join again");
+    CHECK(hello(A1, t + 5701 * MS, "482913", "phone-ana-1") && welcome(sid3, &p3) && p3 == 3 && strcmp(sid3, sid1), "the rejoin gets player 3 back, with a new session id");
+    CHECK(hello(A3, t + 5702 * MS, "482913", "phone-eva-03") && welcome(sidx, &px) && px == 4, "player 4, free again, goes to the next phone");
+    CHECK(hello(A2, t + 5703 * MS, "482913", "phone-luis-2") && strstr(out, "\"reason\":\"full\""), "and the phone that had it finds no player");
+    // the same phone from a new address (Wi-Fi reconnected, app restarted): a new session on the same player; the old address is no longer taken
+    CHECK(hello(A4, t + 5800 * MS, "482913", "phone-ana-1") && welcome(sidx, &px) && px == 3 && strcmp(sidx, sid3), "rejoin from another address: same player, new session");
+    CHECK(!state(A1, t + 5801 * MS, sidx, 1, DM_BTN_A, 0, 0) && g_b[2] == 0, "the old address cannot use it");
+    CHECK(state(A4, t + 5802 * MS, sidx, 0, DM_BTN_Y, 0, 0) && g_b[2] == DM_BTN_Y, "the new one plays, from seq 0");
+    // bye: the player is free at once
+    CHECK(send_s(A4, t + 5803 * MS, "{\"v\":1,\"t\":\"bye\",\"sid\":\"%s\"}", sidx) && strstr(out, "\"t\":\"bye\"") && g_b[2] == 0 && pad_slot_mask(&g_slots) == (0x3 | 1u << 3 | 1u << 4), "bye frees player 3");
+    // the host quits: every phone is told
+    k = rp_close_all(&S, rep, RP_SESSIONS); CHECK(k == 1 && strstr(rep[0].text, "\"reason\":\"host\"") && pad_slot_mask(&g_slots) == (0x3 | 1u << 4), "quit: bye to every phone");
+
+    // eight players at most
+    reset(DM_PLAYERS);
+    for (int i = 0; i < DM_PLAYERS; i++) { char id[16]; snprintf(id, sizeof id, "phone-%03d", i); rp_addr a = {0x0a000000u + (uint32_t)i, 5}; hello(a, t, "482913", id); CHECK(welcome(sidx, &px) && px == i + 1, "phones 1..8"); }
+    CHECK(hello((rp_addr){0x0b000000, 5}, t, "482913", "phone-ninth") && strstr(out, "\"reason\":\"full\""), "a ninth phone is refused");
+    // version
+    CHECK(send_s(A1, t, "{\"v\":2,\"t\":\"hello\",\"code\":\"482913\",\"id\":\"phone-ana-1\"}") && strstr(out, "\"reason\":\"version\""), "another protocol version is refused");
+}
+static void t_limits(void) {
+    uint64_t t = 1000 * MS; char sid[17]; int p;
+    reset(DM_PLAYERS);
+    for (int i = 0; i < RP_FAIL_PER_IP; i++) { hello(A1, t + i * MS, "111111", "phone-ana-1"); CHECK(strstr(out, "\"reason\":\"code\""), "wrong codes"); }
+    CHECK(hello(A1, t + 10 * MS, "482913", "phone-ana-1") && strstr(out, "\"reason\":\"busy\""), "after five wrong codes the address is refused, even with the right one");
+    CHECK(hello(A2, t + 11 * MS, "482913", "phone-luis-2") && welcome(sid, &p), "another address still joins");
+    CHECK(hello(A1, t + 61 * 1000 * MS, "482913", "phone-ana-1") && welcome(sid, &p), "a minute later it may try again");
+    reset(DM_PLAYERS);
+    for (int i = 0; i < RP_FAIL_ALL; i++) { rp_addr a = {0x0a000000u + (uint32_t)i, 7}; hello(a, t, "111111", "phone-ana-1"); }
+    CHECK(hello(A3, t + MS, "482913", "phone-eva-03") && strstr(out, "\"reason\":\"busy\""), "thirty wrong codes from anywhere: every hello waits");
+    // a phone flooding packets
+    reset(DM_PLAYERS);
+    hello(A1, t, "482913", "phone-ana-1"); welcome(sid, &p);
+    int taken = 0;
+    for (uint32_t i = 1; i <= 400; i++) { int before = g_sets[0]; state(A1, t + i * 1000, sid, i, i & 1, 0, 0); taken += g_sets[0] != before; }
+    CHECK(taken == RP_RATE, "at most 250 states a second are taken from one phone");
+    // kicks are limited too
+    int kicks = 0; for (int i = 0; i < 100; i++) kicks += state(A2, t + 10 * MS, "00000000000000ff", 1, 0, 0, 0) > 0;
+    CHECK(kicks == RP_KICKS, "at most 20 kicks a second");
+}
+static void t_pair_rumble(void) {
+    char uri[256],sid[17];int p;rp_reply rep[RP_SESSIONS];
+    CHECK(rp_pair_uri(uri,sizeof uri,"192.168.1.10",47800,"123456") && strstr(uri,"nxmando://pair?v=1"),"QR pairing URI");
+    CHECK(!rp_pair_uri(uri,sizeof uri,"0.0.0.0",47800,"123456") && !rp_pair_uri(uri,sizeof uri,"1.2.3.4",99999,"123456"),"QR refuses invalid host/port");
+    reset(4);uint64_t t=1000*MS;
+    send_s(A1,t,"{\"v\":1,\"t\":\"hello\",\"code\":\"482913\",\"id\":\"rumblephone1\",\"rumble\":1}");
+    CHECK(welcome(sid,&p),"rumble phone joins");
+    state(A1,t+MS,sid,1,DM_BTN_A,0,0);rp_rumble_level(&S,p-1,.8,.3);
+    int k=rp_tick(&S,t+40*MS,rep,RP_SESSIONS);int found=0;for(int i=0;i<k;i++)found|=strstr(rep[i].text,"\"t\":\"rumble\"")!=NULL;
+    CHECK(found,"game rumble returned only to opted in session");
+    rp_rumble_level(&S,p-1,NAN,INFINITY);CHECK(S.lvl_i[p-1]==0 && S.lvl_s[p-1]==0,"invalid rumble neutralized");
+    reset(4);hello(A1,t,"482913","legacyphone1");welcome(sid,&p);state(A1,t+MS,sid,1,DM_BTN_A,0,0);rp_rumble_level(&S,p-1,1,1);k=rp_tick(&S,t+40*MS,rep,RP_SESSIONS);found=0;for(int i=0;i<k;i++)found|=strstr(rep[i].text,"rumble")!=NULL;CHECK(!found,"legacy phone receives no rumble");
+}
+int main(void) {
+    t_parse(); t_values(); t_sessions(); t_limits(); t_pair_rumble();
+    printf("t_remote: %d checks, %d failed\n", checks, fails);
+    return fails != 0;
+}
diff --git a/dm/host/tests/t_remote.h b/dm/host/tests/t_remote.h
new file mode 100644
index 0000000..3dab1dc
--- /dev/null
+++ b/dm/host/tests/t_remote.h
@@ -0,0 +1,44 @@
+// Wi-Fi controllers' tests (t_remote.c, t_remote_feed.c): the shared harness. A player slot table with fake hooks, one server S, and helpers that send a phone's
+// datagrams at a given time and read the replies. No socket and no clock (t_remote_udp.c covers the socket)
+#pragma once
+#include "../remote_proto.h"
+#include "../pad_slots.h"
+
+static int checks, fails;
+#define CHECK(c, msg) do { checks++; if (!(c)) { fails++; fprintf(stderr, "FAIL: %s (line %d)\n", msg, __LINE__); } } while (0)
+#define MS 1000000ull
+
+static pad_slots g_slots; static int g_limit = DM_PLAYERS, g_input = 1, g_changes;
+static uint64_t g_b[DM_PLAYERS]; static int32_t g_ax[DM_PLAYERS][4]; static int g_sets[DM_PLAYERS];
+static char g_last_say[256]; static unsigned g_rand;
+static int f_take(void *ctx, const void *o, const char *name) { (void)ctx; return pad_slot_take_in(&g_slots, o, name, g_limit); }
+static void f_drop(void *ctx, const void *o) { (void)ctx; pad_slot_free(&g_slots, o); }
+static void f_set(void *ctx, int p, uint64_t b, int32_t lx, int32_t ly, int32_t rx, int32_t ry) { (void)ctx; g_b[p] = b; g_ax[p][0] = lx; g_ax[p][1] = ly; g_ax[p][2] = rx; g_ax[p][3] = ry; g_sets[p]++; }
+static int f_input(void *ctx) { (void)ctx; return g_input; }
+static void f_say(void *ctx, const char *l) { (void)ctx; snprintf(g_last_say, sizeof g_last_say, "%s", l); }
+static void f_changed(void *ctx) { (void)ctx; g_changes++; }
+static void f_random(void *ctx, void *buf, size_t n) { (void)ctx; for (size_t i = 0; i < n; i++) ((unsigned char *)buf)[i] = (unsigned char)(++g_rand * 37u); }
+static const rp_hooks HOOKS = {.take = f_take, .drop = f_drop, .set = f_set, .input_on = f_input, .say = f_say, .changed = f_changed, .random = f_random};
+static int parse(const char *s, rp_msg *m) { const char *why; return rp_parse(s, strlen(s), m, &why); }
+
+static rp_server S; static char out[RP_MAX_PACKET];
+static rp_addr A1 = {0x0a01a8c0, 1000}, A2 = {0x0b01a8c0, 2000}, A3 = {0x0c01a8c0, 3000}, A4 = {0x0d01a8c0, 4000};
+static size_t send_s(rp_addr a, uint64_t now, const char *fmt, ...) {
+    char msg[600]; va_list ap; va_start(ap, fmt); vsnprintf(msg, sizeof msg, fmt, ap); va_end(ap);
+    out[0] = 0; return rp_packet(&S, msg, strlen(msg), a, now, out, sizeof out);
+}
+static size_t hello(rp_addr a, uint64_t now, const char *code, const char *id) { return send_s(a, now, "{\"v\":1,\"t\":\"hello\",\"code\":\"%s\",\"id\":\"%s\",\"name\":\"%s\"}", code, id, id); }
+static int welcome(char sid[17], int *player) {   // out is a welcome: its sid and player
+    const char *p = strstr(out, "\"sid\":\""), *q = strstr(out, "\"player\":");
+    if (!strstr(out, "\"t\":\"welcome\"") || !p || !q) return 0;
+    memcpy(sid, p + 7, 16); sid[16] = 0; *player = atoi(q + 9);
+    return 1;
+}
+static size_t state(rp_addr a, uint64_t now, const char *sid, uint32_t seq, unsigned b, double lx, double ly) {
+    return send_s(a, now, "{\"v\":1,\"t\":\"state\",\"sid\":\"%s\",\"seq\":%u,\"b\":%u,\"lx\":%g,\"ly\":%g,\"ms\":%u}", sid, seq, b, lx, ly, seq * 10);
+}
+static void reset(int limit) {
+    memset(&g_slots, 0, sizeof g_slots); memset(g_b, 0, sizeof g_b); memset(g_ax, 0, sizeof g_ax); memset(g_sets, 0, sizeof g_sets);
+    g_limit = limit; g_input = 1; g_changes = 0;
+    rp_init(&S, "482913", RP_TIMEOUT_MS, &HOOKS);
+}
diff --git a/dm/host/tests/t_remote_feed.c b/dm/host/tests/t_remote_feed.c
new file mode 100644
index 0000000..86e1b82
--- /dev/null
+++ b/dm/host/tests/t_remote_feed.c
@@ -0,0 +1,142 @@
+// Wi-Fi controllers (remote_feed.h): what each streaming phone is told about the game. info (on a change and every RP_INFO_MS, with reading and the icon's size and CRC),
+// roster (who holds each player, phones by their names), the game's keyboard (asked until one phone answers, then "done" to every asked phone), pieces of the icon,
+// race (the course, and place, lap, coins, character and kart, items when known: on a change at most every RP_RACE_GAP_MS, and every RP_RACE_MS)
+#include "t_remote.h"
+
+static rp_game g_game = {.use = RP_USE_OWN, .seats = 4, .taken = 0x7};
+static char g_names[DM_PLAYERS][RP_NAME + 1], g_text[RP_TEXT + 1]; static int g_text_ok = -1, g_texts;
+static void f_game(void *ctx, int p, rp_game *g) { (void)ctx; (void)p; *g = g_game; }
+static void f_names(void *ctx, char o[DM_PLAYERS][RP_NAME + 1]) { (void)ctx; memcpy(o, g_names, sizeof g_names); }
+static void f_text(void *ctx, const char *t, int ok) { (void)ctx; snprintf(g_text, sizeof g_text, "%s", t); g_text_ok = ok; g_texts++; }
+static rp_reply rep[RP_SESSIONS * 6]; static int nrep;
+static int tick(uint64_t now) { return nrep = rp_tick(&S, now, rep, RP_SESSIONS * 6); }
+static rp_race g_race; static void f_race(void *ctx, int p, rp_race *r) { (void)ctx; (void)p; *r = g_race; }
+static const char *find(const char *type, int nth) {   // the nth reply of that type in the last tick
+    char want[32]; snprintf(want, sizeof want, "\"t\":\"%s\"", type);
+    for (int i = 0; i < nrep; i++) if (strstr(rep[i].text, want) && !nth--) return rep[i].text;
+    return NULL;
+}
+static void start(void) {   // a server with every feed hook, one streaming phone (player 1) at 1 s
+    reset(4); S.h.game = f_game; S.h.names = f_names; S.h.text = f_text;
+    memset(g_names, 0, sizeof g_names); g_game = (rp_game){.use = RP_USE_OWN, .seats = 4, .taken = 0x7}; g_texts = 0; g_text_ok = -1;
+}
+
+static void t_info(void) {
+    char sid[17], sid2[17]; int p; uint64_t t = 1000 * MS;
+    start(); rp_set_game(&S, "Mario Kart 8 \"Deluxe\"\x01");
+    CHECK(!strcmp(S.game, "Mario Kart 8 Deluxe"), "the game's name is cleaned for JSON");
+    hello(A1, t, "482913", "phone-ana-1"); welcome(sid, &p);
+    tick(t + MS); CHECK(!find("info", 0), "no info before the phone streams");
+    state(A1, t + 2 * MS, sid, 1, 0, 0, 0); tick(t + 3 * MS);
+    const char *i = find("info", 0);
+    CHECK(i && strstr(i, sid) && strstr(i, "\"is\":1,") && strstr(i, "\"player\":1,") && strstr(i, "\"game\":\"Mario Kart 8 Deluxe\"") && strstr(i, "\"use\":\"own\"")
+          && strstr(i, "\"seats\":4") && strstr(i, "\"taken\":7,") && strstr(i, "\"rd\":0") && strstr(i, "\"isz\":0}"), i ? i : "no info");
+    tick(t + 5 * MS); CHECK(!find("info", 0), "unchanged: not sent again at once");
+    g_game.use = RP_USE_P1; g_game.seats = 1; tick(t + 6 * MS); i = find("info", 0);
+    CHECK(i && strstr(i, "\"is\":2,") && strstr(i, "\"use\":\"p1\"") && strstr(i, "\"seats\":1"), "a one-player game: the phone feeds player 1");
+    g_game = (rp_game){.use = RP_USE_OFF, .seats = 99, .taken = 0xffff}; tick(t + 7 * MS); i = find("info", 0);
+    CHECK(i && strstr(i, "\"use\":\"off\"") && strstr(i, "\"seats\":8") && strstr(i, "\"taken\":255,"), "not used; seats and players clamped");
+    g_game.reading = 1; tick(t + 8 * MS); i = find("info", 0); CHECK(i && strstr(i, "\"rd\":1"), "the game reads the phone's npad: a change");
+    g_input = 0; tick(t + 9 * MS); i = find("info", 0); CHECK(i && strstr(i, "\"use\":\"pause\"") && strstr(i, "\"rd\":0"), "the game window not key: paused, not read");
+    g_input = 1; state(A1, t + 100 * MS, sid, 3, 0, 0, 0); tick(t + 101 * MS);
+    state(A1, t + 1500 * MS, sid, 4, 0, 0, 0); tick(t + 1501 * MS); CHECK(!find("info", 0), "nothing new within 2 s");
+    state(A1, t + 2200 * MS, sid, 5, 0, 0, 0); tick(t + 2201 * MS); CHECK(find("info", 0) != NULL, "renewed after 2 s");
+    hello(A2, t + 2300 * MS, "482913", "phone-ana-1"); welcome(sid2, &p);   // the same phone from another address: a new session id, its feed again once it streams
+    state(A2, t + 2301 * MS, sid2, 0, 0, 0, 0); tick(t + 2302 * MS); i = find("info", 0);
+    CHECK(i && strstr(i, sid2), "a new session gets its info at once");
+    reset(4); hello(A1, t, "482913", "phone-ana-1"); welcome(sid, &p); state(A1, t + MS, sid, 1, 0, 0, 0); tick(t + 2 * MS);
+    CHECK(!find("info", 0) && !find("roster", 0), "no feed without the hooks");
+}
+
+static void t_roster(void) {
+    char sid[17], sid2[17]; int p; uint64_t t = 1000 * MS;
+    start();
+    static const char kbd = 0; pad_slot_take(&g_slots, &kbd, "keyboard");
+    snprintf(g_names[0], sizeof g_names[0], "keyboard");
+    send_s(A1, t, "{\"v\":1,\"t\":\"hello\",\"code\":\"482913\",\"id\":\"phone-ana-1\",\"name\":\"Ana\"}"); welcome(sid, &p);
+    snprintf(g_names[1], sizeof g_names[1], "wifi:phone-ana-1");
+    snprintf(g_names[3], sizeof g_names[3], "Pro \"Controller\"");
+    state(A1, t + MS, sid, 1, 0, 0, 0); tick(t + 2 * MS);
+    const char *r = find("roster", 0);
+    CHECK(r && strstr(r, "\"rs\":1") && strstr(r, "\"n1\":\"keyboard\"") && strstr(r, "\"n2\":\"Ana\"") && strstr(r, "\"n4\":\"Pro Controller\"") && !strstr(r, "\"n3\""),
+          r ? r : "no roster");
+    tick(t + 3 * MS); CHECK(!find("roster", 0), "unchanged: not again at once");
+    send_s(A2, t + 4 * MS, "{\"v\":1,\"t\":\"hello\",\"code\":\"482913\",\"id\":\"phone-luis-2\",\"name\":\"Luis\"}"); welcome(sid2, &p);
+    snprintf(g_names[2], sizeof g_names[2], "wifi:phone-luis-2");
+    state(A2, t + 5 * MS, sid2, 1, 0, 0, 0); tick(t + 6 * MS);
+    CHECK(find("roster", 0) && find("roster", 1) && strstr(find("roster", 0), "\"n3\":\"Luis\""), "a new player: both phones get the new roster");
+    state(A1, t + 3100 * MS, sid, 2, 0, 0, 0); state(A2, t + 3100 * MS, sid2, 2, 0, 0, 0); tick(t + 3101 * MS);
+    CHECK(find("roster", 0) && strstr(find("roster", 0), "\"rs\":3"), "renewed after 3 s (the first phone has had two)");
+}
+
+static void t_keyboard(void) {
+    char sid[17], sid2[17]; int p; uint64_t t = 1000 * MS;
+    start();
+    hello(A1, t, "482913", "phone-ana-1"); welcome(sid, &p); state(A1, t + MS, sid, 1, 0, 0, 0);
+    hello(A2, t, "482913", "phone-luis-2"); welcome(sid2, &p); state(A2, t + MS, sid2, 1, 0, 0, 0);
+    tick(t + 2 * MS); CHECK(!find("kbd", 0), "no keyboard request before the game asks");
+    rp_kbd_begin(&S, "Nombre \"del\" piloto", "Joel", 10); tick(t + 3 * MS);
+    const char *k = find("kbd", 0);
+    CHECK(k && find("kbd", 1) && strstr(k, "\"ks\":1") && strstr(k, "\"max\":10") && strstr(k, "\"title\":\"Nombre del piloto\"") && strstr(k, "\"init\":\"Joel\""), k ? k : "no kbd");
+    tick(t + 4 * MS); CHECK(!find("kbd", 0), "asked once, then again only every second");
+    state(A1, t + 1100 * MS, sid, 2, 0, 0, 0); state(A2, t + 1100 * MS, sid2, 2, 0, 0, 0); tick(t + 1101 * MS); CHECK(find("kbd", 1) != NULL, "asked again");
+    CHECK(send_s(A1, t + 1200 * MS, "{\"v\":1,\"t\":\"text\",\"sid\":\"%s\",\"ks\":7,\"text\":\"x\",\"ok\":1}", sid) && strstr(out, "\"done\":1") && !g_texts,
+          "an answer to an old request is not taken, but its dialog is closed");
+    CHECK(send_s(A1, t + 1201 * MS, "{\"v\":1,\"t\":\"text\",\"sid\":\"%s\",\"ks\":1,\"text\":\"Mar\\u00eda \\\"M\\\"\",\"ok\":1}", sid) && strstr(out, "\"done\":1"), "the answer");
+    CHECK(g_texts == 1 && g_text_ok == 1 && !strcmp(g_text, "Mar\xc3\xad" "a M"), g_text);
+    CHECK(!S.kbd.active && strstr(g_last_say, "typed the text"), "the request ended");
+    tick(t + 1400 * MS); CHECK(find("kbd", 0) && find("kbd", 1) && strstr(find("kbd", 0), "\"done\":1"), "every phone that was asked is told it is done");
+    tick(t + 1600 * MS); CHECK(find("kbd", 0) && !find("kbd", 1), "the other one twice");
+    tick(t + 1800 * MS); CHECK(!find("kbd", 0), "and then nothing");
+    rp_kbd_begin(&S, "", "", 0); tick(t + 1900 * MS);
+    send_s(A2, t + 1901 * MS, "{\"v\":1,\"t\":\"text\",\"sid\":\"%s\",\"ks\":2,\"text\":\"\",\"ok\":0}", sid2);
+    CHECK(g_texts == 2 && g_text_ok == 0, "a cancel is an answer too");
+    rp_kbd_begin(&S, "x", "", 5); tick(t + 2000 * MS); rp_kbd_end(&S); tick(t + 2200 * MS);
+    CHECK(find("kbd", 0) && strstr(find("kbd", 0), "\"ks\":3,\"done\":1"), "the box closed on the Mac: the phones are told");
+}
+
+static void t_icon(void) {
+    char sid[17], b64[512]; int p; uint64_t t = 1000 * MS; static unsigned char icon[700];
+    for (size_t i = 0; i < sizeof icon; i++) icon[i] = (unsigned char)(i * 7 + 3);
+    CHECK(rp_base64((const unsigned char *)"Man", 3, b64, sizeof b64) == 4 && !strcmp(b64, "TWFu") && rp_base64((const unsigned char *)"Ma", 2, b64, sizeof b64) == 4
+          && !strcmp(b64, "TWE="), "base64");
+    CHECK(rp_crc32((const unsigned char *)"123456789", 9) == 0xcbf43926u, "CRC-32 check value");
+    start(); rp_set_icon(&S, icon, sizeof icon);
+    hello(A1, t, "482913", "phone-ana-1"); welcome(sid, &p); state(A1, t + MS, sid, 1, 0, 0, 0); tick(t + 2 * MS);
+    char ih[32]; snprintf(ih, sizeof ih, "\"ih\":\"%08x\",\"isz\":700}", S.icon.crc);
+    CHECK(find("info", 0) && strstr(find("info", 0), ih), "info carries the icon's CRC and size");
+    CHECK(send_s(A1, t + 3 * MS, "{\"v\":1,\"t\":\"icon\",\"sid\":\"%s\",\"off\":0}", sid) && strstr(out, "\"t\":\"iconpart\"") && strstr(out, "\"off\":0,") && strlen(out) < RP_MAX_PACKET,
+          "the first piece");
+    rp_base64(icon, RP_ICON_CHUNK, b64, sizeof b64); CHECK(strstr(out, b64) != NULL, "its bytes");
+    CHECK(send_s(A1, t + 4 * MS, "{\"v\":1,\"t\":\"icon\",\"sid\":\"%s\",\"off\":600}", sid) && (rp_base64(icon + 600, 100, b64, sizeof b64), strstr(out, b64)), "the last, shorter piece");
+    CHECK(!send_s(A1, t + 5 * MS, "{\"v\":1,\"t\":\"icon\",\"sid\":\"%s\",\"off\":700}", sid), "nothing past the end");
+    CHECK(!send_s(A2, t + 6 * MS, "{\"v\":1,\"t\":\"icon\",\"sid\":\"%s\",\"off\":0}", sid), "nothing to another address");
+    rp_msg m; CHECK(parse("{\"v\":1,\"t\":\"icon\",\"sid\":\"0123456789abcdef\"}", &m) == RP_ERR && parse("{\"v\":1,\"t\":\"text\",\"sid\":\"0123456789abcdef\",\"ks\":1}", &m) == RP_ERR,
+          "icon needs off, text needs ok");
+}
+
+static void t_race(void) {
+    char sid[17]; int p; uint64_t t = 1000 * MS;
+    start(); hello(A1, t, "482913", "phone-ana-1"); welcome(sid, &p); state(A1, t + MS, sid, 1, 0, 0, 0);
+    tick(t + 2 * MS); CHECK(!find("race", 0), "no race hook: no race messages");
+    S.h.race = f_race; memset(&g_race, 0, sizeof g_race); tick(t + 3 * MS); const char *r = find("race", 0);
+    CHECK(r && strstr(r, "\"cs\":1,\"crs\":\"\"}"), r ? r : "no race: the first says no course");
+    snprintf(g_race.course, sizeof g_race.course, "Gu_Water\"Park"); tick(t + 50 * MS); CHECK(!find("race", 0), "a change waits RP_RACE_GAP_MS");
+    tick(t + 103 * MS); r = find("race", 0); CHECK(r && strstr(r, "\"cs\":2,\"crs\":\"Gu_WaterPark\"}"), r ? r : "no race: the course, cleaned for JSON");
+    g_race.has = 1; g_race.place = 3; g_race.lap = 2; g_race.coins = 7; tick(t + 203 * MS); r = find("race", 0);
+    CHECK(r && strstr(r, "\"cs\":3,\"crs\":\"Gu_WaterPark\",\"pos\":3,\"lap\":2,\"coin\":7}"), r ? r : "no race: place, lap and coins");
+    tick(t + 1500 * MS); CHECK(!find("race", 0), "unchanged: nothing new within 2 s");
+    state(A1, t + 2100 * MS, sid, 2, 0, 0, 0); tick(t + 2204 * MS); r = find("race", 0); CHECK(r && strstr(r, "\"cs\":4,"), "renewed after 2 s");
+    g_race.kart = 1; g_race.drv = 40; g_race.body = 15; g_race.tire = 20; g_race.wing = 0; g_race.items = 1; g_race.item = 3; g_race.item2 = -1;
+    tick(t + 2400 * MS); r = find("race", 0);
+    CHECK(r && strstr(r, "\"coin\":7,\"drv\":40,\"body\":15,\"tire\":20,\"wing\":0,\"itm\":3,\"itm2\":-1}"), r ? r : "no race: character, kart and items");
+    rp_session x; memset(&x, 0, sizeof x); snprintf(x.sid, sizeof x.sid, "0123456789abcdef"); x.c_seq = 4294967295u;
+    rp_race w = {1, 12, 99, 999, 1, 63, 63, 63, 63, 1, 63, 63, ""}; memset(w.course, 'A', RP_COURSE); rp_reply rep;
+    size_t n = rp_race_msg(&x, &w, rep.text, sizeof rep.text); CHECK(n && n <= 200 && rep.text[n - 1] == '}', "the longest race message stays within 200 bytes");
+}
+
+int main(void) {
+    t_info(); t_roster(); t_keyboard(); t_icon(); t_race();
+    printf("t_remote_feed: %d checks, %d failed\n", checks, fails);
+    return fails != 0;
+}
diff --git a/dm/host/tests/t_remote_race.c b/dm/host/tests/t_remote_race.c
new file mode 100644
index 0000000..c72781b
--- /dev/null
+++ b/dm/host/tests/t_remote_race.c
@@ -0,0 +1,77 @@
+// The phones' race data (remote_race.c) on a fake heap laid out as Mario Kart 8 Deluxe 4.0.1's: the course follows the files the game opens (a course folder starts a race,
+// the menus' backdrop ends it, other files change nothing), the racers' owner and the kart models are found by their vtables, a player reads their own racer's place, lap
+// and coins (1-based) and their kart, player 1 the items of the item box the game makes later (none with two boxes), and anything that does not check out (an unknown
+// build, a player past the racers, an index or vtable that is wrong, values out of range) gives no data.
+#include <time.h>
+#include "../remote_race.c"
+
+static int checks, fails;
+#define CHECK(c, msg) do { checks++; if (!(c)) { fails++; fprintf(stderr, "FAIL: %s (line %d)\n", msg, __LINE__); } } while (0)
+module_t g_mod[MAX_MOD]; int g_nmod;
+void (*dm_fs_opened)(const char *path);
+static uint64_t g_heap[0x2000];   // 64 KB of fake guest heap
+void dm_guest_heap(uint8_t **base, size_t *size) { *base = (uint8_t *)g_heap; *size = sizeof g_heap; }
+int dm_guest_heap_readable(uint64_t a, size_t n) { uint64_t b = (uint64_t)(uintptr_t)g_heap; return a >= b && n <= sizeof g_heap && a - b <= sizeof g_heap - n; }
+
+enum { MAIN = 0x100000000ull, OWNER = 0x100, LIST = 0x200, RACERS = 0x400, STEP = 0x20, KARTS = 0x800, HUD = 0x1000 };   // word indexes into g_heap; a racer every 0x100 bytes
+enum { MSTEP = 0x10 };   // a kart model every 0x80 bytes
+static uint64_t at(int w) { return (uint64_t)(uintptr_t)&g_heap[w]; }
+static void put32(int w, uint32_t off, int32_t v) { memcpy((uint8_t *)&g_heap[w] + off, &v, 4); }
+static void build(int n) {
+    memset(g_heap, 0, sizeof g_heap);
+    g_heap[OWNER] = MAIN + 0x125ada8; put32(OWNER, 0x60, n); g_heap[OWNER + 0x68 / 8] = at(LIST);
+    for (int i = 0; i < n; i++) {
+        int r = RACERS + i * STEP; g_heap[LIST + i] = at(r); g_heap[r] = MAIN + 0x12cac28;
+        put32(r, 0x38, i); put32(r, 0x40, (i + 3) % n); put32(r, 0x44, 1); put32(r, 0x50, i);
+        int m = KARTS + i * MSTEP; g_heap[m] = MAIN + 0x125a288; put32(m, 0x8, 40 + i); put32(m, 0x14, 10 + i); put32(m, 0x18, i % 3); put32(m, 0x20, 20 - i);
+    }
+}
+static void hud(int w, int st1, int it1, int st2, int it2) { g_heap[w] = MAIN + 0x127e110; put32(w, 0x200, st1); put32(w, 0x210, it1); put32(w, 0x204, st2); put32(w, 0x214, it2); }
+static rp_race race_of(int p) { rp_race r; memset(&r, 0, sizeof r); rm_race_read(p, &r); return r; }
+static rp_race wait_for(int p, int items) {   // has (and items) once the search found them, within 3 s
+    rp_race r = race_of(p);
+    for (int i = 0; i < 300 && !(r.has && (!items || r.items)); i++) { struct timespec t = {0, 10000000}; nanosleep(&t, NULL); r = race_of(p); }
+    return r;
+}
+#define wait_has(p) wait_for(p, 0)
+
+int main(void) {
+    g_nmod = 1; snprintf(g_mod[0].name, sizeof g_mod[0].name, "main"); g_mod[0].base = (uint8_t *)(uintptr_t)MAIN;
+    snprintf(g_mod[0].build_id, sizeof g_mod[0].build_id, "0123456789abcdef0123456789abcdef");
+    rm_race_start(); CHECK(!dm_fs_opened && !race_of(0).course[0], "another build: no race data");
+    snprintf(g_mod[0].build_id, sizeof g_mod[0].build_id, "2452C49BC26EC15904C507A34B6F16AE");
+    rm_race_start(); CHECK(dm_fs_opened != NULL, "Mario Kart 8 Deluxe 4.0.1 (any case of the build ID): the host follows the files it opens");
+    build(12);
+    rp_race r = race_of(0); CHECK(!r.course[0] && !r.has, "before a course: nothing");
+    dm_fs_opened("content:/Audio/Driver/Driver_Yoshi.bars"); CHECK(!race_of(0).course[0], "another file changes nothing");
+    dm_fs_opened("content:/Course/Gu_WaterPark/course_model.szs");
+    r = wait_has(0);
+    CHECK(!strcmp(r.course, "Gu_WaterPark") && r.has && r.place == 4 && r.lap == 2 && r.coins == 0, "a course: player 1 is racer 0 (4th, lap 2, no coins)");
+    CHECK(r.kart && r.drv == 40 && r.body == 10 && r.wing == 0 && r.tire == 20 && !r.items, "player 1's kart is model 0; no item box yet: no items");
+    r = race_of(3); CHECK(r.has && r.place == 7 && r.coins == 3, "player 4 reads racer 3");
+    CHECK(r.kart && r.drv == 43 && r.body == 13 && r.wing == 0 && r.tire == 17, "and model 3");
+    hud(HUD, 3, 15, 0, 2); r = wait_for(0, 1); CHECK(r.items && r.item == 15 && r.item2 == -1, "the item box, made later: a coin held, the other slot empty");
+    CHECK(!race_of(1).items, "items for player 1 only");
+    put32(HUD, 0x200, 2); r = race_of(0); CHECK(r.items && r.item == -1, "the roulette still turning: empty");
+    put32(HUD, 0x200, 3); put32(HUD, 0x210, 99); CHECK(!race_of(0).items, "an item id out of range: no items");
+    put32(HUD, 0x210, 0); r = race_of(0); CHECK(r.items && r.item == 0, "a banana is item 0");
+    g_heap[KARTS + 2 * MSTEP] = MAIN + 8; CHECK(!race_of(2).kart && race_of(2).has, "a model with another vtable: no kart, the place stays");
+    g_heap[KARTS + 2 * MSTEP] = MAIN + 0x125a288; put32(KARTS + 2 * MSTEP, 0x14, 64); CHECK(!race_of(2).kart, "a part id out of range: no kart");
+    dm_fs_opened("content:/Course/Gu_WaterPark/course_kcl.szs"); CHECK(race_of(0).has, "more files of the same course keep the race");
+    r = race_of(12); CHECK(!strcmp(r.course, "Gu_WaterPark") && !r.has, "a player past the racers has the course only");
+    put32(RACERS + 2 * STEP, 0x38, 7); CHECK(!race_of(2).has, "a racer with another index: no data");
+    put32(RACERS + 2 * STEP, 0x38, 2); g_heap[RACERS + 2 * STEP] = MAIN + 8; CHECK(!race_of(2).has, "a racer with another vtable: no data");
+    g_heap[RACERS + 2 * STEP] = MAIN + 0x12cac28; put32(RACERS + 2 * STEP, 0x50, 5000); CHECK(!race_of(2).has, "coins out of range: no data");
+    put32(RACERS + 2 * STEP, 0x50, 2); CHECK(race_of(2).has, "and back");
+    put32(OWNER, 0x60, 40); CHECK(!race_of(0).has, "an owner with too many racers: no data");
+    put32(OWNER, 0x60, 12);
+    dm_fs_opened("content:/Course/Gu_Menu/course_model.szs"); r = race_of(0); CHECK(!r.course[0] && !r.has && !r.kart && !r.items, "the menus' course ends the race");
+    build(8); g_heap[OWNER] = 0; g_heap[OWNER + 0x400] = MAIN + 0x125ada8;   // the next race: the owner moved
+    put32(OWNER + 0x400, 0x60, 8); g_heap[OWNER + 0x400 + 0x68 / 8] = at(LIST); hud(HUD, 3, 1, 3, 2); hud(HUD + 0x100, 3, 4, 0, -1);
+    dm_fs_opened("content:/Course/Cnsw_11/course_model.szs");
+    r = wait_has(7); CHECK(!strcmp(r.course, "Cnsw_11") && r.has && r.place == 3 && r.kart && r.drv == 47, "the next course finds the owner again, eight racers and models");
+    CHECK(!race_of(0).items, "two item boxes (split screen): no items");
+    dm_fs_opened("content:/Course/" "A_folder_name_far_too_long_for_a_course/x"); CHECK(!strcmp(race_of(0).course, "Cnsw_11"), "a name too long is ignored");
+    printf("t_remote_race: %d checks, %d failed\n", checks, fails);
+    return fails != 0;
+}
diff --git a/dm/host/tests/t_remote_udp.c b/dm/host/tests/t_remote_udp.c
new file mode 100644
index 0000000..94317be
--- /dev/null
+++ b/dm/host/tests/t_remote_udp.c
@@ -0,0 +1,180 @@
+// Wi-Fi controllers end to end on loopback: remote_mac.c's real socket and thread, the player slots shared with the keyboard (pad_slots.h) and what hle_hid.c reports on each
+// npad. Three fake phones join Mario Kart's four players beside the keyboard (DM_KBD_PLAYER=own), a fourth is refused, a wrong code is refused, presses reach their own npads,
+// an older seq is dropped, a silent phone is released and then loses its player, the rejoin gets it back, bye and the host's quit are sent; the game's feed (info with the game
+// reading the npad and the icon made from a PNG, the roster, a piece of the icon, the race, the game's keyboard answered by a phone). The host's log lines go to stderr.
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <poll.h>
+#include <stdarg.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+#include "../hle_hid.c"
+#include "../remote_mac.h"
+#include "../remote_types.h"
+#include <ImageIO/ImageIO.h>
+#include <CoreGraphics/CoreGraphics.h>
+
+void dm_haptics_apple_external(int p, void (*sink)(dm_haptic_state)) {(void)p;(void)sink;}
+static int checks, fails;
+#define CHECK(c, msg) do { checks++; if (!(c)) { fails++; fprintf(stderr, "FAIL: %s (line %d)\n", msg, __LINE__); } else fprintf(stderr, "ok: %s\n", msg); } while (0)
+int dm_opmode(void) { return 1; }   // docked: player 1 is npad No1 (id 0), player n is id n - 1
+uint64_t guest_ns(void) { return 1000000000ull; }
+uint64_t now_ns(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec; }
+uint64_t dm_guest_frame(void) { return 0; }
+void dm_touch_set(const dm_touch *t, int n) { (void)t; (void)n; }
+int touch_fill_n(void *out, int max, uint64_t now) { (void)out; (void)max; (void)now; return 0; }
+int gesture_fill(void *out, int n, uint64_t now) { (void)out; (void)n; (void)now; return 0; }
+void dm_gfx_shot_at(long frame, const char *path) { (void)frame; (void)path; }
+void hle_bind_system_event(void *g, int autoclear) { (void)g; (void)autoclear; }
+void hle_signal_system_event(void *g) { (void)g; }
+int hle_signal_bound_system_event(void *g) { (void)g; return 1; }
+void dm_gfx_texlist(int target) { (void)target; }
+void dm_gfx_texraw(uint64_t serial, const char *path) { (void)serial; (void)path; }
+void dm_ctl_peek(uint64_t a, int n) { (void)a; (void)n; }
+void dm_ctl_memdump(uint64_t a, uint64_t n, const char *path) { (void)a; (void)n; (void)path; }
+void dm_ctl_cvar_i32(uint64_t off, int32_t v) { (void)off; (void)v; }
+void dm_ctl_cvar_f32(uint64_t off, float v) { (void)off; (void)v; }
+void dm_gfx_texdump_next(const char *path) { (void)path; }
+void dm_gfx_passdump_next(long n) { (void)n; }
+void dm_ctl_scan(const char *args) { (void)args; }
+void rm_race_start(void) {}   // remote_race.c has its own test (t_remote_race.c): here a race on Water Park, each player placed by number, lap 2, 5 coins, Yoshi
+void rm_race_read(int p, rp_race *r) {
+    snprintf(r->course, sizeof r->course, "Gu_WaterPark"); r->has = 1; r->place = p + 1; r->lap = 2; r->coins = 5; r->kart = 1; r->drv = 4; r->body = 14; r->tire = 20;
+}
+
+static pad_slots g_slots; static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER; static _Atomic int g_changes;
+static void changed(void) { g_changes++; }
+static void make_icon(const char *path) {   // a 300 x 300 PNG: the host makes the game card's thumbnail from it (DM_REMOTE_ICON)
+    CGColorSpaceRef cs = CGColorSpaceCreateDeviceRGB();
+    CGContextRef c = CGBitmapContextCreate(NULL, 300, 300, 8, 0, cs, kCGImageAlphaPremultipliedLast);
+    CGContextSetRGBFillColor(c, 0.9, 0.2, 0.1, 1); CGContextFillRect(c, CGRectMake(0, 0, 300, 300));
+    CGImageRef img = CGBitmapContextCreateImage(c);
+    CFURLRef url = CFURLCreateFromFileSystemRepresentation(NULL, (const UInt8 *)path, (CFIndex)strlen(path), false);
+    CGImageDestinationRef d = CGImageDestinationCreateWithURL(url, CFSTR("public.png"), 1, NULL);
+    CGImageDestinationAddImage(d, img, NULL); CGImageDestinationFinalize(d);
+    CFRelease(d); CFRelease(url); CGImageRelease(img); CGContextRelease(c); CGColorSpaceRelease(cs);
+}
+static char g_typed[160]; static _Atomic int g_typed_ok = -1;
+static void typed(const char *t, int ok) { snprintf(g_typed, sizeof g_typed, "%s", t); g_typed_ok = ok; }
+static struct sockaddr_in g_host;
+typedef struct { int fd; char sid[17]; int player; uint32_t seq; char roster[512]; } phone;   // roster: the last one that came
+static void msleep(int ms) { struct timespec t = {ms / 1000, (long)(ms % 1000) * 1000000L}; nanosleep(&t, NULL); }
+static void tx(phone *p, const char *fmt, ...) {
+    char m[600]; va_list ap; va_start(ap, fmt); vsnprintf(m, sizeof m, fmt, ap); va_end(ap);
+    sendto(p->fd, m, strlen(m), 0, (struct sockaddr *)&g_host, sizeof g_host);
+}
+static int rx(phone *p, const char *type, char *out, size_t cap, int ms) {   // the next message of that type within ms (others skipped)
+    char want[32]; snprintf(want, sizeof want, "\"t\":\"%s\"", type);
+    uint64_t end = now_ns() + (uint64_t)ms * 1000000ull;
+    while (now_ns() < end) {
+        struct pollfd pf = {p->fd, POLLIN, 0};
+        if (poll(&pf, 1, 10) <= 0) continue;
+        ssize_t n = recv(p->fd, out, cap - 1, 0); if (n <= 0) continue;
+        out[n] = 0;
+        if (strstr(out, "\"t\":\"roster\"")) snprintf(p->roster, sizeof p->roster, "%s", out);
+        if (strstr(out, want)) return 1;
+    }
+    return 0;
+}
+static phone open_phone(void) {
+    phone p = {socket(AF_INET, SOCK_DGRAM, 0), "", 0, 0, ""};
+    struct sockaddr_in a = {.sin_len = sizeof a, .sin_family = AF_INET, .sin_addr.s_addr = htonl(INADDR_LOOPBACK)}; bind(p.fd, (struct sockaddr *)&a, sizeof a);
+    return p;
+}
+static int join(phone *p, const char *code, const char *id, const char *name, char *out, size_t cap) {
+    tx(p, "{\"v\":1,\"t\":\"hello\",\"code\":\"%s\",\"id\":\"%s\",\"name\":\"%s\"}", code, id, name);
+    uint64_t end = now_ns() + 1000000000ull;
+    while (now_ns() < end) {
+        struct pollfd pf = {p->fd, POLLIN, 0};
+        if (poll(&pf, 1, 10) <= 0) continue;
+        ssize_t n = recv(p->fd, out, cap - 1, 0); if (n <= 0) continue;
+        out[n] = 0;
+        if (strstr(out, "\"t\":\"reject\"")) return 0;
+        const char *s = strstr(out, "\"sid\":\""), *pl = strstr(out, "\"player\":");
+        if (strstr(out, "\"t\":\"welcome\"") && s && pl) { memcpy(p->sid, s + 7, 16); p->sid[16] = 0; p->player = atoi(pl + 9); p->seq = 0; return 1; }
+    }
+    return 0;
+}
+static void st(phone *p, unsigned b, double lx, double ly) { tx(p, "{\"v\":1,\"t\":\"state\",\"sid\":\"%s\",\"seq\":%u,\"b\":%u,\"lx\":%.3f,\"ly\":%.3f,\"ms\":%u}", p->sid, ++p->seq, b, lx, ly, p->seq); }
+static NpadState npad(int player) { NpadState s; fill(&s, dm_player_npad(player - 1), STYLE_FULLKEY); return s; }
+static int wait_npad(int player, uint64_t buttons, int ms) {   // the game reads these buttons on that player's npad within ms
+    for (int i = 0; i < ms; i += 5) { NpadState s = npad(player); if (s.attributes && (s.buttons & 0xffff) == buttons) return 1; msleep(5); }
+    return 0;
+}
+
+int main(void) {
+    char m[600];
+    setenv("DM_REMOTE", "1", 1); setenv("DM_REMOTE_PORT", "0", 1); setenv("DM_REMOTE_BIND", "127.0.0.1", 1); setenv("DM_REMOTE_CODE", "482913", 1);
+    setenv("DM_REMOTE_PLAYERS", "4", 1); setenv("DM_REMOTE_TIMEOUT_MS", "600", 1);
+    char icon[64]; snprintf(icon, sizeof icon, "/tmp/t_remote_udp_%d.png", (int)getpid()); make_icon(icon); setenv("DM_REMOTE_ICON", icon, 1);
+    uint32_t mk8[] = {0, 1, 2, 3, NPAD_HANDHELD}; h_hid_SetIds(mk8, 5);   // as Mario Kart 8 Deluxe in a four-player race (0x10f)
+    static const char kbd = 0; pad_slot_take(&g_slots, &kbd, "keyboard");   // DM_KBD_PLAYER=own
+    CHECK(dm_remote_start(&g_slots, &g_mu, NULL, changed) && dm_remote_port(), "the receiver listens");
+    g_host = (struct sockaddr_in){.sin_len = sizeof g_host, .sin_family = AF_INET, .sin_port = htons(dm_remote_port()), .sin_addr.s_addr = htonl(INADDR_LOOPBACK)};
+    char info[160]; CHECK(dm_remote_info(info, sizeof info) && strstr(info, "127.0.0.1:") && strstr(info, "code 482913"), info);
+
+    phone a = open_phone(), b = open_phone(), c = open_phone(), d = open_phone(), e = open_phone();
+    CHECK(!join(&e, "999999", "phone-eve-99", "Eve", m, sizeof m) && strstr(m, "\"reason\":\"code\""), "a wrong code is refused");
+    CHECK(join(&a, "482913", "phone-ana-01", "Ana", m, sizeof m) && a.player == 2, "phone 1 is player 2 (the keyboard is player 1)");
+    CHECK(join(&b, "482913", "phone-luis-2", "Luis", m, sizeof m) && b.player == 3, "phone 2 is player 3");
+    CHECK(join(&c, "482913", "phone-sol-03", "Sol", m, sizeof m) && c.player == 4, "phone 3 is player 4");
+    CHECK(!join(&d, "482913", "phone-max-04", "Max", m, sizeof m) && strstr(m, "\"reason\":\"full\""), "a fourth phone: the four players are taken");
+    CHECK(atomic_load(&g_players) == 0xf, "hid has players 1..4 connected");
+    char pl[256]; dm_remote_players(pl, sizeof pl); CHECK(!strcmp(pl, "Ana (2), Luis (3), Sol (4)"), pl);
+
+    st(&a, DM_BTN_A, 1, 0); CHECK(rx(&a, "ack", m, sizeof m, 500) && strstr(m, "\"player\":2"), "the first state is acked with the player");
+    CHECK(rx(&a, "info", m, sizeof m, 500) && strstr(m, "\"game\":\"" DM_GAME_NAME "\"") && strstr(m, "\"use\":\"own\"") && strstr(m, "\"seats\":4") && strstr(m, "\"taken\":15,"),
+          "info: the game reads the phone's npad as its own player, four seats, players 1..4 held");
+    CHECK(rx(&a, "race", m, sizeof m, 100) && strstr(m, "\"crs\":\"Gu_WaterPark\",\"pos\":2,\"lap\":2,\"coin\":5,\"drv\":4,\"body\":14,\"tire\":20,\"wing\":0}"),
+          "race: player 2's course, place, lap, coins, character and kart");
+    uint32_t one[] = {0, NPAD_HANDHELD}; h_hid_SetIds(one, 2); st(&a, DM_BTN_A, 1, 0);
+    CHECK(rx(&a, "info", m, sizeof m, 500) && strstr(m, "\"use\":\"p1\"") && strstr(m, "\"seats\":1"), "a one-player screen: the phone is told it feeds player 1");
+    h_hid_SetIds(mk8, 5); st(&a, DM_BTN_A, 1, 0); CHECK(rx(&a, "info", m, sizeof m, 500) && strstr(m, "\"use\":\"own\""), "back to four players");
+    const char *isz = strstr(m, "\"isz\":"); CHECK(isz && atoi(isz + 6) > 0 && atoi(isz + 6) <= 65536, "the icon's thumbnail is in info");
+    NpadState rd[16]; uint32_t no2 = 1;
+    for (int i = 0; i < 30 && !strstr(m, "\"rd\":1"); i++) { h_hid_StatesFullKey(rd, 16, &no2); st(&a, DM_BTN_A, 1, 0); rx(&a, "info", m, sizeof m, 20); }
+    CHECK(strstr(m, "\"rd\":1") != NULL, "the game reads player 2's npad: the phone is told");
+    CHECK(strstr(a.roster, "\"n1\":\"keyboard\"") && strstr(a.roster, "\"n2\":\"Ana\"") && strstr(a.roster, "\"n3\":\"Luis\"") && strstr(a.roster, "\"n4\":\"Sol\""),
+          a.roster[0] ? a.roster : "no roster came");
+    tx(&a, "{\"v\":1,\"t\":\"icon\",\"sid\":\"%s\",\"off\":0}", a.sid); CHECK(rx(&a, "iconpart", m, sizeof m, 500) && strstr(m, "\"off\":0,"), "a piece of the icon");
+    dm_remote_text_begin("Nombre", "Ana", 10, typed); st(&a, DM_BTN_A, 1, 0);
+    CHECK(rx(&a, "kbd", m, sizeof m, 500) && strstr(m, "\"title\":\"Nombre\"") && strstr(m, "\"init\":\"Ana\""), "the game's keyboard reaches the phone");
+    const char *ks = strstr(m, "\"ks\":"); tx(&a, "{\"v\":1,\"t\":\"text\",\"sid\":\"%s\",\"ks\":%d,\"text\":\"Joel\",\"ok\":1}", a.sid, ks ? atoi(ks + 5) : 0);
+    for (int i = 0; i < 50 && g_typed_ok < 0; i++) msleep(10);
+    CHECK(g_typed_ok == 1 && !strcmp(g_typed, "Joel"), "and its answer reaches the game's input box"); dm_remote_text_end();
+    CHECK(wait_npad(2, DM_BTN_A, 500) && npad(2).lx == DM_STICK_MAX, "player 2's npad (No2) reads A and the stick full right");
+    st(&b, DM_BTN_B, 0, -1);
+    CHECK(wait_npad(3, DM_BTN_B, 500) && npad(3).ly == -DM_STICK_MAX && (npad(2).buttons & 0xffff) == DM_BTN_A, "player 3 reads B, player 2 still A");
+    CHECK((npad(1).buttons & 0xffff) == 0, "player 1 (the keyboard) reads nothing from the phones");
+    a.seq = 10; st(&a, DM_BTN_X, 0, 0);
+    tx(&a, "{\"v\":1,\"t\":\"state\",\"sid\":\"%s\",\"seq\":5,\"b\":%u,\"lx\":0,\"ly\":0}", a.sid, DM_BTN_Y);
+    msleep(60); CHECK((npad(2).buttons & 0xffff) == DM_BTN_X, "an older seq arriving late is dropped");
+    tx(&d, "{\"v\":1,\"t\":\"state\",\"sid\":\"%s\",\"seq\":99,\"b\":1}", a.sid);
+    msleep(60); CHECK((npad(2).buttons & 0xffff) == DM_BTN_X, "another address cannot use a session id");
+    tx(&d, "{\"v\":1,\"t\":\"state\",\"sid\":\"00000000000000ff\",\"seq\":1,\"b\":1}"); CHECK(rx(&d, "kick", m, sizeof m, 500), "an unknown session is told to join again");
+
+    // keep phones 2 and 3 alive at 60 Hz while phone 1 goes quiet
+    uint64_t t0 = now_ns(); int released = 0, freed = 0;
+    while (now_ns() - t0 < 1500000000ull && !freed) {
+        st(&b, DM_BTN_B, 0, -1); st(&c, 0, 0, 0); msleep(16);
+        NpadState s = npad(2);
+        if (!released && s.attributes && !(s.buttons & 0xffff)) { released = 1; fprintf(stderr, "ok: phone 1 released after %llu ms\n", (unsigned long long)((now_ns() - t0) / 1000000)); }
+        if (!s.attributes) { freed = 1; fprintf(stderr, "ok: phone 1 lost its player after %llu ms\n", (unsigned long long)((now_ns() - t0) / 1000000)); }
+    }
+    CHECK(released && freed, "a silent phone is released (300 ms), then loses its player (600 ms)");
+    CHECK(rx(&a, "kick", m, sizeof m, 300) && strstr(m, "timeout"), "and is told");
+    CHECK((npad(3).buttons & 0xffff) == DM_BTN_B, "the phones that kept sending keep playing");
+    CHECK(join(&a, "482913", "phone-ana-01", "Ana", m, sizeof m) && a.player == 2, "the rejoin gets player 2 back");
+    st(&a, DM_BTN_ZR, 0, 0); CHECK(wait_npad(2, DM_BTN_ZR, 500), "and plays");
+    st(&b, DM_BTN_B, 0, -1);   // phone 2 is still sending
+    tx(&c, "{\"v\":1,\"t\":\"bye\",\"sid\":\"%s\"}", c.sid); CHECK(rx(&c, "bye", m, sizeof m, 500), "bye is answered");
+    msleep(30); CHECK(!npad(4).attributes && atomic_load(&g_players) == 0x7, "and player 4 is free");
+    CHECK(join(&d, "482913", "phone-max-04", "Max", m, sizeof m) && d.player == 4, "the waiting phone takes player 4 now");
+    dm_remote_stop();
+    CHECK(rx(&a, "bye", m, sizeof m, 500) && strstr(m, "\"reason\":\"host\"") && rx(&d, "bye", m, sizeof m, 500), "the host's quit reaches the phones");
+    CHECK(atomic_load(&g_players) == 0x1 && g_changes >= 6, "every phone's player is free");
+    unlink(icon);
+    printf("t_remote_udp: %d checks, %d failed\n", checks, fails);
+    return fails != 0;
+}
